---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import PageIntro from "@/components/refresh/PageIntro.astro";
import ModuleExplorer from "@/components/refresh/ModuleExplorer.astro";
import BuildUps from "@/components/refresh/BuildUps.astro";
import SplitSection from "@/components/refresh/SplitSection.astro";
import ImagePanel from "@/components/refresh/ImagePanel.astro";
import Accordion from "@/components/refresh/Accordion.astro";
import FaqSection from "@/components/refresh/FaqSection.astro";
import GetStarted from "@/components/refresh/GetStarted.astro";
import { buildUps, certification, factoryToSite, moduleSystems, qualityChecks, site } from "@/data/site";

const title = "Manufacturing & Quality | Modular Construction | Cloud Modular";
const description =
  "How Cloud Modular builds every module in its Foshan manufacturing facility, checks it against Australian requirements and delivers it to site in Western Australia.";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    { "@type": "ListItem", position: 2, name: "Manufacturing and quality", item: `${site.url}/quality/` },
  ],
};
---

<RefreshLayout title={title} description={description} canonical="/quality/" structuredData={breadcrumbSchema}>
  <PageIntro label="Manufacturing and quality" title="How every module is made and checked" lead="We build every module in our manufacturing facility in Foshan, check it against Australian requirements at each stage and manage its journey to your site." />

  <!-- Full-width factory image under the intro (a stand-in; real factory photos are not published) -->
  <div class="wide-row" data-reveal>
    <div class="aspect-[4/3] overflow-hidden rounded bg-stone sm:aspect-[21/9]">
      <img src="/Factory-1.webp" alt="The production floor of a modular manufacturing facility" width="1672" height="941" fetchpriority="high" class="h-full w-full object-cover" />
    </div>
  </div>

  <!-- The module: the eight systems, with the 3D model to come in the stage -->
  <ModuleExplorer body={moduleSystems.body} rule={false} />

  <SplitSection id="checks" label="Quality checks">
    <p class="text-about">{qualityChecks.intro}</p>
    <Accordion items={qualityChecks.items} name="checks" class="mt-10" />
  </SplitSection>

  <!-- Floor, walls and ceiling: three build-up stages, each to become its own 3D render -->
  <BuildUps id="build-ups" label="Floor, walls and ceiling" body={buildUps.body} items={buildUps.items} />

  <SplitSection id="certification" label="Australian certification">
    <p class="text-about">{certification.intro}</p>
    <Accordion items={certification.items} name="certification" class="mt-10" />
  </SplitSection>

  <!-- Factory to site (olympic.no investor panel): the wrapped module left, the logistics accordion right -->
  <ImagePanel id="factory-to-site" label="Factory to site" title="Sealed for the journey" image="/approach/hero.webp" alt="A module sealed in white shrink wrap carrying the Cloud Modular mark, on a trailer against a clear sky" width={1672} height={941} imagePosition="54% center">
    <p class="text-body text-fg-muted">{factoryToSite.intro}</p>
    <Accordion items={factoryToSite.items} name="logistics" openFirst class="mt-10" />
  </ImagePanel>

  <FaqSection id="faq" topic="quality" rule={false} />

  <GetStarted />
</RefreshLayout>
