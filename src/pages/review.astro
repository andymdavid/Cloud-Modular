---
/**
 * The fact review (/review/): the team works through the customer-facing facts on the site one website page at a
 * time. Each page's facts are bundled into a few cards, answered as a whole, with the live page alongside: "Show on
 * the page" scrolls it to the fact and highlights it. Answers are saved to Cloudflare KV by /api/review, so everyone
 * sees the same thread and Claude can pull them to make the changes.
 *
 * Only built on Cloudflare Pages (CF_PAGES), or locally with REVIEW_PAGE=1, so it never reaches the public GitHub
 * Pages site; on Cloudflare, functions/review/_middleware.ts keeps it behind REVIEW_KEY. The facts and cards are in
 * src/data/review.ts.
 */
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import { pageNames, reviewItems, reviewPages, reviewUpdated, type ReviewItem, type ReviewPage } from "@/data/review";

const enabled = Boolean(process.env.CF_PAGES || process.env.REVIEW_PAGE);
if (!enabled) return Astro.redirect("/");

const escape = (text: string) => text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const rich = (text: string) => escape(text).replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
const cardCount = reviewPages.reduce((sum, page) => sum + page.cards.length, 0);
// The fact's place on this page if it has one, otherwise wherever it appears
const targetFor = (item: ReviewItem, page: ReviewPage) => item.at.find((target) => target.path === page.path) ?? item.at[0];
const answers = [
  { value: "confirmed", label: "All correct" },
  { value: "change", label: "Needs changes" },
  { value: "question", label: "I have a question" },
];
---

<RefreshLayout title="Fact Review | Cloud Modular" description="The team's review of the facts on the Cloud Modular website." canonical="/review/" noindex footer={false}>
  <section data-theme="light" class="pt-[calc(var(--header-h)+var(--section-sm))]">
    <div class="shell">
      <div class="grid-12 gap-y-6">
        <div class="col-span-12 md:col-span-6">
          <p class="label">Fact review · {reviewUpdated}</p>
          <h1 class="mt-6 text-feature">Check the facts</h1>
        </div>
        <div class="col-span-12 max-w-measure space-y-4 text-body text-fg-muted md:col-span-6 md:col-start-7 md:self-end">
          <p>Before launch, the team needs to check the facts a customer might rely on. They're grouped by website page, in {cardCount} short cards.</p>
          <p>Open a page to see its cards with the page itself alongside. For each card, say whether it's all correct, what needs to change, or what you'd like to ask. Everyone sees the same answers.</p>
          <p class="text-small" data-as-known>
            Answering as <span class="text-fg" data-as-name></span>
            <button type="button" class="text-link ml-2" data-as-change>Change</button>
          </p>
        </div>
      </div>
      <p class="review-banner" hidden data-banner></p>
    </div>
  </section>

  <!-- Overview: one card per website page -->
  <div class="shell pb-section" data-view="overview">
    <div class="mt-section-sm flex flex-wrap items-baseline justify-between gap-4 border-t border-line/[var(--rule-alpha)] pt-6">
      <h2 class="text-h3">Pages to review</h2>
      <p class="label label-muted" data-progress-all></p>
    </div>
    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {reviewPages.map((page) => (
        <a href={`#${page.id}`} class="review-tile" data-tile={page.id}>
          <span class="text-lead">{page.title}</span>
          <span class="text-small text-fg-muted">{page.cards.length === 1 ? "1 card" : `${page.cards.length} cards`}</span>
          <span class="review-meter" aria-hidden="true"><span data-tile-bar></span></span>
          <span class="text-small text-fg-muted" data-tile-progress></span>
        </a>
      ))}
    </div>
  </div>

  <!-- One view per website page: its cards, with the live page alongside -->
  {reviewPages.map((page, index) => {
    const next = reviewPages[index + 1];
    return (
      <div class="shell pb-section" hidden data-view={page.id} data-path={page.path}>
        <div class="mt-section-sm flex flex-wrap items-end justify-between gap-4 border-t border-line/[var(--rule-alpha)] pt-6">
          <div>
            <a href="#" class="review-back">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" /></svg>
              All pages
            </a>
            <h2 class="mt-5 text-h3">{page.title}</h2>
          </div>
          <p class="label label-muted" data-progress-page></p>
        </div>

        <div class="review-split mt-8">
          <div class="grid content-start gap-4">
            {page.cards.map((card) => (
              <article class="review-card" data-card={card.id} data-state="open">
                <header class="flex flex-wrap items-center justify-between gap-3">
                  <h3 class="text-lead">{card.title}</h3>
                  <span class="pill" data-state-label>To review</span>
                </header>
                {card.note && <p class="mt-3 text-small text-fg-muted" set:html={rich(card.note)} />}

                <ol class="review-facts">
                  {card.items.map((id, number) => {
                    const item = reviewItems.get(id)!;
                    const target = targetFor(item, page);
                    return (
                      <li class="review-fact" data-fact>
                        <span class="review-fact-number">{number + 1}</span>
                        <div>
                          <p class="text-body" set:html={rich(item.says)} />
                          <p class="mt-2 text-small text-fg-muted" set:html={rich(item.question)} />
                          {target && (
                            <button type="button" class="text-link mt-2 text-small" data-show data-path={target.path} data-find={target.find ?? ""}>
                              Show on the page{target.path !== page.path && ` (${pageNames[target.path] ?? target.path})`}
                            </button>
                          )}
                        </div>
                      </li>
                    );
                  })}
                </ol>

                <ol class="review-thread" data-thread></ol>

                <form class="review-answer" data-answer>
                  <p class="mb-4 text-small text-fg-muted" data-as-known>
                    Answering as <span class="text-fg" data-as-name></span>
                    <button type="button" class="text-link ml-2" data-as-change>Change</button>
                  </p>
                  <fieldset class="flex flex-wrap gap-1">
                    <legend class="sr-only">Your answer for {card.title}</legend>
                    {answers.map((answer) => (
                      <label class="chip">
                        <input type="radio" name="status" value={answer.value} class="sr-only" />
                        {answer.label}
                      </label>
                    ))}
                  </fieldset>
                  <label class="field mt-4">
                    <span class="field-label">What should change, or your question <span class="field-optional">Refer to a point by its number</span></span>
                    <textarea name="comment" rows="2" maxlength="4000"></textarea>
                  </label>
                  <div class="mt-4 flex flex-wrap items-center gap-4">
                    <button type="submit" class="btn-solid h-9 px-4">Save</button>
                    <p class="text-small text-fg-muted" role="status" data-message></p>
                    <span class="ml-auto flex gap-4">
                      <button type="button" class="text-link text-caption text-fg-subtle" data-done>Mark as fixed on the site</button>
                      <button type="button" class="text-link text-caption text-fg-subtle" hidden data-reopen>Reopen</button>
                    </span>
                  </div>
                </form>
              </article>
            ))}

            <a href={next ? `#${next.id}` : "#"} class="review-next">
              <span class="label label-muted">{next ? "Next page" : "Finished"}</span>
              <span class="text-lead">{next ? next.title : "Back to all pages"}</span>
            </a>
          </div>

          <aside class="review-frame" data-frame-box>
            <div class="flex items-center justify-between gap-4 pb-2">
              <p class="text-caption text-fg-muted" data-frame-status>{page.path}</p>
              <a class="text-link text-caption" target="_blank" rel="noopener" href={page.path} data-frame-open>Open in a new tab</a>
            </div>
          </aside>
        </div>
      </div>
    );
  })}

  <!-- Asked once, on first visit, so every answer can be saved -->
  <dialog class="review-dialog" aria-labelledby="review-dialog-title" data-name-dialog>
    <form data-name-form>
      <p class="label">Fact review</p>
      <h2 id="review-dialog-title" class="mt-4 text-h3">What's your name?</h2>
      <p class="mt-3 text-body text-fg-muted">It goes next to your answers so the team knows who said what. You only need to add it once.</p>
      <label class="field mt-6">
        <span class="field-label">Your name</span>
        <input type="text" maxlength="80" autocomplete="name" required data-name />
      </label>
      <button type="submit" class="btn-solid mt-6 h-10 px-5">Start reviewing</button>
    </form>
  </dialog>
</RefreshLayout>

<style>
  .review-banner {
    margin-top: 1.5rem;
    font-size: var(--text-small);
    color: rgb(var(--gold-deep));
  }

  .review-tile {
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem;
    border-radius: var(--radius-media);
    background: rgb(var(--mist));
    transition: background var(--dur-base) var(--ease-standard);
  }

  .review-tile:hover {
    background: rgb(var(--stone));
  }

  .review-tile[data-complete] {
    background: rgb(var(--sage) / 0.45);
  }

  .review-meter {
    display: block;
    height: 3px;
    margin-top: 0.5rem;
    background: rgb(var(--line) / 0.12);
  }

  .review-meter span {
    display: block;
    width: 0;
    height: 100%;
    background: rgb(var(--forest));
    transition: width var(--dur-base) var(--ease-standard);
  }

  /* Cards on the left, the live page alongside on wide screens. Narrow screens open the page in a new tab. */
  .review-split {
    display: grid;
    gap: 2rem;
  }

  .review-frame {
    display: none;
  }

  @media (min-width: 1024px) {
    .review-split {
      grid-template-columns: minmax(24rem, 34rem) minmax(0, 1fr);
      align-items: start;
    }

    .review-frame {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 1rem);
    }

    .review-frame :global(iframe) {
      display: block;
      width: 100%;
      height: calc(100vh - var(--header-h) - 4rem);
      border: var(--rule) solid rgb(var(--line) / 0.2);
      border-radius: var(--radius-media);
      background: rgb(var(--paper));
    }
  }

  .review-card {
    padding: 1.25rem;
    border-radius: var(--radius-media);
    background: rgb(var(--mist));
  }

  .review-card[data-state="done"] {
    opacity: 0.6;
  }

  .review-card[data-state="done"] :is(.review-answer fieldset, .review-answer .field, .review-answer [type="submit"]) {
    display: none;
  }

  .review-facts {
    margin-top: 1rem;
  }

  .review-fact {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.5rem;
    padding-block: 1rem;
    border-top: var(--rule) solid rgb(var(--line) / var(--rule-alpha));
  }

  .review-fact[data-active] {
    box-shadow: inset 3px 0 0 rgb(var(--label-gold));
    margin-left: -1.25rem;
    padding-left: calc(1.25rem - 3px);
    grid-template-columns: calc(1.75rem + 3px) minmax(0, 1fr);
  }

  .review-fact-number {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: rgb(var(--fg-subtle));
  }

  .review-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0.25rem 1rem 0.25rem 0.75rem;
    border: var(--rule) solid rgb(var(--line) / 0.35);
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    transition: background var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard);
  }

  .review-back:hover {
    border-color: rgb(var(--ink));
    background: rgb(var(--ink));
    color: rgb(var(--paper));
  }

  .review-back svg {
    transition: transform var(--dur-base) var(--ease-standard);
  }

  .review-back:hover svg {
    transform: translateX(-2px);
  }

  .review-next {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 1.25rem;
    border: var(--rule) solid rgb(var(--line) / 0.25);
    border-radius: var(--radius-media);
  }

  .review-next:hover {
    border-color: rgb(var(--ink));
  }

  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.25rem 0.75rem;
    border: var(--rule) solid rgb(var(--line) / 0.25);
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    cursor: pointer;
    transition: background var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard);
  }

  .chip:hover,
  .chip:has(input:checked) {
    border-color: rgb(var(--ink));
    background: rgb(var(--ink));
    color: rgb(var(--paper));
  }

  .chip:has(input:focus-visible) {
    outline: 2px solid rgb(var(--label-gold));
    outline-offset: 2px;
  }

  .pill {
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    background: rgb(var(--stone));
    color: rgb(var(--fg-muted));
  }

  .review-card:is([data-state="confirmed"], [data-state="done"]) .pill {
    background: rgb(var(--sage));
    color: rgb(var(--forest));
  }

  .review-card:is([data-state="change"], [data-state="remove"], [data-state="question"]) .pill {
    background: rgb(var(--ink));
    color: rgb(var(--paper));
  }

  .review-thread {
    margin-top: 0.5rem;
  }

  .review-thread:empty {
    display: none;
  }

  .review-thread :global(li) {
    padding-block: 0.75rem;
    border-top: var(--rule) solid rgb(var(--line) / var(--rule-alpha));
    font-size: var(--text-small);
  }

  .review-answer {
    margin-top: 0.5rem;
    padding-top: 1.25rem;
    border-top: var(--rule) solid rgb(var(--line) / var(--rule-alpha));
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: rgb(var(--fg-muted));
  }

  .review-dialog {
    width: min(28rem, 100% - 32px);
    margin: auto;
    padding: 2rem;
    border: 0;
    border-radius: var(--radius-media);
    background: rgb(var(--paper));
    color: rgb(var(--fg));
  }

  .review-dialog::backdrop {
    background: rgb(var(--ink) / 0.55);
  }

  .field-optional {
    margin-left: 0.5rem;
    color: rgb(var(--fg-subtle));
    font-weight: var(--weight-regular);
    text-transform: none;
    letter-spacing: normal;
  }

  .field :is(input, textarea) {
    width: 100%;
    padding-block: 0.5rem;
    border: 0;
    border-bottom: var(--rule) solid rgb(var(--line) / 0.35);
    border-radius: 0;
    background: transparent;
    color: rgb(var(--fg));
    font: inherit;
    font-size: 1rem;
  }

  .field :is(input, textarea):focus {
    outline: none;
    border-bottom-color: rgb(var(--label-gold));
  }
</style>

<script>
  type Entry = { at: string; name: string; status?: string; action?: string; comment?: string };

  const API = "/api/review";
  const LABELS: Record<string, string> = { confirmed: "All correct", change: "Needs changes", remove: "Remove", question: "Question", open: "To review", done: "Fixed" };
  const cards = [...document.querySelectorAll<HTMLElement>("[data-card]")];
  const views = [...document.querySelectorAll<HTMLElement>("[data-view]")];
  const banner = document.querySelector<HTMLElement>("[data-banner]")!;
  const wide = window.matchMedia("(min-width: 1024px)");
  let store: Record<string, Entry[]> = {};

  // ---------------------------------------------------------------------------------------------------
  // The reviewer's name: asked in a dialog on first visit (it can't be closed empty), remembered in this browser,
  // and shown as "Answering as …" at the top and on every card, where Change opens the dialog again.

  const dialog = document.querySelector<HTMLDialogElement>("[data-name-dialog]")!;
  const nameInput = dialog.querySelector<HTMLInputElement>("[data-name]")!;
  let reviewer = "";

  function showName() {
    for (const el of document.querySelectorAll<HTMLElement>("[data-as-known]")) el.hidden = !reviewer;
    for (const el of document.querySelectorAll("[data-as-name]")) el.textContent = reviewer;
  }

  function askName() {
    nameInput.value = reviewer;
    if (!dialog.open) dialog.showModal();
    nameInput.focus();
  }

  dialog.querySelector("[data-name-form]")!.addEventListener("submit", (event) => {
    event.preventDefault();
    const name = nameInput.value.trim();
    if (!name) return;
    reviewer = name;
    try {
      localStorage.setItem("review-name", name);
    } catch {}
    showName();
    dialog.close();
  });
  dialog.addEventListener("cancel", (event) => {
    if (!reviewer) event.preventDefault();
  });
  for (const button of document.querySelectorAll("[data-as-change]")) button.addEventListener("click", askName);

  try {
    reviewer = localStorage.getItem("review-name")?.trim() ?? "";
  } catch {}
  showName();
  if (!reviewer) askName();

  const escape = (text: string) => text.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const when = (iso: string) => new Date(iso).toLocaleString("en-AU", { day: "numeric", month: "short", hour: "numeric", minute: "2-digit" });

  // ---------------------------------------------------------------------------------------------------
  // Answers and progress

  /** A card's state: fixed if its last done/reopen was done, otherwise its latest answer, otherwise open. */
  function stateOf(entries: Entry[]) {
    let done = false;
    let answer: string | undefined;
    for (const entry of entries) {
      if (entry.action === "done") done = true;
      if (entry.action === "reopen") done = false;
      if (entry.status) answer = entry.status;
    }
    return done ? "done" : (answer ?? "open");
  }

  function renderCard(card: HTMLElement) {
    const entries = store[card.dataset.card!] ?? [];
    const state = stateOf(entries);
    card.dataset.state = state;
    card.querySelector("[data-state-label]")!.textContent = LABELS[state];
    card.querySelector<HTMLElement>("[data-done]")!.hidden = state === "done";
    card.querySelector<HTMLElement>("[data-reopen]")!.hidden = state !== "done";
    card.querySelector("[data-thread]")!.innerHTML = entries
      .map((entry) => {
        const what = entry.action === "done" ? "Marked as fixed" : entry.action === "reopen" ? "Reopened" : entry.status ? LABELS[entry.status] : "Comment";
        return `<li><span class="text-fg">${escape(entry.name)}</span> <span class="text-fg-subtle">· ${when(entry.at)} · ${what}</span>${entry.comment ? `<p class="mt-1 whitespace-pre-line text-body">${escape(entry.comment)}</p>` : ""}</li>`;
      })
      .join("");
  }

  const answered = (list: HTMLElement[]) => list.filter((card) => card.dataset.state !== "open").length;

  function renderProgress() {
    for (const view of views) {
      if (view.dataset.view === "overview") continue;
      const own = [...view.querySelectorAll<HTMLElement>("[data-card]")];
      const count = answered(own);
      const text = `${count} of ${own.length} answered`;
      view.querySelector("[data-progress-page]")!.textContent = text;
      const tile = document.querySelector<HTMLElement>(`[data-tile="${view.dataset.view}"]`)!;
      tile.querySelector("[data-tile-progress]")!.textContent = count === own.length ? "All answered" : text;
      tile.querySelector<HTMLElement>("[data-tile-bar]")!.style.width = `${(count / own.length) * 100}%`;
      tile.toggleAttribute("data-complete", count === own.length);
    }
    const done = cards.filter((card) => card.dataset.state === "done").length;
    document.querySelector("[data-progress-all]")!.textContent = `${answered(cards)} of ${cards.length} cards answered${done ? ` · ${done} fixed` : ""}`;
  }

  function renderAll() {
    cards.forEach(renderCard);
    renderProgress();
  }

  async function send(card: HTMLElement, body: Record<string, string>) {
    const message = card.querySelector("[data-message]")!;
    const name = reviewer;
    if (!name) {
      message.textContent = "Add your name, then save again. Your answer is still here.";
      askName();
      return false;
    }
    message.textContent = "Saving…";
    try {
      const response = await fetch(API, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ item: card.dataset.card, name, ...body }) });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error);
      store[card.dataset.card!] = result.entries;
      message.textContent = "Saved.";
      renderCard(card);
      renderProgress();
      return true;
    } catch (error) {
      message.textContent = `Not saved. ${(error as Error).message || "Please try again."}`;
      return false;
    }
  }

  for (const card of cards) {
    const form = card.querySelector<HTMLFormElement>("[data-answer]")!;
    const comment = () => (form.elements.namedItem("comment") as HTMLTextAreaElement).value.trim();
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const status = (form.elements.namedItem("status") as RadioNodeList).value;
      if (!status && !comment()) {
        card.querySelector("[data-message]")!.textContent = "Choose an answer or add a comment.";
        return;
      }
      if (await send(card, { status, comment: comment() })) form.reset();
    });
    card.querySelector("[data-done]")!.addEventListener("click", () => send(card, { action: "done", comment: comment() }).then((ok) => ok && form.reset()));
    card.querySelector("[data-reopen]")!.addEventListener("click", () => send(card, { action: "reopen" }));
  }

  // ---------------------------------------------------------------------------------------------------
  // Pages: the overview, or one website page's cards (#<page id>)

  function route() {
    const id = location.hash.slice(1);
    const current = views.find((view) => view.dataset.view === id) ?? views[0];
    for (const view of views) view.hidden = view !== current;
    window.scrollTo({ top: 0, behavior: "instant" });
    if (current.dataset.path && wide.matches) frameFor(current);
  }

  window.addEventListener("hashchange", route);

  // ---------------------------------------------------------------------------------------------------
  // The live page alongside the cards. "Show on the page" loads the fact's page there if it isn't already, scrolls
  // that frame (never this page) to the fact and outlines it. Closed accordions on the way are opened and the reveal
  // animations are skipped. On narrow screens it opens the page in a new tab at the fact instead.

  function frameFor(view: HTMLElement, path = view.dataset.path!) {
    const box = view.querySelector<HTMLElement>("[data-frame-box]")!;
    let frame = box.querySelector("iframe");
    if (!frame) {
      frame = document.createElement("iframe");
      frame.title = "The page on the site";
      box.append(frame);
    }
    if (frame.dataset.path !== path) {
      const loading = frame;
      loading.dataset.path = path;
      loading.dataset.ready = "";
      loading.src = path;
      box.querySelector<HTMLAnchorElement>("[data-frame-open]")!.href = path;
      box.querySelector("[data-frame-status]")!.textContent = `Loading ${path}…`;
      loading.onload = () => {
        // Give the page a moment to run its own scripts first
        setTimeout(() => {
          loading.dataset.ready = "true";
          prepare(loading);
          box.querySelector("[data-frame-status]")!.textContent = path;
          loading.dispatchEvent(new Event("review-ready"));
        }, 500);
      };
    }
    return frame;
  }

  function prepare(frame: HTMLIFrameElement) {
    const doc = frame.contentDocument;
    if (!doc?.head) return;
    doc.querySelectorAll("[data-reveal]").forEach((el) => el.classList.add("is-visible"));
    if (doc.getElementById("review-style")) return;
    const style = doc.createElement("style");
    style.id = "review-style";
    style.textContent =
      "html{scroll-behavior:auto !important}.js [data-reveal]{opacity:1 !important;transform:none !important;transition:none !important}" +
      ".review-hit{outline:3px solid #C9A14A !important;outline-offset:6px;background:rgb(201 161 74 / 0.16) !important;border-radius:2px}";
    doc.head.append(style);
  }

  const normalise = (text: string) => text.replace(/\s+/g, " ").trim();

  /** Outlines the deepest visible element holding the phrase. Returns "found", "hidden" or "missing". */
  function highlight(frame: HTMLIFrameElement, find: string) {
    const doc = frame.contentDocument;
    if (!doc?.body) return "missing";
    prepare(frame);
    doc.querySelectorAll(".review-hit").forEach((el) => el.classList.remove("review-hit"));
    const target = normalise(find);
    if (!target) {
      frame.contentWindow!.scrollTo({ top: 0, behavior: "instant" });
      return "found";
    }
    const holds = (el: Element) => !el.matches("script, style") && normalise(el.textContent ?? "").includes(target);
    const matches = [...doc.body.querySelectorAll("*")].filter((el) => holds(el) && ![...el.children].some(holds));
    if (matches.length === 0) return "missing";
    for (const el of matches) for (let up: Element | null = el; up; up = up.parentElement) if (up.tagName === "DETAILS") (up as HTMLDetailsElement).open = true;
    const match = matches.find((el) => el.getClientRects().length > 0) ?? matches[0];
    match.classList.add("review-hit");
    if (match.getClientRects().length === 0) return "hidden";
    hold(frame, match);
    return "found";
  }

  /** Keeps the phrase in the middle of the frame while images load and the layout settles, until the reviewer scrolls. */
  function hold(frame: HTMLIFrameElement, match: Element) {
    const win = frame.contentWindow!;
    const doc = frame.contentDocument!;
    let stopped = false;
    const centre = () => {
      if (stopped || !frame.isConnected) return;
      // Panels that scroll on their own (the design tool's options) first, then the page
      for (let box = match.parentElement; box && box !== doc.body; box = box.parentElement) {
        if (box.scrollHeight <= box.clientHeight || !/auto|scroll/.test(win.getComputedStyle(box).overflowY)) continue;
        const rect = match.getBoundingClientRect();
        const area = box.getBoundingClientRect();
        box.scrollTo({ top: box.scrollTop + rect.top - area.top - (box.clientHeight - rect.height) / 2, behavior: "instant" });
      }
      const rect = match.getBoundingClientRect();
      win.scrollTo({ top: Math.max(0, win.scrollY + rect.top - (win.innerHeight - rect.height) / 2), behavior: "instant" });
    };
    const observer = new ResizeObserver(centre);
    const stop = () => {
      stopped = true;
      observer.disconnect();
    };
    for (const type of ["wheel", "touchstart", "keydown", "mousedown"]) doc.addEventListener(type, stop, { once: true, passive: true });
    observer.observe(doc.body);
    doc.querySelectorAll("img").forEach((img) => img.complete || img.addEventListener("load", centre, { once: true }));
    centre();
    setTimeout(stop, 4000);
  }

  document.querySelectorAll<HTMLButtonElement>("[data-show]").forEach((button) =>
    button.addEventListener("click", () => {
      const { path, find } = button.dataset as { path: string; find: string };
      if (!wide.matches) {
        window.open(find ? `${path}#:~:text=${encodeURIComponent(find)}` : path, "_blank", "noopener");
        return;
      }
      const view = button.closest<HTMLElement>("[data-view]")!;
      view.querySelectorAll("[data-fact]").forEach((fact) => fact.toggleAttribute("data-active", fact === button.closest("[data-fact]")));
      const status = view.querySelector("[data-frame-status]")!;
      const frame = frameFor(view, path);
      const run = () => {
        const result = highlight(frame, find);
        status.textContent =
          result === "found" ? path
          : result === "hidden" ? `${path} · This text only appears after an interaction, such as choosing an option or sending the form.`
          : `${path} · This text couldn't be found. It may have changed, or appear only in the 3D view.`;
      };
      if (frame.dataset.ready) run();
      else frame.addEventListener("review-ready", run, { once: true });
    }),
  );

  // ---------------------------------------------------------------------------------------------------
  // Load everyone's answers

  async function load() {
    try {
      const response = await fetch(API, { headers: { accept: "application/json" } });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error);
      store = result.items ?? {};
    } catch (error) {
      banner.hidden = false;
      banner.textContent = `Answers can't be loaded or saved right now. ${(error as Error).message || ""}`.trim();
      document.querySelectorAll<HTMLButtonElement>('[data-answer] button[type="submit"], [data-done]').forEach((b) => (b.disabled = true));
    }
    renderAll();
  }

  route();
  renderAll();
  load();
</script>
