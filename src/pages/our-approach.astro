---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import PageIntro from "@/components/refresh/PageIntro.astro";
import SplitSection from "@/components/refresh/SplitSection.astro";
import SectionHead from "@/components/refresh/SectionHead.astro";
import CardRow from "@/components/refresh/CardRow.astro";
import MediaCard from "@/components/refresh/MediaCard.astro";
import ProgrammeLine from "@/components/refresh/ProgrammeLine.astro";
import RoleMatrix from "@/components/refresh/RoleMatrix.astro";
import ToConfirm from "@/components/refresh/ToConfirm.astro";
import FaqSection from "@/components/refresh/FaqSection.astro";
import GetStarted from "@/components/refresh/GetStarted.astro";
import { approachProgramme, approachStages, engagementModels, responsibilities, site } from "@/data/site";

const title = "Our Approach | Modular Construction Process | Cloud Modular";
const description =
  "How a Cloud Modular project runs, from brief to handover: the stages, the programme, who does what and the ways to engage us.";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    { "@type": "ListItem", position: 2, name: "Our Approach", item: `${site.url}/our-approach/` },
  ],
};
---

<RefreshLayout title={title} description={description} canonical="/our-approach/" structuredData={breadcrumbSchema}>
  <PageIntro label="Our approach" title="From brief to handover" lead="One accountable team across Perth and Foshan, from the first site review to the keys." />

  <!-- Full-width image under the intro -->
  <div class="wide-row pb-section" data-reveal>
    <div class="aspect-[4/3] overflow-hidden rounded bg-stone sm:aspect-[21/9]">
      <img src="/1.webp" alt="A street of contemporary modular homes in timber and dark cladding at sunset" width="2688" height="1792" fetchpriority="high" class="h-full w-full object-cover" style="object-position:center 62%" />
    </div>
  </div>

  <SplitSection id="how-we-work" label="How we work">
    <p class="text-about">We manage the whole delivery chain: design for manufacture, production in Foshan, shipping and clearance, then installation on site. Modules are built while the site is prepared, so the programme is shorter and the risk sits with one team. It’s a process built for delivery at scale, including cyclone regions and regional and remote sites.</p>
    <a href="#process" class="btn mt-10">See the process</a>
  </SplitSection>

  <!-- The process: one image card per stage, in the Sectors carousel -->
  <section id="process" data-theme="light" class="scroll-mt-header pb-section" data-carousel>
    <div class="shell">
      <SectionHead label="The process" title="Eight stages, one team" intro="Each stage ends with a decision from you, so nothing goes into production until the design and approvals are settled." confirm={approachStages.confirm}>
        <Fragment slot="actions">
          <button type="button" class="icon-btn" data-carousel-prev aria-label="Previous stages" disabled>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M8.5 2.5 4 7l4.5 4.5" stroke="currentColor" stroke-width="1.2" /></svg>
          </button>
          <button type="button" class="icon-btn" data-carousel-next aria-label="Next stages">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M5.5 2.5 10 7l-4.5 4.5" stroke="currentColor" stroke-width="1.2" /></svg>
          </button>
        </Fragment>
      </SectionHead>
    </div>

    <CardRow label="Process stages" variant="carousel" class="mt-10 sm:mt-12">
      {approachStages.items.map((stage, index) => (
        <li data-reveal style={`--reveal-delay:${Math.min(index, 3) * 80}ms`}>
          <MediaCard
            image={stage.image}
            alt={stage.alt}
            width={stage.width}
            height={stage.height}
            meta={stage.index}
            title={stage.title}
            description={stage.summary}
            footnote={`You sign off · ${stage.signOff}`}
            size="compact"
          />
        </li>
      ))}
    </CardRow>
  </section>

  <!-- The programme: a route that splits into the modules and site tracks, drawn on scroll -->
  <section id="programme" data-theme="dark" class="scroll-mt-header py-section">
    <div class="shell">
      <div class="grid-12 gap-y-6">
        <div class="col-span-12 md:col-span-6" data-reveal>
          <div class="flex items-center gap-3">
            <p class="label">The programme</p>
            {approachProgramme.confirm && <ToConfirm />}
          </div>
          <h2 class="mt-5 max-w-[16ch] text-h2 sm:mt-6">Factory and site, at the same time</h2>
        </div>
        <p class="col-span-12 max-w-measure self-end text-body text-fg-muted md:col-span-6 md:col-start-7" data-reveal>On a conventional build, the site comes first and construction follows. Here the modules are made while the site is prepared, and the two tracks meet at installation.</p>
      </div>

      <ProgrammeLine class="mt-section" />

      <p class="mt-10 text-caption text-fg-subtle md:mt-8">Stages in order, not to scale.</p>
    </div>
  </section>

  <!-- Who does what: every task, stage by stage, against the roles on a project -->
  <section id="who-does-what" data-theme="light" class="scroll-mt-header py-section">
    <div class="shell">
      <SectionHead label="Who does what" title="Every role, stage by stage" intro="On a design-and-deliver project, this is who leads each task and who’s involved. Under the other ways to engage, your own builder and consultants take on the site roles." rule={false} confirm={responsibilities.confirm} />
      <RoleMatrix class="mt-10 sm:mt-12" />
    </div>
  </section>

  <!-- Ways to engage: hairline rows, as the FAQ -->
  <SplitSection id="engage" label="Ways to engage" confirm={engagementModels.confirm}>
    <p class="text-about">Come to us with a site, a design or a tender. We deliver nationally, with no minimum project size.</p>
    <ol class="mt-10 w-full border-b border-line/[var(--rule-alpha)]">
      {engagementModels.items.map((model, index) => (
        <li class="line-item grid grid-cols-[2rem_1fr] gap-x-4 py-5 sm:grid-cols-[3rem_1fr]">
          <span class="label pt-1">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h3 class="text-body font-medium">{model.title}</h3>
            <p class="mt-2 max-w-[60ch] text-small text-fg-muted">{model.summary}</p>
            <p class="label label-muted mt-4">Suits · {model.suits}</p>
          </div>
        </li>
      ))}
    </ol>
  </SplitSection>

  <FaqSection id="faq" topic="approach" />

  <GetStarted />
</RefreshLayout>
