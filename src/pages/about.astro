---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import PageIntro from "@/components/refresh/PageIntro.astro";
import SplitSection from "@/components/refresh/SplitSection.astro";
import SectionHead from "@/components/refresh/SectionHead.astro";
import CardRow from "@/components/refresh/CardRow.astro";
import MediaCard from "@/components/refresh/MediaCard.astro";
import GetStarted from "@/components/refresh/GetStarted.astro";
import PartnerGrid from "@/components/refresh/PartnerGrid.astro";
import { site, team } from "@/data/site";

const title = "About Us | Modular Construction Experts Perth WA";
const description =
  "Cloud Modular brings design, manufacturing and compliance together to deliver modular buildings with greater control.";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    { "@type": "ListItem", position: 2, name: "About Us", item: `${site.url}/about/` },
  ],
};
---

<RefreshLayout title={title} description={description} canonical="/about/" structuredData={breadcrumbSchema}>
  <!-- On phones the intro and the image under it fill the first screen -->
  <div class="intro-screen mb-section">
    <PageIntro label="About Cloud Modular" title="Building a better way to deliver certainty" lead={description} />

    <!-- Full-width image under the intro -->
    <div class="wide-row intro-grow" data-reveal>
      <div class="intro-frame aspect-[4/3] overflow-hidden rounded bg-stone sm:aspect-[21/9]">
        <img src="/interior.webp" alt="Light-filled modular home interior with a timber kitchen island opening onto a deck" width="1748" height="900" fetchpriority="high" class="h-full w-full object-cover" />
      </div>
    </div>
  </div>

  <SplitSection id="story" label="Our story">
    <p class="text-about">Bringing design, manufacturing and compliance together to deliver modular buildings with greater control.</p>
    <div class="mt-8 max-w-measure space-y-5 text-body text-fg-muted">
      <p>Construction today asks more of every project team. Programs are tighter, expectations are higher and the pressure to deliver consistent quality has never been greater. Modular has become a practical way to meet these demands because it moves much of the work offsite, where production can be planned, measured and repeated with far greater certainty.</p>
      <p>For modular to deliver on its potential, the process has to be aligned from the start. The design needs to suit manufacture. The factory needs to build with consistency. The engineering and compliance work needs to be resolved before anything leaves the floor. When these elements come together, modular gives builders and developers a cleaner program.</p>
      <p>Cloud Modular was created to bring that alignment into a single, coordinated process. We combine architectural thinking, offsite manufacturing capability and rigorous engineering certification to give clients a clear understanding of what will be built, how it will be delivered and the performance they can expect.</p>
      <p>Working with our architectural, engineering and procurement partners, we support each stage of delivery so projects run with fewer variables and greater control. Our focus is simple: modular that is designed well, manufactured precisely and delivered with confidence.</p>
    </div>
  </SplitSection>

  <section id="team" data-theme="light" class="scroll-mt-header pb-section">
    <div class="shell">
      <SectionHead
        label="Our team"
        title="Experience to deliver with confidence"
        intro="Designers, engineers, product specialists and project leads who understand what it takes to resolve modular buildings with precision and confidence."
      />
    </div>
    <CardRow label="Our team" columns={4} class="mt-10 sm:mt-12">
      {team.map((member, index) => (
        <li data-reveal style={`--reveal-delay:${index * 80}ms`}>
          <MediaCard
            image={member.image}
            alt={member.name}
            width={1254}
            height={1254}
            imagePosition={member.position}
            meta={member.role}
            title={member.name}
            description={member.bio}
            size="compact"
          />
        </li>
      ))}
    </CardRow>
  </section>

  <!-- Delivery partners: one gold logo per cell -->
  <section id="partners" data-theme="light" class="scroll-mt-header pb-section">
    <div class="shell">
      <SectionHead label="Partners" title="Who we partner with" intro="We deliver each project with architects, consultants, builders, specialist trades and finance partners, working as one coordinated team." />
      <PartnerGrid class="mt-10 sm:mt-12" />
    </div>
  </section>

  <GetStarted />
</RefreshLayout>
