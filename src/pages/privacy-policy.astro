---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import PageIntro from "@/components/refresh/PageIntro.astro";
import LegalSections from "@/components/refresh/LegalSections.astro";
import { legalUpdated, privacySections } from "@/data/legal";
import { site } from "@/data/site";

const title = "Privacy Policy | Cloud Modular";
const description = "How Cloud Modular collects, holds, uses and shares your personal information.";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    { "@type": "ListItem", position: 2, name: "Privacy Policy", item: `${site.url}/privacy-policy/` },
  ],
};
---

<RefreshLayout title={title} description={description} canonical="/privacy-policy/" structuredData={breadcrumbSchema}>
  <PageIntro label="Privacy Policy" title="Your privacy" lead={`${description} Last updated ${legalUpdated}.`} />
  <LegalSections sections={privacySections} />
</RefreshLayout>
