---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import SectionHead from "@/components/refresh/SectionHead.astro";
import { advantages, faqItems, qualityRows, sectors, site } from "@/data/site";

// Test page for the design refresh. Kept out of search and the sitemap until it replaces `/`.
const title = "Cloud Modular | Alternate Home (Design Refresh)";
const description =
  "Architecturally designed modular buildings, manufactured offsite and certified to Australian Standards.";

// The wide Factory image leads the section, so pillar 02 uses a material detail instead
const pillars = qualityRows.map((row) =>
  row.index === "02" ? { ...row, image: "/Card4.webp", imagePosition: "center" } : row,
);

const stats = [
  { value: "70%", label: "Less landfill than traditional construction" },
  { value: "Up to 20%", label: "Lower labour and material waste" },
  { value: "6", label: "Sectors delivered across Australia" },
  { value: "2", label: "Offices: Perth and Foshan" },
];
---

<RefreshLayout title={title} description={description} canonical="/alt-home/" noindex overlayHeader>
  <!-- Hero: full-bleed image, oversized display line bottom-left (Modscape), dark chrome (Graya) -->
  <section data-hero data-theme="dark" class="relative h-[100svh] min-h-[560px] overflow-hidden">
    <img
      src="/1.webp"
      alt="Street of contemporary modular homes set against wooded hills"
      width="2688"
      height="1792"
      fetchpriority="high"
      class="hero-media absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(11_11_12/0.55)_0%,rgb(11_11_12/0)_28%,rgb(11_11_12/0)_50%,rgb(11_11_12/0.6)_100%)]" aria-hidden="true"></div>
    <div class="shell relative flex h-full flex-col justify-end pb-10 sm:pb-14">
      <div class="grid-12 items-end gap-y-6">
        <h1 class="col-span-12 text-display lg:col-span-8">Premium modular spaces, built in weeks, not years.</h1>
        <div class="col-span-12 flex flex-col items-start gap-5 sm:col-span-8 lg:col-span-4 lg:items-end lg:text-right">
          <p class="max-w-[34ch] text-body text-fg/85">Architecturally designed, manufactured offsite and certified to Australian Standards.</p>
          <a href={site.enquiryHref} class="btn-solid">Enquire now</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro statement -->
  <section data-theme="light" class="py-section">
    <div class="shell grid-12">
      <p class="col-span-12 text-statement lg:col-span-9 xl:col-span-8" data-reveal>
        Cloud Modular brings clear design, precision offsite manufacturing and assured compliance together, giving developers a faster and more predictable way to build.
      </p>
    </div>
  </section>

  <!-- Sectors carousel -->
  <section id="sectors" data-theme="light" class="scroll-mt-header pb-section" data-carousel>
    <div class="shell">
      <SectionHead title="Sectors" intro="Our system adapts across commercial, residential, civic and specialist asset classes, giving clients a faster and more controlled path to delivery.">
        <Fragment slot="actions">
          <button type="button" class="icon-btn" data-carousel-prev aria-label="Previous sectors" disabled>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M8.5 2.5 4 7l4.5 4.5" stroke="currentColor" stroke-width="1.2" /></svg>
          </button>
          <button type="button" class="icon-btn" data-carousel-next aria-label="Next sectors">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M5.5 2.5 10 7l-4.5 4.5" stroke="currentColor" stroke-width="1.2" /></svg>
          </button>
        </Fragment>
      </SectionHead>
    </div>

    <ul
      class="no-scrollbar mt-10 flex snap-x snap-mandatory gap-gap-sm overflow-x-auto scroll-px-gutter px-gutter sm:mt-12"
      data-carousel-track
      aria-label="Sectors"
    >
      {sectors.map((sector, index) => (
        <li class="w-[78vw] shrink-0 snap-start sm:w-[44vw] lg:w-[calc((100vw-2*var(--gutter)-2*var(--gap-sm))/3.25)]" data-reveal style={`--reveal-delay:${index * 80}ms`}>
          <figure class="group">
            <div class="aspect-[4/5] overflow-hidden bg-stone">
              <img src={sector.image} alt={sector.title} width="928" height="1232" loading="lazy" class="h-full w-full object-cover transition-transform duration-slow ease-cm-out group-hover:scale-[1.03]" />
            </div>
            <figcaption class="mt-3">
              <p class="text-body font-medium">{sector.label}</p>
              <p class="mt-1 max-w-[40ch] text-caption text-fg-subtle">{sector.description}</p>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>

  <!-- Quality: module header + full-width image, then three numbered pillars -->
  <section id="quality" data-theme="light" class="scroll-mt-header pb-section">
    <div class="shell">
      <SectionHead title="Quality, compliance & assurance" intro="Factory-controlled production and verified engineering give clients confidence in every module before it reaches site.">
        <a slot="actions" href="/about/" class="btn-outline">How we work</a>
      </SectionHead>

      <div class="mt-10 aspect-[4/3] overflow-hidden bg-stone sm:mt-12 sm:aspect-[21/9]" data-reveal>
        <img src="/Factory.webp" alt="Inside a modular manufacturing facility" width="1456" height="816" loading="lazy" class="h-full w-full object-cover" />
      </div>

      <div class="mt-gap grid gap-x-gap-sm gap-y-12 md:grid-cols-3">
        {pillars.map((row, index) => (
          <article data-reveal style={`--reveal-delay:${index * 100}ms`}>
            <div class="aspect-[4/3] overflow-hidden bg-stone">
              <img src={row.image} alt={row.title} width="1456" height="816" loading="lazy" class="h-full w-full object-cover" style={`object-position:${row.imagePosition}`} />
            </div>
            <p class="mt-4 text-caption tabular-nums text-fg-subtle">{row.index}</p>
            <h3 class="mt-2 text-h3">{row.title}</h3>
            <p class="mt-2 max-w-[42ch] text-small text-fg-muted">{row.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- About: Graya-style staggered, asymmetric image columns -->
  <section data-theme="light" class="pb-section">
    <div class="shell">
      <div class="grid-12 rule gap-y-10 pt-6">
        <p class="col-span-12 text-small font-medium md:col-span-3" data-reveal>About</p>
        <div class="col-span-12 space-y-5 md:col-span-6 lg:col-span-5" data-reveal>
          <p class="text-lead">Cloud Modular offers clarity and certainty to a changing construction landscape.</p>
          <p class="text-body text-fg-muted">
            Labour shortages, rising costs and tighter compliance make traditional builds harder to deliver predictably. We partner with leading architectural, engineering and procurement teams to take a more controlled approach, with clear design, offsite manufacturing and assured compliance from the start.
          </p>
          <a href="/about/" class="btn-outline">Our story</a>
        </div>
      </div>

      <div class="grid-12 mt-16 items-start gap-y-8 sm:mt-20">
        <div class="col-span-10 md:col-span-5 md:col-start-2 lg:col-span-4 lg:col-start-4" data-reveal>
          <div class="aspect-[3/4] overflow-hidden bg-stone">
            <img src="/About1.webp" alt="Cloud Modular coastal home exterior at dusk" width="1856" height="2464" loading="lazy" class="h-full w-full object-cover" />
          </div>
        </div>
        <div class="col-span-7 col-start-6 md:col-span-3 md:col-start-9 md:mt-40 lg:col-start-9" data-reveal style="--reveal-delay:150ms">
          <div class="aspect-[3/4] overflow-hidden bg-stone">
            <img src="/about2.webp" alt="Garden path leading to a modular home" width="1856" height="2464" loading="lazy" class="h-full w-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Full-bleed break image -->
  <section data-theme="dark" class="relative h-[70svh] min-h-[420px] overflow-hidden" aria-label="Project imagery">
    <img src="/aboutpage.webp" alt="Terraced modular townhouses among tropical planting" width="2912" height="1632" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
  </section>

  <!-- Stats: Modscape project-page numerals -->
  <section data-theme="light" class="py-section">
    <div class="shell">
      <SectionHead title="Why modular" intro="Most of the build happens offsite, which shortens programmes, reduces site disruption and improves cost certainty." />
      <dl class="mt-12 grid grid-cols-2 gap-x-gap-sm gap-y-10 lg:grid-cols-4">
        {stats.map((stat, index) => (
          <div class="flex flex-col" data-reveal style={`--reveal-delay:${index * 80}ms`}>
            <dt class="order-2 mt-2 max-w-[24ch] text-small text-fg-muted">{stat.label}</dt>
            <dd class="order-1 text-h1 tabular-nums">{stat.value}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-section-sm grid gap-gap-sm sm:grid-cols-2 lg:grid-cols-3">
        {advantages.map((card, index) => (
          <article
            class:list={["flex min-h-[18rem] flex-col justify-between p-5 sm:p-6", index % 2 === 0 ? "bg-stone" : "bg-sage"]}
            data-reveal
            style={`--reveal-delay:${(index % 3) * 80}ms`}
          >
            <p class="text-lead">{card.points[0]}</p>
            <h3 class="mt-10 text-small font-medium">{card.title}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ: label column + accordion, Modscape spec-sheet layout -->
  <section id="faq" data-theme="light" class="scroll-mt-header pb-section">
    <div class="shell">
      <div class="grid-12 rule gap-y-8 pt-section">
        <h2 class="col-span-12 text-h2 md:col-span-4" data-reveal>Questions</h2>
        <div class="col-span-12 md:col-span-8 lg:col-span-7 lg:col-start-6" data-reveal>
          {faqItems.map((item) => (
            <details class="faq group border-b border-line/20 first:border-t">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 text-body font-medium">
                <span>{item.question}</span>
                <span class="relative h-3 w-3 shrink-0" aria-hidden="true">
                  <span class="absolute left-0 top-1/2 h-px w-3 bg-fg"></span>
                  <span class="absolute left-1/2 top-0 h-3 w-px bg-fg transition-transform duration-base group-open:scale-y-0"></span>
                </span>
              </summary>
              <p class="max-w-[60ch] pb-5 text-small text-fg-muted">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</RefreshLayout>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-media {
      animation: hero-settle 2.4s var(--ease-out) both;
    }
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.06);
      opacity: 0.6;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-carousel-track]");
    const prev = root.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-carousel-next]");
    if (!track || !prev || !next) return;

    const step = () => {
      const item = track.firstElementChild as HTMLElement | null;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return item ? item.offsetWidth + gap : track.clientWidth;
    };

    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    };

    prev.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
    next.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));
    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  });
</script>
