---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import PageIntro from "@/components/refresh/PageIntro.astro";
import { site } from "@/data/site";
---

<RefreshLayout title="Page Not Found | Cloud Modular" description="The requested page could not be found." noindex>
  <div class="flex min-h-[70svh] flex-col justify-center">
    <PageIntro label="Error 404" title="Page not found" lead="The page you’re looking for doesn’t exist or has been moved.">
      <div class="mt-10 flex flex-wrap justify-center gap-1">
        <a href="/" class="btn">Back to home</a>
        <a href={site.contactHref} class="btn">Contact us</a>
      </div>
    </PageIntro>
  </div>
</RefreshLayout>
