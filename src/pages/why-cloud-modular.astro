---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import PageIntro from "@/components/refresh/PageIntro.astro";
import SplitSection from "@/components/refresh/SplitSection.astro";
import FaqSection from "@/components/refresh/FaqSection.astro";
import GetStarted from "@/components/refresh/GetStarted.astro";
import { advantages, whyNow } from "@/data/site";

const title = "Why Cloud Modular | Cloud Modular";
const description =
  "Most of the build happens offsite, which shortens programmes, reduces site disruption and improves cost certainty.";

const stats = [
  { value: "70%", label: "Less landfill than traditional construction" },
  { value: "Up to 20%", label: "Lower labour and material waste" },
  { value: "6", label: "Sectors delivered across Australia" },
  { value: "2", label: "Offices: Perth and Foshan" },
];
---

<RefreshLayout title={title} description={description} canonical="/why-cloud-modular/">
  <PageIntro label="Why Cloud Modular" title="Faster, cleaner, more certain" lead="Most of the build happens offsite, which shortens programmes, reduces site disruption and improves cost certainty." />

  <!-- Full-width image under the intro, as on the other pages -->
  <div class="wide-row" data-reveal>
    <div class="aspect-[4/3] overflow-hidden rounded bg-stone sm:aspect-[21/9]">
      <img src="/why/hero.webp" alt="A module wrapped for transport in white film carrying the Cloud Modular mark, lit by the evening sun" width="1672" height="941" fetchpriority="high" class="h-full w-full object-cover" style="object-position:center 40%" />
    </div>
  </div>

  <!-- Why now: the market case, with its two headline figures -->
  <SplitSection id="why-now" label="Why now" rule={false}>
    <p class="text-about">{whyNow.intro}</p>
    <dl class="mt-10 grid w-full grid-cols-2 gap-x-gap-sm">
      {whyNow.stats.map((stat) => (
        <div class="flex flex-col border-t border-line/[var(--rule-alpha)] pt-5">
          <dt class="order-2 mt-3 max-w-[24ch] text-small text-fg-muted">{stat.label}</dt>
          <dd class="order-1 text-h1 tabular-nums">{stat.value}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-10 max-w-measure text-body text-fg-muted">{whyNow.body}</p>
  </SplitSection>

  <!-- By the numbers: the four figures in the Why now style -->
  <SplitSection id="numbers" label="By the numbers">
    <dl class="grid w-full grid-cols-2 gap-x-gap-sm gap-y-10">
      {stats.map((stat, index) => (
        <div class="flex flex-col border-t border-line/[var(--rule-alpha)] pt-5" data-reveal style={`--reveal-delay:${index * 80}ms`}>
          <dt class="order-2 mt-3 max-w-[24ch] text-small text-fg-muted">{stat.label}</dt>
          <dd class="order-1 text-h1 tabular-nums">{stat.value}</dd>
        </div>
      ))}
    </dl>
  </SplitSection>

  <!-- Advantages on slate: label, title and button, then six numbered columns under hairline rules -->
  <section id="advantages" data-theme="dark" data-surface="slate" class="scroll-mt-header py-section">
    <div class="shell">
      <div data-reveal>
        <p class="label">Advantages</p>
        <h2 class="mt-5 text-h2 sm:mt-6">Our modular advantage</h2>
        <a href="/quality/" class="btn mt-10">How every module is made and checked</a>
      </div>

      <ol class="mt-section-sm grid gap-x-gap-sm gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {advantages.map((card, index) => (
          <li class="border-t border-line/[var(--rule-alpha)] pt-5" data-reveal style={`--reveal-delay:${(index % 3) * 80}ms`}>
            <p class="label" aria-hidden="true">{String(index + 1).padStart(2, "0")}</p>
            <h3 class="mt-8 text-lead">{card.title}</h3>
            <p class="mt-3 max-w-[38ch] text-small text-fg-muted">{card.points[0]}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <FaqSection id="faq" topic="why" rule={false} />

  <GetStarted />
</RefreshLayout>
