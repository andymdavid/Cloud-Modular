---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import FaqSection from "@/components/refresh/FaqSection.astro";
import { advantages } from "@/data/site";

// Design-refresh page (from the alt home's former Why Modular section). Kept out of search and the sitemap until launch.
const title = "Why Cloud Modular | Cloud Modular";
const description =
  "Most of the build happens offsite, which shortens programmes, reduces site disruption and improves cost certainty.";

const stats = [
  { value: "70%", label: "Less landfill than traditional construction" },
  { value: "Up to 20%", label: "Lower labour and material waste" },
  { value: "6", label: "Sectors delivered across Australia" },
  { value: "2", label: "Offices: Perth and Foshan" },
];
---

<RefreshLayout title={title} description={description} canonical="/why-cloud-modular/" noindex>
  <!-- Page intro: centred label and title (olympic.no "Fleet focus"), clear of the fixed header -->
  <section data-theme="light" class="pb-section-sm pt-[calc(var(--header-h)+var(--section))]">
    <div class="shell text-center" data-reveal>
      <p class="label">Why Cloud Modular</p>
      <h1 class="mx-auto mt-8 max-w-[18ch] text-feature">Faster, cleaner, more certain</h1>
      <p class="mx-auto mt-8 max-w-measure text-about text-fg-muted">Most of the build happens offsite, which shortens programmes, reduces site disruption and improves cost certainty.</p>
    </div>
  </section>

  <!-- Dark 50/50 split (cf. olympic.no "Origin matters"): label and title left, numerals in sage right, then the
       advantage tiles -->
  <section id="why-modular" data-theme="dark" class="scroll-mt-header py-section">
    <div class="shell">
      <div class="grid-12 gap-y-12">
        <div class="col-span-12 lg:col-span-5" data-reveal>
          <p class="label">By the numbers</p>
          <h2 class="mt-5 text-h2 sm:mt-6">The offsite advantage</h2>
        </div>
        <dl class="col-span-12 grid grid-cols-2 gap-x-gap-sm gap-y-10 self-end lg:col-span-6 lg:col-start-7">
          {stats.map((stat, index) => (
            <div class="flex flex-col border-t border-line/[var(--rule-alpha)] pt-5" data-reveal style={`--reveal-delay:${index * 80}ms`}>
              <dt class="order-2 mt-3 max-w-[24ch] text-small text-fg-muted">{stat.label}</dt>
              <dd class="order-1 text-h1 tabular-nums text-sage">{stat.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="mt-section-sm grid gap-gap-sm sm:grid-cols-2 lg:grid-cols-3">
        {advantages.map((card, index) => (
          <article
            data-theme={index % 2 === 0 ? undefined : "light"}
            class:list={["flex min-h-[18rem] flex-col justify-between rounded p-5 sm:p-6", index % 2 === 0 ? "bg-surface-alt" : "bg-sage"]}
            data-reveal
            style={`--reveal-delay:${(index % 3) * 80}ms`}
          >
            <p class="text-lead">{card.points[0]}</p>
            <h3 class="label mt-10">{card.title}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FaqSection id="faq" topic="why" rule={false} />
</RefreshLayout>
