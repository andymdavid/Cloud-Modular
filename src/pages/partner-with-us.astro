---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import { site } from "@/data/site";

const title = "Get a Quote | Modular Construction Perth | Contact Us";
const description =
  "Discuss your modular construction project in Perth and Western Australia with Cloud Modular.";
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url },
      { "@type": "ListItem", position: 2, name: "Partner With Us", item: `${site.url}/partner-with-us/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "@id": `${site.url}/partner-with-us/#contactpage`,
    url: `${site.url}/partner-with-us/`,
    name: "Contact Cloud Modular",
    description,
    mainEntity: { "@id": `${site.url}/#organization` },
  },
];
---

<BaseLayout title={title} description={description} canonical="/partner-with-us/" structuredData={schemas}>
  <div class="bg-[#010101] text-white">
    <section class="grid min-h-[45vh] grid-rows-[1fr_auto]">
      <div class="flex items-center pt-16">
        <div class="section-container w-full py-20 text-center">
          <SectionLabel text="Get In Touch" />
          <h1 class="mt-6 font-host-grotesk text-[32px] font-bold leading-[34px] tracking-[-0.03em] sm:text-[48px] sm:leading-[50px] lg:text-[60px] lg:leading-[62px]">Partner With Us.</h1>
          <p class="section-copy mx-auto mt-3 max-w-[440px]">Let’s discuss how Cloud Modular can deliver your project with precision and confidence.</p>
        </div>
      </div>
      <div class="border-b border-white/5"></div>
    </section>

    <section class="min-h-[55vh]">
      <div class="section-container py-20">
        <div class="mx-auto grid max-w-5xl gap-12 lg:grid-cols-2">
          <div class="space-y-6">
            <SectionLabel text="Address" />
            <div class="space-y-6">
              {site.offices.map((office) => (
                <div>
                  <h2 class="font-host-grotesk text-[18px] font-medium leading-5 tracking-[-0.03em]">{office.city}</h2>
                  <div class="mt-3 space-y-1">{office.lines.map((line) => <p class="section-copy">{line}</p>)}</div>
                </div>
              ))}
            </div>
          </div>
          <div class="space-y-6">
            <SectionLabel text="Connect" />
            <div class="space-y-6">
              <div>
                <h2 class="font-host-grotesk text-[18px] font-medium leading-5 tracking-[-0.03em]">Email</h2>
                <a href={site.enquiryHref} class="section-copy mt-3 inline-block transition hover:text-white/70">{site.email}</a>
              </div>
              <div>
                <h2 class="font-host-grotesk text-[18px] font-medium leading-5 tracking-[-0.03em]">General Enquiries</h2>
                <p class="section-copy mt-3">{site.hours}</p>
              </div>
              <div>
                <h2 class="font-host-grotesk text-[18px] font-medium leading-5 tracking-[-0.03em]">LinkedIn</h2>
                <a href={site.linkedIn} target="_blank" rel="noreferrer" class="section-copy mt-3 inline-block transition hover:text-white/70">Visit LinkedIn</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
