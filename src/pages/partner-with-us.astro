---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import PageIntro from "@/components/refresh/PageIntro.astro";
import SplitSection from "@/components/refresh/SplitSection.astro";
import { site } from "@/data/site";

const title = "Get a Quote | Modular Construction Perth | Contact Us";
const description =
  "Discuss your modular construction project in Perth and Western Australia with Cloud Modular.";
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url },
      { "@type": "ListItem", position: 2, name: "Partner With Us", item: `${site.url}/partner-with-us/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "@id": `${site.url}/partner-with-us/#contactpage`,
    url: `${site.url}/partner-with-us/`,
    name: "Contact Cloud Modular",
    description,
    mainEntity: { "@id": `${site.url}/#organization` },
  },
];
---

<RefreshLayout title={title} description={description} canonical="/partner-with-us/" structuredData={schemas}>
  <PageIntro label="Get in touch" title="Partner with us" lead="Let’s discuss how Cloud Modular can deliver your project with precision and confidence.">
    <a href={site.enquiryHref} class="btn mt-10">Enquire now</a>
  </PageIntro>

  <!-- Contact details: one row per channel, label and value -->
  <SplitSection id="contact-details" label="Connect">
    <dl class="w-full border-b border-line/[var(--rule-alpha)] text-body">
      <div class="contact-row">
        <dt class="label label-muted">Email</dt>
        <dd><a href={site.enquiryHref} class="text-link">{site.email}</a></dd>
      </div>
      <div class="contact-row">
        <dt class="label label-muted">Hours</dt>
        <dd>{site.hours}</dd>
      </div>
      <div class="contact-row">
        <dt class="label label-muted">LinkedIn</dt>
        <dd><a href={site.linkedIn} target="_blank" rel="noreferrer" class="text-link">Cloud Modular on LinkedIn</a></dd>
      </div>
    </dl>
  </SplitSection>

  <SplitSection id="offices" label="Offices">
    <div class="grid w-full gap-x-gap-sm gap-y-10 sm:grid-cols-2">
      {site.offices.map((office) => (
        <div>
          <h3 class="text-about">{office.city}</h3>
          <div class="mt-3 text-body text-fg-muted">{office.lines.map((line) => <p>{line}</p>)}</div>
        </div>
      ))}
    </div>
  </SplitSection>
</RefreshLayout>

<style>
  .contact-row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1rem;
    border-top: var(--rule) solid rgb(var(--line) / var(--rule-alpha));
  }
</style>
