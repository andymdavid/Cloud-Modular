---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import SplitSection from "@/components/refresh/SplitSection.astro";
import SectionHead from "@/components/refresh/SectionHead.astro";
import CardRow from "@/components/refresh/CardRow.astro";
import MediaCard from "@/components/refresh/MediaCard.astro";
import ClientStrip from "@/components/refresh/ClientStrip.astro";
import FeatureTiles from "@/components/refresh/FeatureTiles.astro";
import TradeDocument from "@/components/refresh/TradeDocument.astro";
import Testimonial from "@/components/refresh/Testimonial.astro";
import FaqSection from "@/components/refresh/FaqSection.astro";
import GetStarted from "@/components/refresh/GetStarted.astro";
import { brands } from "@/data/brands";
import { faqItems, site } from "@/data/site";
import { tradeCaseStudies, tradeClients, tradeHero, tradeIntro, tradeRange, tradeTestimonial, tradeWays } from "@/data/trade";

const title = "Cloud Trade | Procurement for Builders and Developers | Australia";
const description =
  "Cloud Trade supplies builders and developers across Australia through a trade network built on 30 years of business in China, with manufacture, inspection, freight and delivery managed for you.";

const account = brands.trade.cta;
const request = { label: "Send us your schedule", href: "/trade/start/" };

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems
    .filter((item) => item.topic === "trade")
    .map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })),
};
const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${site.url}/trade/#webpage`,
  url: `${site.url}/trade/`,
  name: title,
  description,
  isPartOf: { "@id": `${site.url}/#website` },
};
---

<RefreshLayout title={title} description={description} canonical="/trade/" structuredData={[faqSchema, pageSchema]} brand="trade" overlayHeader>
  <!-- Hero: as the home page, the display line bottom-left and the action bottom-right, over a looping film from
       the factory floor to a container ship at sea -->
  <section data-hero data-theme="dark" data-surface="slate" class="trade-hero relative h-[100svh] min-h-[560px] overflow-hidden">
    <video
      src="/media/trade-hero.mp4"
      poster="/trade/hero-poster.webp"
      width="1920"
      height="1080"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
      data-hero-video
      class="hero-media absolute inset-0 h-full w-full object-cover"
    ></video>
    <div class="trade-hero-scrim absolute inset-0" aria-hidden="true"></div>
    <div class="shell relative flex h-full flex-col justify-end pb-10 sm:pb-14">
      <div class="grid-12 items-end gap-y-6">
        <h1 class="col-span-12 text-hero lg:col-span-8">{tradeHero.title}</h1>
        <div class="col-span-12 flex flex-col items-start gap-5 sm:col-span-8 lg:col-span-4 lg:items-end lg:text-right">
          <p class="max-w-[34ch] text-body text-fg/85 [text-wrap:balance]">{tradeHero.lead}</p>
          <a href={request.href} class="btn">{request.label}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Clients straight after the hero, drifting slowly -->
  <ClientStrip label="Our clients include" logos={tradeClients} path="/trade/clients" />

  <SplitSection id="about" label="About Cloud Trade">
    <p class="text-about">{tradeIntro}</p>
  </SplitSection>

  <!-- How we work: the two halves of one service, your account and our team, as image tiles (The Cloud Modular
       difference on the home page) -->
  <section id="ways" data-theme="light" class="scroll-mt-header pb-section">
    <div class="shell">
      <SectionHead label="How we work" title={tradeWays.title} intro={tradeWays.intro} />
    </div>
    <FeatureTiles items={tradeWays.tiles} class="mt-12 sm:mt-16" />
  </section>

  <!-- How it works: the paperwork fanned on a stone stage, leading to the full journey -->
  <section id="how-it-works" data-theme="light" class="scroll-mt-header pb-section">
    <div class="shell">
      <div class="rule grid-12 items-center gap-y-12 pt-section">
        <div class="col-span-12 flex flex-col items-start md:col-span-5" data-reveal>
          <p class="label">How it works</p>
          <h2 class="mt-6 text-h2">From schedule to site</h2>
          <p class="mt-6 max-w-[34ch] text-about">You send us a schedule. You get a quote, an inspection report and a delivery on site, and we handle everything in between.</p>
          <a href="/trade/how-it-works/" class="btn mt-10">How it works</a>
        </div>
        <div class="col-span-12 md:col-span-7" data-reveal>
          <div class="doc-fan" aria-hidden="true" data-fan>
            <div class="fan-inner">
              <TradeDocument doc="quote" staged={false} class="fan-1" />
              <TradeDocument doc="inspection" staged={false} class="fan-2" />
              <TradeDocument doc="delivery" staged={false} class="fan-3" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Range: a carousel sized as the home page's Sectors, until the catalogue supplies the range -->
  <section id="range" data-theme="light" class="scroll-mt-header pb-section" data-carousel>
    <div class="shell">
      <SectionHead label="Range" title="What we supply" intro="Products for residential and mixed-use developments, made to Australian Standards.">
        <Fragment slot="actions">
          <button type="button" class="icon-btn" data-carousel-prev aria-label="Previous products" disabled>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M8.5 2.5 4 7l4.5 4.5" stroke="currentColor" stroke-width="1.2" /></svg>
          </button>
          <button type="button" class="icon-btn" data-carousel-next aria-label="Next products">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M5.5 2.5 10 7l-4.5 4.5" stroke="currentColor" stroke-width="1.2" /></svg>
          </button>
        </Fragment>
      </SectionHead>
    </div>

    <CardRow label="Range" variant="carousel" class="mt-10 sm:mt-12">
      {tradeRange.map((category, index) => (
        <li data-reveal style={`--reveal-delay:${index * 80}ms`}>
          <MediaCard
            image={category.image}
            alt={category.title}
            width={category.width}
            height={category.height}
            imagePosition={category.imagePosition}
            meta={String(index + 1).padStart(2, "0")}
            title={category.title}
            description={category.description}
            size="compact"
          />
        </li>
      ))}
    </CardRow>
  </section>

  <!-- Clients: what we supplied to whom (logo cards on slate, or a project photo), then the Hanssen quote -->
  <section id="clients" data-theme="light" class="scroll-mt-header pb-section">
    <div class="shell">
      <SectionHead label="Clients" title="Who we supply" intro={tradeCaseStudies.intro} />
    </div>

    <CardRow label="Clients" class="mt-12 sm:mt-16 lg:gap-y-14">
      {tradeCaseStudies.items.map((item, index) => (
        <li data-reveal style={`--reveal-delay:${index * 80}ms`}>
          <figure class="case">
            <div class="case-media">
              {"text" in item ? (
                <span class="case-text" role="img" aria-label={item.client}>{item.text.map((line) => <span>{line}</span>)}</span>
              ) : (
                <span class="case-logo" role="img" aria-label={item.client} style={`--logo:url(/trade/clients/${item.logo}.png)`}></span>
              )}
            </div>
            <figcaption>
              <p class="label label-muted mt-4">{item.supplied}</p>
              <p class="mt-2 text-body font-medium">{item.client}</p>
              <p class="mt-1 max-w-[40ch] text-caption text-fg-subtle">{item.body}</p>
            </figcaption>
          </figure>
        </li>
      ))}
    </CardRow>
  </section>

  <SplitSection id="testimonial" label="In their words">
    <Testimonial {...tradeTestimonial} logo={`/trade/clients/${tradeTestimonial.logo}.png`} />
  </SplitSection>

  <FaqSection id="faq" topic="trade" more={false} />

  <GetStarted text="Send us your schedule and we will come back with a quote, or open an account and start your first order." actions={[request, account]} />
</RefreshLayout>

<style>
  .trade-hero {
    background: rgb(var(--slate));
  }

  /* A light fade under the header, and an eased dark fade rising from the foot behind the headline (as
     olympic.no's hero), mixed in oklab so it has no visible band */
  .trade-hero-scrim {
    --scrim: 52svh;
    background:
      linear-gradient(to bottom, rgb(11 11 12 / 0.45) 0, rgb(11 11 12 / 0) 9rem),
      linear-gradient(
        to top in oklab,
        rgb(11 11 12 / 0.86) 0,
        rgb(11 11 12 / 0.62) calc(var(--scrim) * 0.3),
        rgb(11 11 12 / 0.38) calc(var(--scrim) * 0.55),
        rgb(11 11 12 / 0.16) calc(var(--scrim) * 0.75),
        rgb(11 11 12 / 0.04) calc(var(--scrim) * 0.9),
        rgb(11 11 12 / 0) var(--scrim)
      );
  }

  /* Three documents fanned on a stone stage */
  .doc-fan {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: rgb(var(--stone));
  }

  /* The documents spread across an inner box. A script measures the three rotated sheets together and sets the
     stage's height and the box's offset so the group has the same margin on all four sides. */
  .fan-inner {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(68%, 34rem);
    height: 74%;
    transform: translate(-50%, -50%);
  }

  .doc-fan.is-measured {
    aspect-ratio: auto;
  }

  .doc-fan.is-measured .fan-inner {
    left: var(--fan-x);
    top: var(--fan-y);
    transform: none;
  }

  .fan-inner :global(.doc-stage) {
    position: absolute;
    width: 68%;
    transition: transform 0.9s var(--ease-out);
  }

  .fan-inner :global(.fan-1) {
    left: 0;
    top: 0;
    transform: rotate(-6deg);
  }

  /* Vertical steps in rem, so the group's shape doesn't depend on the stage's height */
  .fan-inner :global(.fan-2) {
    left: 16%;
    top: 2.5rem;
    transform: rotate(1.5deg);
  }

  .fan-inner :global(.fan-3) {
    left: 32%;
    top: 5rem;
    transform: rotate(7deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .doc-fan:hover :global(.fan-1) {
      transform: rotate(-9deg) translate(-4%, -3%);
    }

    .doc-fan:hover :global(.fan-3) {
      transform: rotate(10deg) translate(4%, 3%);
    }
  }

  /* Client cards: landscape frames with the image cards' caption rhythm; logos sit gold on slate */
  .case-media {
    display: flex;
    aspect-ratio: 3 / 2;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: rgb(var(--slate));
  }

  /* A client without a logo: its names set in gold, like a wordmark */
  .case-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    padding-inline: 12%;
    color: rgb(var(--gold));
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 0.9rem + 0.6vw, 1.5rem);
    line-height: 1.15;
    letter-spacing: var(--tracking-title);
    text-align: center;
    text-transform: uppercase;
  }

  .case-logo {
    width: 56%;
    height: 38%;
    background: rgb(var(--gold));
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }
</style>

<script>
  const heroVideo = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  if (heroVideo && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    heroVideo.removeAttribute("autoplay");
    heroVideo.pause();
  }

  // Centre the fanned documents: measure the three rotated sheets as one group (their rest positions, not the
  // hover spread), then size the stage so the group has an equal margin on all four sides.
  document.querySelectorAll<HTMLElement>("[data-fan]").forEach((fan) => {
    const inner = fan.querySelector<HTMLElement>(".fan-inner")!;
    const sheets = [...inner.querySelectorAll<HTMLElement>(".doc-stage")];

    const measure = () => {
      fan.classList.remove("is-measured");
      fan.style.height = "";
      const box = fan.getBoundingClientRect();
      const rects = sheets.map((sheet) => sheet.getBoundingClientRect());
      const left = Math.min(...rects.map((r) => r.left));
      const right = Math.max(...rects.map((r) => r.right));
      const top = Math.min(...rects.map((r) => r.top));
      const bottom = Math.max(...rects.map((r) => r.bottom));
      const innerRect = inner.getBoundingClientRect();
      const margin = (box.width - (right - left)) / 2;
      // Where the inner box must sit so the group starts one margin in from the stage's left and top
      fan.style.setProperty("--fan-x", `${margin - (left - innerRect.left)}px`);
      fan.style.setProperty("--fan-y", `${margin - (top - innerRect.top)}px`);
      fan.style.height = `${bottom - top + margin * 2}px`;
      fan.classList.add("is-measured");
    };

    // Re-measure whenever the stage's width changes (its height is ours to set), and once fonts and images settle
    let width = 0;
    new ResizeObserver(([entry]) => {
      if (Math.abs(entry.contentRect.width - width) < 0.5) return;
      width = entry.contentRect.width;
      measure();
    }).observe(fan);
    document.fonts?.ready.then(measure);
    window.addEventListener("load", measure);
  });
</script>
