---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import SplitSection from "@/components/refresh/SplitSection.astro";
import SectionHead from "@/components/refresh/SectionHead.astro";
import CardRow from "@/components/refresh/CardRow.astro";
import MediaCard from "@/components/refresh/MediaCard.astro";
import Accordion from "@/components/refresh/Accordion.astro";
import EnquiryForm from "@/components/refresh/EnquiryForm.astro";
import WaterSequence from "@/components/water/WaterSequence.astro";
import FiltrationExplorer from "@/components/water/FiltrationExplorer.astro";
import SpecSheetModal from "@/components/water/SpecSheetModal.astro";
import { site } from "@/data/site";
import { waterActions, waterBenefits, waterFaqs, waterHero, waterModels, waterPricing, waterRemoval, waterSequence } from "@/data/water";

/**
 * Cloud whole-house water filtration, a product page that branches off Cloud Trade (as Cloud Homes does off Modular).
 * It sells the product first: the system itself in the hero, what it does for the household, how it works, what it
 * takes out, the two models and the questions people ask, then trade pricing as the one form. The spec sheet opens in
 * a modal. Images are placeholders until the 3D model and renders are made, and the drawn schematic stands in for the
 * 3D sequence. Copy is in src/data/water.ts.
 */
const title = "Whole-House Water Filtration | Cloud Trade";
const description =
  "A three-stage whole-house water filter for the mains supply. Cleaner, better-tasting water from every tap, shower and appliance. Trade pricing for plumbers and builders.";

const specRows = waterModels[0].specs.map((row, index) => ({ label: row.label, values: waterModels.map((model) => model.specs[index].value) }));

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Cloud Trade", item: `${site.url}/trade/` },
      { "@type": "ListItem", position: 2, name: "Water filtration", item: `${site.url}/trade/water-filtration/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: waterFaqs.map((item) => ({ "@type": "Question", name: item.title, acceptedAnswer: { "@type": "Answer", text: item.body } })),
  },
];
---

<RefreshLayout title={title} description={description} canonical="/trade/water-filtration/" structuredData={schemas} brand="trade" overlayHeader>
  <!-- Hero: the product on a warm stone stage on the right, the headline and actions on the left -->
  <section data-hero data-theme="light" class="relative overflow-hidden">
    <div class="shell grid min-h-[100svh] grid-cols-12 items-end gap-x-gap-sm gap-y-10 pb-10 pt-[calc(var(--header-h)+2rem)] sm:pb-14">
      <div class="water-hero-product col-span-12 self-stretch lg:col-span-7 lg:col-start-6 lg:row-start-1" aria-hidden="true">
        <span class="label label-muted">Product render to come</span>
      </div>
      <div class="col-span-12 lg:col-span-5 lg:row-start-1">
        <p class="label">{waterHero.byline}</p>
        <h1 class="mt-6 text-hero">{waterHero.title}</h1>
        <p class="mt-8 max-w-[38ch] text-body text-fg-muted">{waterHero.lead}</p>
        <div class="mt-10 flex flex-wrap gap-1">
          <a href={waterActions.pricing.href} class="btn">{waterActions.pricing.label}</a>
          <button type="button" class="btn" data-spec-sheet-open>{waterActions.specSheet.label}</button>
        </div>
      </div>
    </div>
  </section>

  <!-- At home: what it does for the people who live with it, an image over each (Cloud Homes' card row) -->
  <section id="at-home" data-theme="light" class="scroll-mt-header pb-section pt-section">
    <div class="shell">
      <SectionHead label="At home" title="Better water in every room" rule={false} />
    </div>
    <CardRow label="What it does at home" columns={4} class="mt-10 sm:mt-12">
      {waterBenefits.map((benefit, index) => (
        <li data-reveal style={`--reveal-delay:${index * 80}ms`}>
          <MediaCard alt="" title={benefit.title} description={benefit.body} size="compact" ratio="aspect-[4/5]" />
        </li>
      ))}
    </CardRow>
  </section>

  <WaterSequence
    id="how-it-works"
    label="How it works"
    title="Three stages, one path"
    intro="Every drop that comes into the house passes through three cartridges in turn, each with its own job."
    steps={waterSequence}
  />

  <FiltrationExplorer
    id="what-it-takes-out"
    label="Filtration"
    title={waterRemoval.title}
    intro={waterRemoval.intro}
    stages={waterRemoval.stages}
    contaminants={waterRemoval.contaminants}
    figures={waterRemoval.figures}
  />

  <!-- The two models, then their specifications side by side -->
  <section id="models" data-theme="light" class="scroll-mt-header pb-section">
    <div class="shell">
      <SectionHead label="Two models" title="Steel frame or stainless steel">
        <Fragment slot="actions"><button type="button" class="btn" data-spec-sheet-open>{waterActions.specSheet.label}</button></Fragment>
      </SectionHead>
      <ul class="mt-10 grid gap-x-gap-sm gap-y-12 sm:mt-12 md:grid-cols-2">
        {waterModels.map((model, index) => (
          <li data-reveal style={`--reveal-delay:${index * 80}ms`}>
            <MediaCard alt={`The ${model.model}`} meta={model.model} title={model.name} description={model.summary} size="compact" ratio="aspect-[4/3]" />
          </li>
        ))}
      </ul>

      <table class="water-specs mt-16 w-full">
        <caption class="sr-only">Specifications of the two models</caption>
        <thead>
          <tr>
            <th scope="col"><span class="label label-muted">Specifications</span></th>
            {waterModels.map((model) => <th scope="col"><span class="label">{model.model}</span></th>)}
          </tr>
        </thead>
        <tbody>
          {specRows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {row.values.map((value) => <td>{value}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <SplitSection id="faq" label="Questions">
    <Accordion items={waterFaqs} name="water-faq" />
  </SplitSection>

  <SplitSection id="get-pricing" label="For the trade">
    <h2 class="text-h3">{waterPricing.title}</h2>
    <p class="mt-4 max-w-[52ch] text-body text-fg-muted">{waterPricing.intro}</p>
    <EnquiryForm variant="water" class="mt-10" />
  </SplitSection>

  <SpecSheetModal />
</RefreshLayout>

<style>
  /* The product's stage until the render is made: warm stone, as the Trade range renders */
  .water-hero-product {
    display: flex;
    min-height: 24rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-media);
    background: radial-gradient(70% 60% at 50% 55%, rgb(var(--stone)), rgb(var(--stone) / 0.55));
  }

  .water-specs {
    border-collapse: collapse;
    font-size: var(--text-small);
  }

  .water-specs :is(th, td) {
    padding: 1rem 1rem 1rem 0;
    border-bottom: var(--rule) solid rgb(var(--line) / var(--rule-alpha));
    text-align: left;
    vertical-align: top;
    font-weight: var(--weight-regular);
  }

  .water-specs tbody th {
    width: 22%;
    color: rgb(var(--fg-muted));
  }

  .water-specs tbody td {
    width: 39%;
  }

  @media (max-width: 40rem) {
    .water-specs tbody th {
      width: 30%;
    }
  }
</style>
