---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import SplitSection from "@/components/refresh/SplitSection.astro";
import SectionHead from "@/components/refresh/SectionHead.astro";
import CardRow from "@/components/refresh/CardRow.astro";
import MediaCard from "@/components/refresh/MediaCard.astro";
import Accordion from "@/components/refresh/Accordion.astro";
import EnquiryForm from "@/components/refresh/EnquiryForm.astro";
import WaterSequence from "@/components/water/WaterSequence.astro";
import FiltrationExplorer from "@/components/water/FiltrationExplorer.astro";
import SpecSheetModal from "@/components/water/SpecSheetModal.astro";
import { site } from "@/data/site";
import { waterActions, waterBenefits, waterCare, waterFaqs, waterHero, waterModels, waterPricing, waterRemoval, waterSequence, waterSpotlight } from "@/data/water";

/**
 * Cloud whole-house water filtration, a product page that branches off Cloud Trade (as Cloud Homes does off Modular).
 * It sells the product first: the system itself in the hero, what it does for the household, how it works, what it
 * takes out, the two models and the questions people ask, then trade pricing as the one form. The spec sheet opens in
 * a modal. Images are placeholders until the 3D model and renders are made, and the drawn schematic stands in for the
 * 3D sequence. Copy is in src/data/water.ts.
 */
const title = "Whole-House Water Filtration | Cloud Trade";
const description =
  "A three-stage whole-house water filter for the mains supply. Cleaner, better-tasting water from every tap, shower and appliance. Trade pricing for plumbers and builders.";

const specRows = waterModels[0].specs.map((row, index) => ({ label: row.label, values: waterModels.map((model) => model.specs[index].value) }));

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Cloud Trade", item: `${site.url}/trade/` },
      { "@type": "ListItem", position: 2, name: "Water filtration", item: `${site.url}/trade/water-filtration/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: waterFaqs.map((item) => ({ "@type": "Question", name: item.title, acceptedAnswer: { "@type": "Answer", text: item.body } })),
  },
];
---

<RefreshLayout title={title} description={description} canonical="/trade/water-filtration/" structuredData={schemas} brand="trade" overlayHeader>
  <!-- Hero (as the other landing pages): a lifestyle image full bleed under the header, the display line bottom-left
       and the lead and the one main action bottom-right. The image is a placeholder until the render is made. -->
  <section data-hero data-theme="dark" class="relative h-[100svh] min-h-[560px] overflow-hidden">
    <img src="/trade/water/hero.webp" alt="" width="2560" height="1445" fetchpriority="high" decoding="async" class="absolute inset-0 h-full w-full object-cover object-[74%_50%]" />
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(11_11_12/0.55)_0%,rgb(11_11_12/0)_28%,rgb(11_11_12/0)_50%,rgb(11_11_12/0.6)_100%)]" aria-hidden="true"></div>
    <div class="shell relative flex h-full flex-col justify-end pb-10 sm:pb-14">
      <div class="grid-12 items-end gap-y-6">
        <div class="col-span-12 lg:col-span-8">
          <p class="label">{waterHero.byline}</p>
          <h1 class="mt-6 text-hero">{waterHero.title}</h1>
        </div>
        <div class="col-span-12 flex flex-col items-start gap-5 sm:col-span-8 lg:col-span-4 lg:items-end lg:text-right">
          <p class="max-w-[38ch] text-body text-fg/85">{waterHero.lead}</p>
          <a href={waterActions.pricing.href} class="btn">{waterActions.pricing.label}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- At home: what it does for the people who live with it, an image over each (Cloud Homes' card row) -->
  <section id="at-home" data-theme="light" class="scroll-mt-header pb-section pt-section">
    <div class="shell">
      <SectionHead label="At home" title="Better water in every room" rule={false} />
    </div>
    <CardRow label="What it does at home" columns={4} class="mt-10 sm:mt-12">
      {waterBenefits.map((benefit, index) => (
        <li data-reveal style={`--reveal-delay:${index * 80}ms`}>
          <MediaCard image={"image" in benefit ? benefit.image : undefined} width={1280} height={1600} alt="" title={benefit.title} description={benefit.body} size="compact" ratio="aspect-[4/5]" />
        </li>
      ))}
    </CardRow>
  </section>

  <!-- The product (the "what"): a full-height stone stage with the system on the right; the heading at the top of the
       left column and the description and spec sheet action at its foot, as the hero sets its type -->
  <section id="the-system" data-theme="light" class="scroll-mt-header">
    <div class="shell grid min-h-[100svh] grid-cols-12 gap-x-gap-sm gap-y-10 py-section lg:h-[100svh] lg:grid-rows-1 lg:py-gap-sm">
      <div class="water-product relative col-span-12 min-h-[28rem] lg:min-h-0 lg:col-span-7 lg:col-start-6 lg:row-start-1" aria-hidden="true">
        <!-- the system rendered from its model (src/lib/water/system.ts) -->
        <img src="/trade/water/system.webp" alt="" width="1600" height="1600" loading="lazy" decoding="async" class="water-product-img" />
      </div>
      <div class="col-span-12 flex flex-col justify-between gap-10 lg:col-span-4 lg:row-start-1 lg:py-10">
        <div>
          <p class="label">{waterSpotlight.label}</p>
          <h2 class="mt-6 text-h2">{waterSpotlight.title}</h2>
        </div>
        <div>
          <p class="max-w-[40ch] text-body text-fg-muted">{waterSpotlight.body}</p>
          <button type="button" class="btn mt-8" data-spec-sheet-open>{waterActions.specSheet.label}</button>
        </div>
      </div>
    </div>
  </section>

  <WaterSequence
    id="how-it-works"
    label="How it works"
    title="Three stages, one path"
    intro="On its way into the house, the water passes through three cartridges in turn."
    steps={waterSequence}
  />

  <FiltrationExplorer
    id="what-it-takes-out"
    label="Filtration"
    title={waterRemoval.title}
    intro={waterRemoval.intro}
    stages={waterRemoval.stages}
    contaminants={waterRemoval.contaminants}
  />

  <!-- The two models, then their specifications side by side -->
  <section id="models" data-theme="light" class="scroll-mt-header pb-section">
    <div class="shell">
      <SectionHead label="Two models" title="Steel frame or stainless steel">
        <Fragment slot="actions"><button type="button" class="btn" data-spec-sheet-open>{waterActions.specSheet.label}</button></Fragment>
      </SectionHead>
      <ul class="mt-10 grid gap-x-gap-sm gap-y-12 sm:mt-12 md:grid-cols-2">
        {waterModels.map((model, index) => (
          <li data-reveal style={`--reveal-delay:${index * 80}ms`}>
            <MediaCard image={`/trade/water/model-${index ? "cabinet" : "frame"}.webp`} width={1600} height={1200} alt={`The ${model.model}`} meta={model.model} title={model.name} description={model.summary} size="compact" ratio="aspect-[4/3]" />
          </li>
        ))}
      </ul>

      <table class="water-specs mt-16 w-full">
        <caption class="sr-only">Specifications of the two models</caption>
        <thead>
          <tr>
            <th scope="col"><span class="label label-muted">Specifications</span></th>
            {waterModels.map((model) => <th scope="col"><span class="label">{model.model}</span></th>)}
          </tr>
        </thead>
        <tbody>
          {specRows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {row.values.map((value) => <td>{value}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Looking after it: how long the cartridges last, in the stat split from Why Cloud Modular -->
  <SplitSection id="looking-after-it" label={waterCare.label}>
    <p class="text-about">{waterCare.intro}</p>
    <dl class="mt-10 grid w-full grid-cols-2 gap-x-gap-sm">
      {waterCare.stats.map((stat) => (
        <div class="flex flex-col border-t border-line/[var(--rule-alpha)] pt-5">
          <dt class="order-2 mt-3 max-w-[24ch] text-small text-fg-muted">{stat.label}</dt>
          <dd class="order-1 text-h1 tabular-nums">{stat.value}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-10 max-w-measure text-body text-fg-muted">{waterCare.body}</p>
  </SplitSection>

  <SplitSection id="faq" label="Questions">
    <Accordion items={waterFaqs} name="water-faq" />
  </SplitSection>

  <SplitSection id="get-pricing" label="For the trade">
    <h2 class="text-h3">{waterPricing.title}</h2>
    <p class="mt-4 max-w-[52ch] text-body text-fg-muted">{waterPricing.intro}</p>
    <EnquiryForm variant="water" class="mt-10" />
  </SplitSection>

  <SpecSheetModal />
</RefreshLayout>

<style>
  /* Stand-ins until the lifestyle image and the product render are made */
  .water-hero-media {
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(80% 70% at 60% 40%, rgb(64 60 54), rgb(22 21 20));
  }

  .water-product {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-media);
    background: radial-gradient(70% 60% at 50% 55%, rgb(var(--stone)), rgb(var(--stone) / 0.55));
  }

  /* contained in the stage, so the render never pushes the section past the viewport */
  .water-product-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 4%;
    object-fit: contain;
  }

  .water-specs {
    border-collapse: collapse;
    font-size: var(--text-small);
  }

  .water-specs :is(th, td) {
    padding: 1rem 1rem 1rem 0;
    border-bottom: var(--rule) solid rgb(var(--line) / var(--rule-alpha));
    text-align: left;
    vertical-align: top;
    font-weight: var(--weight-regular);
  }

  .water-specs tbody th {
    width: 22%;
    color: rgb(var(--fg-muted));
  }

  .water-specs tbody td {
    width: 39%;
  }

  @media (max-width: 40rem) {
    .water-specs tbody th {
      width: 30%;
    }
  }
</style>
