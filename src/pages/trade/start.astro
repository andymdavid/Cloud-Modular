---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import PageIntro from "@/components/refresh/PageIntro.astro";
import SplitSection from "@/components/refresh/SplitSection.astro";
import EnquiryForm from "@/components/refresh/EnquiryForm.astro";
import { site } from "@/data/site";

/**
 * Cloud Trade, get started: the request form, sent to the team. "Open an account" leads here until the portal's
 * sign-up has an address; then this page offers both routes.
 */
const title = "Get Started | Cloud Trade";
const description = "Tell us what your project needs and the Cloud Trade team will be in touch to talk it through.";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Cloud Trade", item: `${site.url}/trade/` },
    { "@type": "ListItem", position: 2, name: "Get started", item: `${site.url}/trade/start/` },
  ],
};
---

<RefreshLayout title={title} description={description} canonical="/trade/start/" structuredData={breadcrumbSchema} brand="trade">
  <PageIntro label="Get started" title="Tell us what your project needs" lead="Send us the details and our team will be in touch to set up your account and talk through your schedule." />

  <SplitSection id="request" label="Your project">
    <EnquiryForm variant="trade" />
  </SplitSection>
</RefreshLayout>
