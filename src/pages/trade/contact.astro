---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import PageIntro from "@/components/refresh/PageIntro.astro";
import SplitSection from "@/components/refresh/SplitSection.astro";
import EnquiryForm from "@/components/refresh/EnquiryForm.astro";
import { site } from "@/data/site";

/**
 * Cloud Trade, contact: a general message to the team, kept inside Trade. The details stay Cloud Modular's, so
 * the page shows only the form; the enquiry function labels messages from /trade/ pages as Cloud Trade.
 */
const title = "Contact Us | Cloud Trade";
const description = "Send the Cloud Trade team a message and we will get back to you.";
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Cloud Trade", item: `${site.url}/trade/` },
      { "@type": "ListItem", position: 2, name: "Contact", item: `${site.url}/trade/contact/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    url: `${site.url}/trade/contact/`,
    name: "Contact Cloud Trade",
    description,
  },
];
---

<RefreshLayout title={title} description={description} canonical="/trade/contact/" structuredData={schemas} brand="trade">
  <PageIntro label="Contact" title="Get in touch" lead="Send us a message and we will get back to you. If you have a schedule ready, send it with a project request.">
    <a href="/trade/start/" class="btn mt-10">Send us your schedule</a>
  </PageIntro>

  <SplitSection id="send-a-message" label="Send a message">
    <EnquiryForm variant="general" />
  </SplitSection>
</RefreshLayout>
