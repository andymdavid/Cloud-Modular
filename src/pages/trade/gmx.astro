---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import SplitSection from "@/components/refresh/SplitSection.astro";
import SectionHead from "@/components/refresh/SectionHead.astro";
import CardRow from "@/components/refresh/CardRow.astro";
import MediaCard from "@/components/refresh/MediaCard.astro";
import Accordion from "@/components/refresh/Accordion.astro";
import EnquiryForm from "@/components/refresh/EnquiryForm.astro";
import SpecSheetModal from "@/components/water/SpecSheetModal.astro";
import GmxSizer from "@/components/gmx/GmxSizer.astro";
import WaterSequence from "@/components/water/WaterSequence.astro";
import { site } from "@/data/site";
import { gmxActions, gmxAtHome, gmxBenefits, gmxFaqs, gmxHero, gmxModels, gmxPairing, gmxPlacement, gmxPricing, gmxSequence, gmxSpecRows, gmxSpotlight } from "@/data/gmx";

/**
 * GMX magnetic water conditioners, a product page off Cloud Trade in the pattern of the water filtration page. It sells
 * what GMX does at home first, then the product, the four models, where they go and how many a job needs, the pairing
 * with the Cloud filter and the questions people ask, then trade pricing as the one form. The spec sheet opens in a
 * modal. The model images are GMX's product photographs until the three.js renders replace them; the hero and At home
 * images are still to be made. Copy is in src/data/gmx.ts.
 */
const title = "GMX Magnetic Water Conditioners | Cloud Trade";
const description =
  "GMX clamp-on magnetic water conditioners for homes, pools, farms and commercial sites. No salt, no power and no plumbing cut, made in the USA since 1992. Trade pricing for licensed plumbers, builders and pool builders.";

type SpecKey = keyof (typeof gmxModels)[number]["specs"];
const specRows = [
  ...gmxSpecRows.perModel.map((row) => ({ label: row.label, values: gmxModels.map((model) => model.specs[row.key as SpecKey]) })),
  ...gmxSpecRows.shared.map((row) => ({ label: row.label, value: row.value })),
];

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Cloud Trade", item: `${site.url}/trade/` },
      { "@type": "ListItem", position: 2, name: "GMX scale conditioners", item: `${site.url}/trade/gmx/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: gmxFaqs.map((item) => ({ "@type": "Question", name: item.title, acceptedAnswer: { "@type": "Answer", text: item.body } })),
  },
];
---

<RefreshLayout title={title} description={description} canonical="/trade/gmx/" structuredData={schemas} brand="trade" overlayHeader>
  <!-- Hero (as the water page): a lifestyle image full bleed under the header, the display line bottom-left and the
       lead and the one main action bottom-right. -->
  <section data-hero data-theme="dark" class="relative h-[100svh] min-h-[560px] overflow-hidden">
    <img src="/trade/gmx/hero.webp" alt="" width="2560" height="1429" fetchpriority="high" decoding="async" class="absolute inset-0 h-full w-full object-cover object-[60%_50%] max-sm:origin-[47%_100%] max-sm:scale-[1.15] max-sm:object-[47%_50%]" />
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(11_11_12/0.55)_0%,rgb(11_11_12/0)_28%,rgb(11_11_12/0)_50%,rgb(11_11_12/0.6)_100%)]" aria-hidden="true"></div>
    <!-- on phones the image centres on the pour and is enlarged from its foot, lifting the kettle and steam above the text;
         the headline, lead and button stack up from about 40% of the height, so a deeper scrim sits behind them -->
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(11_11_12/0)_25%,rgb(11_11_12/0.45)_45%,rgb(11_11_12/0.75)_100%)] sm:hidden" aria-hidden="true"></div>
    <div class="shell relative flex h-full flex-col justify-end pb-10 sm:pb-14">
      <div class="grid-12 items-end gap-y-6">
        <div class="col-span-12 lg:col-span-8">
          <h1 class="text-hero">{gmxHero.title}</h1>
        </div>
        <div class="col-span-12 flex flex-col items-start gap-5 sm:col-span-8 lg:col-span-4 lg:items-end lg:text-right">
          <p class="max-w-[38ch] text-body text-fg/85">{gmxHero.lead}</p>
          <a href={gmxActions.pricing.href} class="btn">{gmxActions.pricing.label}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- At home: what it does for the people who live with it, each card titled with the benefit -->
  <section id="at-home" data-theme="light" class="scroll-mt-header pb-section pt-section">
    <div class="shell">
      <SectionHead label="At home" title={gmxAtHome.title} intro={gmxAtHome.intro} rule={false} />
    </div>
    <CardRow label="What it does at home" columns={4} class="mt-10 sm:mt-12">
      {gmxBenefits.map((benefit, index) => (
        <li data-reveal style={`--reveal-delay:${index * 80}ms`}>
          <MediaCard image={"image" in benefit ? benefit.image : undefined} width={1280} height={1600} alt="" title={benefit.title} description={benefit.body} size="compact" ratio="aspect-[4/5]" />
        </li>
      ))}
    </CardRow>
  </section>

  <!-- The product: a full-height stone stage with the Model 800 on the right, the heading at the top of the left
       column and the description, facts and spec sheet action at its foot (as the water page's system) -->
  <section id="the-product" data-theme="light" class="scroll-mt-header">
    <div class="shell grid min-h-[100svh] grid-cols-12 gap-x-gap-sm gap-y-10 py-section lg:h-[100svh] lg:grid-rows-1 lg:py-gap-sm">
      <div class="gmx-product relative col-span-12 min-h-[28rem] lg:min-h-0 lg:col-span-7 lg:col-start-6 lg:row-start-1" aria-hidden="true">
        <img src="/trade/gmx/model-800.webp" alt="" width="1200" height="1200" loading="lazy" decoding="async" class="gmx-product-img" />
      </div>
      <div class="col-span-12 flex flex-col justify-between gap-10 lg:col-span-4 lg:row-start-1 lg:py-10">
        <div>
          <p class="label">{gmxSpotlight.label}</p>
          <h2 class="mt-6 text-h2">{gmxSpotlight.title}</h2>
        </div>
        <div>
          <p class="max-w-[40ch] text-body text-fg-muted">{gmxSpotlight.body}</p>
          <dl class="mt-8 grid grid-cols-2 gap-x-gap-sm gap-y-6">
            {gmxSpotlight.facts.map((fact) => (
              <div class="flex flex-col border-t border-line/[var(--rule-alpha)] pt-4">
                <dt class="order-2 mt-2 text-small text-fg-muted [text-wrap:pretty]">{fact.label}</dt>
                <dd class="order-1 text-lead">{fact.value}</dd>
              </div>
            ))}
          </dl>
          <button type="button" class="btn mt-8" data-spec-sheet-open>{gmxActions.specSheet.label}</button>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works: the steps beside a live three.js scene of three Model 800s on a copper main
       (src/lib/gmx/scene.ts), its view following the step in the middle of the page -->
  <WaterSequence id="how-it-works" label="How it works" title="What happens in the pipe" intro="Follow the water through a set of three Model 800s on a copper main." steps={gmxSequence}>
    <div slot="stage" class="relative h-full w-full" data-gmx-scene><canvas class="absolute inset-0 h-full w-full [mask-image:linear-gradient(90deg,transparent,#000_12%,#000_88%,transparent)]"></canvas></div>
  </WaterSequence>

  <!-- The range: the four models, then their specifications side by side -->
  <section id="models" data-theme="light" class="scroll-mt-header pb-section">
    <div class="shell">
      <SectionHead label="The range" title="A model for every pipe">
        <Fragment slot="actions"><button type="button" class="btn" data-spec-sheet-open>{gmxActions.specSheet.label}</button></Fragment>
      </SectionHead>
      <ul class="mt-10 grid gap-x-gap-sm gap-y-12 sm:mt-12 sm:grid-cols-2 lg:grid-cols-4">
        {gmxModels.map((model, index) => (
          <li data-reveal style={`--reveal-delay:${index * 80}ms`}>
            <MediaCard image={model.image} altImage={model.inside} altImageAlt={`Inside the GMX ${model.model}, showing its magnets`} width={1200} height={1200} alt={`The GMX ${model.model}`} meta={model.model} title={model.name} description={model.summary} size="compact" ratio="aspect-square" />
          </li>
        ))}
      </ul>

      <div class="mt-16 overflow-x-auto">
        <table class="gmx-specs w-full min-w-[44rem]">
          <caption class="sr-only">Specifications of the four models</caption>
          <thead>
            <tr>
              <th scope="col"><span class="label label-muted">Specifications</span></th>
              {gmxModels.map((model) => <th scope="col"><span class="label">{model.model}</span></th>)}
            </tr>
          </thead>
          <tbody>
            {specRows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {"values" in row ? row.values.map((value) => <td>{value}</td>) : <td colspan={gmxModels.length}>{row.value}</td>}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Where it goes: GMX's placement rules as four steps (the three.js placement sequence replaces this later) -->
  <section id="where-it-goes" data-theme="light" class="scroll-mt-header pb-section">
    <div class="shell">
      <SectionHead label="Where it goes" title="Fitted where it counts" intro="A whole-house set goes on the main as it comes into the home, with more on the hot water outlet and at the appliances that need it." />
      <ol class="mt-12 grid gap-x-gap-sm gap-y-10 sm:mt-16 sm:grid-cols-2 lg:grid-cols-4">
        {gmxPlacement.map((step, index) => (
          <li class="border-t border-line/[var(--rule-alpha)] pt-5" data-reveal style={`--reveal-delay:${index * 80}ms`}>
            <p class="label label-muted">{step.label}</p>
            <h3 class="mt-6 text-lead">{step.title}</h3>
            <p class="mt-3 text-body text-fg-muted">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <SplitSection id="which-model" label="Which model">
    <h2 class="text-h3">Find the right set for the job</h2>
    <p class="mt-4 max-w-[52ch] text-body text-fg-muted">Choose what you are protecting and the size of the pipe, and you will see the model and how many units GMX recommends.</p>
    <div class="mt-10 w-full"><GmxSizer /></div>
  </SplitSection>

  <SplitSection id="with-filtration" label={gmxPairing.label}>
    <h2 class="text-h3">{gmxPairing.title}</h2>
    <p class="mt-4 max-w-[52ch] text-body text-fg-muted">{gmxPairing.body}</p>
    <div class="mt-10 w-full max-w-[28rem]">
      <MediaCard image={gmxPairing.link.image} width={1600} height={1600} alt="The Cloud whole-house water filter" href={gmxPairing.link.href} meta="Cloud Trade" title={gmxPairing.link.label} size="compact" ratio="aspect-square" />
    </div>
  </SplitSection>

  <SplitSection id="faq" label="Questions">
    <Accordion items={gmxFaqs} name="gmx-faq" />
  </SplitSection>

  <SplitSection id="get-pricing" label="For the trade">
    <h2 class="text-h3">{gmxPricing.title}</h2>
    <p class="mt-4 max-w-[52ch] text-body text-fg-muted">{gmxPricing.intro}</p>
    <EnquiryForm variant="gmx" class="mt-10" />
  </SplitSection>

  <SpecSheetModal product="gmx" />
</RefreshLayout>

<style>
  .gmx-product {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-media);
    background: rgb(var(--stone));
    overflow: hidden;
  }

  /* contained in the stage, so the photograph never pushes the section past the viewport */
  .gmx-product-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 6%;
    object-fit: contain;
  }

  .gmx-specs {
    border-collapse: collapse;
    font-size: var(--text-small);
  }

  .gmx-specs :is(th, td) {
    padding: 1rem 1rem 1rem 0;
    border-bottom: var(--rule) solid rgb(var(--line) / var(--rule-alpha));
    text-align: left;
    vertical-align: top;
    font-weight: var(--weight-regular);
  }

  .gmx-specs tbody th {
    width: 16%;
    color: rgb(var(--fg-muted));
  }

  .gmx-specs tbody td {
    width: 21%;
  }
</style>

<script>
  import { mountGmxScene } from "@/lib/gmx/scene";

  // Start the scene when the section nears the screen, run it only while it is in view, and follow the steps
  const host = document.querySelector<HTMLElement>("[data-gmx-scene]");
  const section = host?.closest<HTMLElement>("[data-water-sequence]");
  if (host && section) {
    let scene: ReturnType<typeof mountGmxScene> | undefined;
    let stage = 0;
    section.addEventListener("sequencestage", (event) => {
      stage = (event as CustomEvent<number>).detail;
      scene?.setStage(stage);
    });
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !scene) {
          scene = mountGmxScene(host.querySelector("canvas")!);
          scene.setStage(stage);
        }
        scene?.setRunning(entry.isIntersecting);
      },
      { rootMargin: "200px 0px" },
    ).observe(host);
  }
</script>
