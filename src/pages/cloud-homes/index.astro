---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import PageIntro from "@/components/refresh/PageIntro.astro";
import SplitSection from "@/components/refresh/SplitSection.astro";
import SectionHead from "@/components/refresh/SectionHead.astro";
import CardRow from "@/components/refresh/CardRow.astro";
import MediaCard from "@/components/refresh/MediaCard.astro";
import FaqSection from "@/components/refresh/FaqSection.astro";
import ProjectGallery from "@/components/refresh/ProjectGallery.astro";
import ImagePanel from "@/components/refresh/ImagePanel.astro";
import Accordion from "@/components/refresh/Accordion.astro";
import type { GalleryRow } from "@/data/projects";
import { cloudHomes, extras, formatPrice, homeSteps, included } from "@/data/cloud-homes";
import { faqItems, projects, site } from "@/data/site";

/**
 * Cloud Homes (cf. samara.com/adus): the product page in front of the "Design yours" tool. The three homes, what
 * they are for, what comes with them, the live 2 Bed in 3D, how buying one works, the from price and the questions
 * people ask. The images are renders from the same 3D models as the tool, as no Cloud Home has been photographed yet.
 * Prices are the placeholders in src/data/cloud-homes.ts.
 */

const title = "Cloud Homes | 1, 2 and 4 Bedroom Modular Homes | Cloud Modular";
const description =
  "Cloud Homes are one, two and four bedroom modular homes, designed by Cloud Modular, built in our manufacturing facility and delivered across Australia.";

const homeFaqs = faqItems.filter((item) => item.topic === "cloud-homes" || (item as { alsoOn?: readonly string[] }).alsoOn?.includes("cloud-homes"));
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url },
      { "@type": "ListItem", position: 2, name: "Cloud Homes", item: `${site.url}/cloud-homes/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: homeFaqs.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];

// One render per home, in the tool's default finish
const homeImages = {
  "one-bed": { alt: "Render of the 1 Bed Cloud Home in white fibre cement panels, with solar panels and a covered deck at the entry" },
  "two-bed": { alt: "Render of the 2 Bed Cloud Home in white fibre cement panels, with solar panels and a covered deck at the entry" },
  "four-bed": { alt: "Render of the two-storey 4 Bed Cloud Home in white fibre cement panels, with solar panels and a covered deck at the entry" },
} as const;

const uses = [
  { title: "Family close by", body: "A 1 or 2 Bed in the backyard gives parents, grown children or a carer a home of their own nearby." },
  { title: "Rental income", body: "A second home on your block can be rented out, where your council allows it." },
  { title: "Room to work", body: "A quiet studio or office away from the main house." },
  { title: "A full home", body: "The 4 Bed is a two-storey family home for a new block, a knockdown or a regional site." },
];

// Placeholders for the images still to be made; each says what it will show
const placeholder = (slug: string, caption: string, width: number, height: number) => ({
  src: `/cloud-homes/placeholders/${slug}.webp`,
  alt: `Placeholder for an image of ${caption.toLowerCase()}`,
  width,
  height,
  caption,
});
const gallery: GalleryRow[] = [
  { kind: "full", image: placeholder("backyard", "A 2 Bed in a backyard", 2400, 1350) },
  { kind: "pair", images: [placeholder("living", "Living and kitchen", 1600, 1000), placeholder("bedroom", "Main bedroom", 1000, 1250)] },
  { kind: "full", image: placeholder("deck", "The deck at dusk", 2400, 1350) },
];

const fromPrice = Math.min(...cloudHomes.map((home) => home.fromPrice));
const shownProjects = projects.slice(0, 3);
---

<RefreshLayout title={title} description={description} canonical="/cloud-homes/" structuredData={schemas}>
  <!-- On phones the intro and the render under it fill the first screen -->
  <div class="intro-screen">
    <PageIntro label="Cloud Homes" title="A home of your own, built for your site" lead="One, two and four bedroom homes, designed by Cloud Modular, built in our manufacturing facility and delivered across Australia.">
      <div class="mt-10 flex flex-wrap justify-center gap-1">
        <a href="/cloud-homes/design/" class="btn">Design yours</a>
        <a href="#homes" class="btn">See the homes</a>
      </div>
    </PageIntro>

    <div class="wide-row intro-grow" data-reveal>
      <div class="intro-frame stage-frame aspect-[4/3] overflow-hidden rounded sm:aspect-[16/9]">
        <img src="/cloud-homes/two-bed-wide.webp" alt="Render of the 2 Bed Cloud Home in white fibre cement panels, with solar panels and a covered deck at the entry" width="2400" height="1350" fetchpriority="high" class="h-full w-full object-cover" />
      </div>
    </div>
  </div>

  <SplitSection id="about" label="Everything taken care of">
    <p class="text-about">We look after your home from design and approvals through to manufacture, delivery and installation. You choose the home and its finishes, and we bring it to your site ready to move in.</p>
  </SplitSection>

  <!-- The three homes, each opening the design tool with that home chosen -->
  <section id="homes" data-theme="light" class="scroll-mt-header pb-section">
    <div class="shell">
      <SectionHead label="The homes" title="Choose your home">
        <a slot="actions" href="/cloud-homes/design/" class="btn">Design yours</a>
      </SectionHead>
    </div>

    <CardRow label="Cloud Homes" class="mt-12 sm:mt-16">
      {cloudHomes.map((home, index) => (
        <li data-reveal style={`--reveal-delay:${index * 80}ms`}>
          <MediaCard
            href={`/cloud-homes/design/?home=${home.id}`}
            image={`/cloud-homes/${home.id}.webp`}
            alt={homeImages[home.id].alt}
            width={1000}
            height={1250}
            meta={`${home.houseArea} m² · from ${formatPrice(home.fromPrice)}`}
            title={home.name}
            description={`${home.rooms[0].toUpperCase()}${home.rooms.slice(1)}.`}
            size="compact"
            ratio="aspect-[4/5] lg:aspect-[13/15]"
          />
        </li>
      ))}
    </CardRow>
  </section>

  <ProjectGallery rows={gallery} />

  <!-- The homes in use: a placeholder image to be made, and the four uses on the slate panel -->
  <ImagePanel id="uses" label="Ways to use it" title="Live in it, share it or rent it out" image="/cloud-homes/placeholders/uses.webp" alt="Placeholder for an image of living in a Cloud Home" width={1600} height={1800}>
    <Accordion items={uses} name="uses" openFirst />
  </ImagePanel>

  <SplitSection id="included" label="What's included" rule={false}>
    <p class="text-about">Every Cloud Home comes with these as standard, and you choose its cladding, colours, roof, window frames, deck, floors and kitchen.</p>
    <div class="mt-10 grid gap-x-gap-sm gap-y-10 sm:grid-cols-2">
      <div>
        <h3 class="label label-muted">Standard</h3>
        <ul class="mt-4">
          {included.map((item) => <li class="border-t border-line/[var(--rule-alpha)] py-3 text-body">{item}</li>)}
        </ul>
      </div>
      <div>
        <h3 class="label label-muted">Options and extras</h3>
        <ul class="mt-4">
          <li class="border-t border-line/[var(--rule-alpha)] py-3 text-body">Solar panels</li>
          <li class="border-t border-line/[var(--rule-alpha)] py-3 text-body">Home battery</li>
          {extras.items.map((item) => <li class="border-t border-line/[var(--rule-alpha)] py-3 text-body">{item.name}</li>)}
        </ul>
      </div>
    </div>
  </SplitSection>

  <!-- Peek inside: the 2 Bed live in 3D, from outside or with the roof lifted. Loads as it nears the viewport. -->
  <section id="inside" data-theme="light" class="scroll-mt-header pb-section">
    <div class="shell">
      <SectionHead label="Peek inside" title="Look around the 2 Bed" intro="Drag to turn the home, or lift the roof to see the kitchen, bedrooms and bathroom.">
        <a slot="actions" href="/cloud-homes/design/" class="btn">Design yours</a>
      </SectionHead>
    </div>

    <div class="wide-row mt-12 sm:mt-16" data-reveal>
      <div class="stage-frame relative aspect-[4/3] overflow-hidden rounded sm:aspect-[16/9]" data-peek>
        <img src="/cloud-homes/two-bed-wide.webp" alt="" width="2400" height="1350" loading="lazy" class="absolute inset-0 h-full w-full object-cover" data-peek-still />
        <div class="absolute inset-0" data-peek-host></div>
        <div class="peek-views" role="group" aria-label="View" hidden data-peek-views>
          <button type="button" class="peek-view" aria-pressed="true" data-view="outside">Outside</button>
          <button type="button" class="peek-view" aria-pressed="false" data-view="inside">Inside</button>
        </div>
      </div>
    </div>
  </section>

  <SplitSection id="how-it-works" label="How it works">
    <ol class="grid gap-8">
      {homeSteps.map((step, index) => (
        <li class="grid grid-cols-[3rem_1fr] gap-x-2 border-t border-line/[var(--rule-alpha)] pt-5">
          <span class="label label-muted pt-1">{String(index + 1).padStart(2, "0")}</span>
          <span>
            <span class="block text-lead">{step.title}</span>
            <span class="mt-2 block text-body text-fg-muted">{step.body}</span>
          </span>
        </li>
      ))}
    </ol>
    <a href="/our-approach/" class="btn mt-10">Our approach</a>
  </SplitSection>

  <SplitSection id="pricing" label="Pricing">
    <p class="text-h1 tabular-nums">From {formatPrice(fromPrice)}</p>
    <dl class="mt-10 w-full">
      {cloudHomes.map((home) => (
        <div class="flex justify-between gap-6 border-t border-line/[var(--rule-alpha)] py-3 text-body">
          <dt>{home.name}</dt>
          <dd class="tabular-nums">From {formatPrice(home.fromPrice)}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-8 max-w-measure text-body text-fg-muted">Delivery, site works and any extras depend on your site and your choices. Send us your design and your site address, and your proposal sets out the full price.</p>
    <a href="/cloud-homes/design/" class="btn mt-10">Design yours</a>
  </SplitSection>

  <!-- Our work: the same projects as the home page, built by the same team -->
  <section id="work" data-theme="light" class="scroll-mt-header pb-section">
    <div class="shell">
      <SectionHead label="Our work" title="Built by Cloud Modular" intro="Cloud Homes are made in the same manufacturing facility, and delivered by the same team, as our other homes and buildings.">
        <a slot="actions" href="/our-work/" class="btn">All projects</a>
      </SectionHead>
    </div>

    <CardRow label="Projects" class="mt-12 sm:mt-16">
      {shownProjects.map((project, index) => (
        <li data-reveal style={`--reveal-delay:${index * 80}ms`}>
          <MediaCard
            href={`/our-work/${project.slug}/`}
            image={project.image}
            alt={project.imageAlt}
            imagePosition={project.imagePosition}
            tag={project.sector}
            meta={project.location}
            title={project.name}
            ratio="aspect-[4/5] lg:aspect-[13/15]"
          />
        </li>
      ))}
    </CardRow>
  </section>

  <FaqSection id="faq" topic="cloud-homes" />

  <SplitSection id="get-started" label="Get started">
    <p class="text-about">Design your Cloud Home in a few minutes, or talk to us about your site.</p>
    <div class="mt-10 flex flex-wrap gap-1">
      <a href="/cloud-homes/design/" class="btn">Design yours</a>
      <a href={site.contactHref} class="btn">Talk to us</a>
    </div>
  </SplitSection>
</RefreshLayout>

<style>
  /* Matches STAGE_BACKGROUND in src/lib/explorer/cloud-home-design.ts, which the renders and the 3D sit on */
  .stage-frame {
    background: #f2f1ec;
  }

  .peek-views {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 999px;
    background: rgb(var(--surface) / 0.9);
    transform: translateX(-50%);
  }

  .peek-views[hidden] {
    display: none;
  }

  .peek-view {
    height: 2.25rem;
    padding-inline: 1rem;
    border-radius: 999px;
    font-size: var(--text-small);
    transition: background-color var(--dur-base) var(--ease-standard);
  }

  .peek-view[aria-pressed="true"] {
    background: rgb(var(--fg));
    color: rgb(var(--surface));
  }
</style>

<script>
  import { homeCamera, modelState, readDesign } from "@/data/cloud-homes";

  const frame = document.querySelector<HTMLElement>("[data-peek]")!;
  const host = frame.querySelector<HTMLElement>("[data-peek-host]")!;
  const still = frame.querySelector<HTMLElement>("[data-peek-still]")!;
  const views = frame.querySelector<HTMLElement>("[data-peek-views]")!;

  // The tool's default finish, as the render it replaces
  const design = readDesign(new URLSearchParams("home=two-bed"));
  const cameras = {
    outside: homeCamera,
    inside: { azimuth: 30, polar: 38, inside: true },
  };

  const load = () =>
    import("@/lib/explorer/cloud-home-design").then(({ createDesignViewer }) => {
      const viewer = createDesignViewer({
        host,
        home: design.home.id,
        state: modelState(design),
        view: cameras.outside,
        reducedMotion: window.matchMedia("(prefers-reduced-motion: reduce)").matches,
        onError: () => {
          host.hidden = true;
          views.hidden = true;
          still.hidden = false;
        },
      });
      still.hidden = true;
      views.hidden = false;
      views.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-view]");
        if (!button) return;
        for (const other of views.querySelectorAll("[data-view]")) other.setAttribute("aria-pressed", String(other === button));
        viewer.show(cameras[button.dataset.view as keyof typeof cameras]);
      });
    });

  // three.js loads only as the section nears the viewport
  const observer = new IntersectionObserver(
    (entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      load().catch(() => {});
    },
    { rootMargin: "400px 0px" },
  );
  observer.observe(frame);
</script>
