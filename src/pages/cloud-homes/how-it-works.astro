---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import PageIntro from "@/components/refresh/PageIntro.astro";
import SectionHead from "@/components/refresh/SectionHead.astro";
import FaqSection from "@/components/refresh/FaqSection.astro";
import GetStarted from "@/components/refresh/GetStarted.astro";
import Journey from "@/components/refresh/Journey.astro";
import { homeJourney, sections, type JourneyItem } from "@/data/cloud-homes";
import { site } from "@/data/site";

/**
 * Cloud Homes, how it works (cf. samara.com/adus/how-it-works): the journey from a design to the keys, drawn by the
 * shared Journey component, with the crane day as its one giant word. Then a full-bleed welcome, the questions and Get started.
 * Every step restates the published process (homeJourney in src/data/cloud-homes.ts).
 */

const title = "How It Works | Cloud Homes | Cloud Modular";
const description = "How buying a Cloud Home works, from designing it in 3D to the site review, approvals, manufacture, delivery by crane and the day you get the keys.";
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url },
      { "@type": "ListItem", position: 2, name: "Cloud Homes", item: `${site.url}/cloud-homes/` },
      { "@type": "ListItem", position: 3, name: "How it works", item: `${site.url}/cloud-homes/how-it-works/` },
    ],
  },
];

// The demo's swatches: the tool's cladding colours
const colours = sections.find((section) => section.id === "colour")!;
// The Design yours step shows the 2 Bed live in 3D in place of its render
const demoItem = homeJourney.find((item) => item.kind === "step" && item.demo) as Extract<JourneyItem, { kind: "step" }>;
---

<RefreshLayout title={title} description={description} canonical="/cloud-homes/how-it-works/" structuredData={schemas}>
  <!-- On phones the intro and the image under it fill the first screen -->
  <div class="intro-screen mb-section">
    <PageIntro label="Cloud Homes" title="How it works" lead="Getting a Cloud Home is simple. We look after the build, and you decide how to use it.">
      <a href="/cloud-homes/design/" class="btn mt-10">Design yours</a>
    </PageIntro>

    <div class="wide-row intro-grow" data-reveal>
      <div class="intro-frame aspect-[4/3] overflow-hidden rounded bg-stone sm:aspect-[21/9]">
        <img src="/cloud-homes/generated/deck.webp" alt="A father on the deck of a Cloud Home 2 Bed at dusk as his daughter shows him a gum leaf, with the living room glowing behind the sliding door" width="2560" height="1429" fetchpriority="high" class="h-full w-full object-cover" style="object-position:62% 60%" />
      </div>
    </div>
  </div>

  <!-- The journey: one line down the page, drawn as it scrolls -->
  <section id="journey" data-theme="light" class="scroll-mt-header pb-section">
    <div class="shell">
      <SectionHead label="The journey" title="From your design to your keys" align="center" />

      <Journey class="mt-section" items={homeJourney}>
        {(item: JourneyItem) => "demo" in item && item.demo && (
        <div class="j-demo" data-demo>
          <img src={demoItem.image!.src} alt={demoItem.image!.alt} width={demoItem.image!.width} height={demoItem.image!.height} loading="lazy" class="absolute inset-0 h-full w-full object-cover" data-demo-still />
          <div class="absolute inset-0" data-demo-host></div>
          <fieldset class="j-demo-picker" hidden data-demo-picker>
            <legend class="sr-only">Try a cladding colour</legend>
            <div class="flex gap-1.5">
              {colours.choices.map((choice, index) => (
                <label class="j-swatch" title={choice.name}>
                  <input type="radio" name="demo-colour" value={choice.id} checked={index === 0} class="sr-only" />
                  <span class="j-swatch-chip" style={`background:${choice.swatch}`} aria-hidden="true"></span>
                  <span class="sr-only">{choice.name}</span>
                </label>
              ))}
            </div>
            <span class="j-demo-name text-small" data-demo-name aria-live="polite">{colours.choices[0].name}</span>
          </fieldset>
        </div>
        )}
      </Journey>
    </div>
  </section>

  <!-- Welcome: the end of the line, full bleed -->
  <section data-theme="dark" class="relative h-[90svh] min-h-[520px] overflow-hidden">
    <img src="/cloud-homes/generated/living.webp" alt="The living room and kitchen of a Cloud Home 2 Bed in warm evening light" width="2560" height="1717" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(11_11_12/0)_45%,rgb(11_11_12/0.6)_100%)]" aria-hidden="true"></div>
    <div class="shell relative flex h-full flex-col justify-end pb-10 sm:pb-14">
      <div class="grid-12 items-end gap-y-6">
        <h2 class="col-span-12 text-hero lg:col-span-8" data-reveal>Welcome home</h2>
        <div class="col-span-12 flex flex-col items-start gap-5 sm:col-span-8 lg:col-span-4 lg:items-end lg:text-right" data-reveal>
          <p class="max-w-[34ch] text-body text-fg/85">We hand over the keys, manuals and warranties, and your home is ready to live in.</p>
          <a href="/cloud-homes/design/" class="btn">Design yours</a>
        </div>
      </div>
    </div>
  </section>

  <FaqSection id="faq" topic="cloud-homes" rule={false} />

  <GetStarted />
</RefreshLayout>

<style>
  /* The live 2 Bed: the tool's stage colour, the swatches in a pill along the bottom */
  .j-demo {
    position: relative;
    aspect-ratio: 1;
    background: #f2f1ec; /* STAGE_BACKGROUND in src/lib/explorer/cloud-home-design.ts */
  }

  @media (min-width: 48rem) {
    .j-demo {
      aspect-ratio: 4 / 3;
    }
  }

  .j-demo-picker {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.3125rem 0.875rem 0.3125rem 0.3125rem;
    border-radius: 999px;
    background: rgb(var(--surface) / 0.92);
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .j-demo-picker[hidden] {
    display: none;
  }

  .j-swatch {
    display: block;
    padding: 2px;
    border: 1px solid transparent;
    border-radius: 999px;
    cursor: pointer;
  }

  .j-swatch:has(input:checked) {
    border-color: rgb(var(--fg));
  }

  .j-swatch:has(input:focus-visible) {
    outline: 1px solid rgb(var(--fg));
    outline-offset: 2px;
  }

  .j-swatch-chip {
    display: block;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
  }

  .j-demo-name {
    min-width: 6.5rem;
  }

</style>

<script>
  import { modelState, readDesign } from "@/data/cloud-homes";

  // The Design yours step: the 2 Bed live in 3D once it nears the screen, repainted as a cladding colour is picked.
  // Nothing is kept; the render stays if the 3D can't load.
  document.querySelectorAll<HTMLElement>("[data-demo]").forEach((frame) => {
    const host = frame.querySelector<HTMLElement>("[data-demo-host]")!;
    const still = frame.querySelector<HTMLElement>("[data-demo-still]")!;
    const picker = frame.querySelector<HTMLFieldSetElement>("[data-demo-picker]")!;
    const name = frame.querySelector<HTMLElement>("[data-demo-name]")!;
    const design = (colour: string) => readDesign(new URLSearchParams({ home: "two-bed", colour }));

    const load = () =>
      import("@/lib/explorer/cloud-home-design").then(({ createDesignViewer }) => {
        const start = design(picker.querySelector<HTMLInputElement>("input:checked")!.value);
        const viewer = createDesignViewer({
          host,
          home: start.home.id,
          state: modelState(start),
          view: { azimuth: 30, polar: 77 },
          reducedMotion: window.matchMedia("(prefers-reduced-motion: reduce)").matches,
          onError: () => {
            host.hidden = true;
            picker.hidden = true;
            still.hidden = false;
          },
        });
        still.hidden = true;
        picker.hidden = false;
        picker.addEventListener("change", (event) => {
          const input = event.target as HTMLInputElement;
          name.textContent = input.closest("label")!.title;
          viewer.update(modelState(design(input.value)));
        });
      });

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        load().catch(() => {});
      },
      { rootMargin: "400px 0px" },
    );
    observer.observe(frame);
  });
</script>
