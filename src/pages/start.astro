---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import PageIntro from "@/components/refresh/PageIntro.astro";
import CardRow from "@/components/refresh/CardRow.astro";
import MediaCard from "@/components/refresh/MediaCard.astro";
import { site } from "@/data/site";

/** Get started (cf. samara.com/start): one page that sends each visitor down the route that suits them. */

const title = "Get Started | Cloud Modular";
const description = "Design a Cloud Home for your site, bring us a project, or ask us a question.";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    { "@type": "ListItem", position: 2, name: "Get started", item: `${site.url}/start/` },
  ],
};

const routes = [
  {
    href: "/cloud-homes/design/",
    image: "/projects/seashells-jurien-bay/street.webp",
    alt: "A modular residence at Seashells Jurien Bay with a timber-framed verandah and planted front garden",
    width: 1672,
    height: 941,
    imagePosition: "52% center",
    meta: "1, 2 and 4 bedroom homes",
    title: "Design Your Cloud Home",
    description: "Choose a home and its finishes in 3D, then send us your design and we will come back with a proposal for your site.",
  },
  {
    href: "/partner-with-us/",
    image: "/Resi.webp",
    alt: "A multi-residential building with planted balconies against the sky",
    width: 928,
    height: 1232,
    imagePosition: "center",
    meta: "Developers, builders and consultants",
    title: "Partner on a project",
    description: "Bring us a development, a tender or a design, and we will talk through how modular can deliver it.",
  },
  {
    href: site.contactHref,
    image: "/office.webp",
    alt: "A commercial building",
    width: 928,
    height: 1232,
    imagePosition: "center",
    meta: "Anything else",
    title: "Ask us a question",
    description: "Send us a message about anything else, and we will get back to you.",
  },
];
---

<RefreshLayout title={title} description={description} canonical="/start/" structuredData={breadcrumbSchema}>
  <PageIntro label="Get started" title="Where would you like to start?" lead="Design a home for your site, bring us a project, or ask us anything." />

  <section id="routes" data-theme="light" class="pb-section">
    <CardRow label="Ways to get started">
      {routes.map((route, index) => (
        <li data-reveal style={`--reveal-delay:${index * 80}ms`}>
          <MediaCard {...route} size="compact" />
        </li>
      ))}
    </CardRow>
  </section>
</RefreshLayout>
