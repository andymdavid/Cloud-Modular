---
import RefreshLayout from "@/layouts/RefreshLayout.astro";
import PageIntro from "@/components/refresh/PageIntro.astro";
import SectionHead from "@/components/refresh/SectionHead.astro";
import CardRow from "@/components/refresh/CardRow.astro";
import MediaCard from "@/components/refresh/MediaCard.astro";
import GetStarted from "@/components/refresh/GetStarted.astro";
import { projects, site } from "@/data/site";

const title = "Projects | Modular Construction Case Studies Perth";
const description = "Explore Cloud Modular's prefabricated building projects across Western Australia.";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    { "@type": "ListItem", position: 2, name: "Projects", item: `${site.url}/our-work/` },
  ],
};
---

<RefreshLayout title={title} description={description} canonical="/our-work/" structuredData={breadcrumbSchema}>
  <!-- On phones the intro and the featured video under it fill the first screen -->
  <div class="intro-screen mb-section">
    <PageIntro label="Our work" title="Selected work" lead={description} />

    <!-- Featured project: the Seashells Jurien Bay aerial in a wide row, playing once when half in view -->
    <section data-theme="light" class="intro-grow" aria-label="Seashells Jurien Bay">
      <div class="wide-row intro-grow" data-reveal>
        <div data-theme="dark" class="intro-frame relative aspect-[4/5] overflow-hidden rounded bg-stone sm:aspect-[16/9]">
          <video
            src="/projects/jurien-bay-drone.mp4"
            poster="/projects/jurien-bay-drone-start.webp"
            data-end-poster="/projects/jurien-bay-drone-end.webp"
            width="1284"
            height="716"
            muted
            playsinline
            preload="none"
            aria-label="Aerial flyover of the Seashells Jurien Bay development beside the coast"
            data-play-once
            class="h-full w-full object-cover"
          ></video>
          <span class="absolute inset-x-0 top-0 h-24 bg-[linear-gradient(180deg,rgb(11_11_12/0.35),rgb(11_11_12/0))]" aria-hidden="true"></span>
          <p class="label absolute left-4 top-4 text-fg sm:left-5 sm:top-5">Seashells Jurien Bay</p>
        </div>
      </div>
    </section>
  </div>

  <!-- All projects: the same cards as the home page (each links to its project page) -->
  <section id="projects" data-theme="light" class="scroll-mt-header pb-section">
    <div class="shell">
      <SectionHead label="Projects" title="Across Western Australia" />
    </div>
    <CardRow label="Projects" class="mt-12 sm:mt-16">
      {projects.map((project, index) => (
        <li data-reveal style={`--reveal-delay:${index * 80}ms`}>
          <MediaCard
            href={`/our-work/${project.slug}/`}
            image={project.image}
            alt={project.imageAlt}
            imagePosition={project.imagePosition}
            tag={project.sector}
            meta={project.location}
            title={project.name}
            ratio="aspect-[4/5] lg:aspect-[13/15]"
          />
        </li>
      ))}
    </CardRow>
  </section>

  <GetStarted />
</RefreshLayout>

<script>
  // Play-once video: start loading as it approaches, play once when half in view, then hold the final frame.
  // Reduced motion shows the final frame as a still and never plays.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLVideoElement>("[data-play-once]").forEach((video) => {
    if (reduceMotion) {
      if (video.dataset.endPoster) video.poster = video.dataset.endPoster;
      return;
    }
    // Separate observers: a root margin also inflates intersectionRatio, so it can't gate playback
    const preload = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        video.preload = "auto";
        preload.disconnect();
      },
      { rootMargin: "50% 0px" },
    );
    const play = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        video.play().catch(() => {});
        play.disconnect();
      },
      { threshold: 0.5 },
    );
    preload.observe(video);
    play.observe(video);
  });
</script>
