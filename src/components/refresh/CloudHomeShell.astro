---
/**
 * Two-part screen for the Cloud Homes pages (cf. samara.com/adus/configure): the 3D home on the left, sticky beside
 * the panel on large screens and pinned above it on phones, and the panel (the slot) on the right. The stage carries
 * the price pill and, with `arrows`, previous and next buttons that step through the panel's [data-step] sections.
 * The page's own script mounts the viewer into [data-canvas-host].
 *
 * With `snap` (the design page, as the original cloud-configurator) the screen is exactly one viewport tall and the
 * panel is its own scroller: each [data-step] section fills it, centred, and scrolling snaps one section at a time,
 * with a rail of dots ([data-dots], filled by the page's script) on its right edge.
 */
import { cloudHomes, defaultHome, formatPrice } from "@/data/cloud-homes";

interface Props {
  arrows?: boolean;
  snap?: boolean;
}

const { arrows = false, snap = false } = Astro.props;
const home = cloudHomes.find((h) => h.id === defaultHome)!;
---

<div class:list={["cloud-shell", { "cloud-shell--snap": snap }]} data-cloud-shell>
  <div class="cloud-stage" data-theme="light">
    <div class="cloud-canvas" data-canvas-host></div>
    <p class="cloud-status text-body text-fg-muted" data-status>Loading your home</p>
    {arrows && (
      <Fragment>
        <button type="button" class="cloud-arrow left-4 lg:left-6" data-step-prev aria-label="Previous section">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.4" /></svg>
        </button>
        <button type="button" class="cloud-arrow right-4 lg:right-6" data-step-next aria-label="Next section">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m6 3 5 5-5 5" stroke="currentColor" stroke-width="1.4" /></svg>
        </button>
      </Fragment>
    )}
    <div class="cloud-foot">
      <p class="cloud-pill">
        <span data-pill-name>{home.name}</span>
        <span class="text-fg-muted">from</span>
        <span data-pill-price>{formatPrice(home.fromPrice)}</span>
      </p>
      <p class="mt-2 hidden text-caption text-fg-subtle lg:block">Drag to turn your home</p>
    </div>
  </div>

  <div class="cloud-panel-wrap">
    <div class="cloud-panel no-scrollbar" data-panel>
      <slot />
    </div>
    {snap && <nav class="cloud-dots" data-dots aria-label="Sections"></nav>}
  </div>
</div>

<style>
  /* Snap mode: one viewport, no page scroll; the panel scrolls and snaps a section at a time */
  .cloud-shell--snap {
    /* The panel's height, which each section fills: half the screen under the home on phones, all of it beside */
    --panel-h: 50dvh;
    height: 100dvh;
    overflow: hidden;
    grid-template-rows: 50% 50%;
  }

  .cloud-shell--snap .cloud-stage {
    position: relative;
    height: 100%;
  }

  .cloud-panel-wrap {
    position: relative;
    min-height: 0;
  }

  .cloud-shell--snap .cloud-panel {
    position: relative; /* sections measure their offsets from the panel */
    height: 100%;
    padding-bottom: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
  }

  /* Phones: room on the right for the dots */
  @media (max-width: 63.999rem) {
    .cloud-shell--snap .cloud-panel {
      padding-right: calc(var(--gutter) + 1rem);
    }
  }

  .cloud-dots {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transform: translateY(-50%);
  }

  .cloud-dots :global(button) {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 999px;
    background: rgb(var(--fg) / 0.2);
    transition: background-color var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard);
  }

  .cloud-dots :global(button:hover) {
    background: rgb(var(--fg) / 0.45);
  }

  .cloud-dots :global(button[aria-current="step"]) {
    background: rgb(var(--fg));
  }

  @media (min-width: 64rem) {
    .cloud-shell--snap {
      --panel-h: 100dvh;
      grid-template-rows: 100%;
    }

    .cloud-dots {
      right: 1rem;
    }
  }

  .cloud-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: rgb(var(--surface));
  }

  /* Phones: the home stays pinned at the top while the panel scrolls under it */
  .cloud-stage {
    position: sticky;
    top: 0;
    z-index: 2;
    height: 50svh;
    background: #f2f1ec; /* STAGE_BACKGROUND in src/lib/explorer/cloud-home-design.ts, which the 3D renders onto */
    overflow: hidden;
  }

  /* Full bleed so the ground fades out at the stage's edges; the model is framed small enough to clear the pill */
  .cloud-canvas {
    position: absolute;
    inset: 0;
  }

  .cloud-panel {
    padding-inline: var(--gutter);
    padding-bottom: 6rem;
  }

  @media (min-width: 64rem) {
    .cloud-shell {
      grid-template-columns: minmax(0, 1fr) minmax(0, 32rem);
    }

    .cloud-stage {
      height: 100svh;
    }

    .cloud-panel {
      padding-inline: 3rem;
    }
  }

  @media (min-width: 90rem) {
    .cloud-shell {
      grid-template-columns: minmax(0, 1fr) minmax(0, 38rem);
    }

    .cloud-panel {
      padding-inline: 4.5rem;
    }
  }

  .cloud-status {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .cloud-status[hidden] {
    display: none;
  }

  .cloud-foot {
    position: absolute;
    inset-inline: 0;
    bottom: 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
  }

  @media (min-width: 64rem) {
    .cloud-foot {
      bottom: 2.5rem;
    }
  }

  .cloud-pill {
    display: flex;
    gap: 0.375rem;
    align-items: baseline;
    padding: 0.5rem 1.125rem;
    border-radius: 999px;
    background: rgb(var(--surface) / 0.9);
    font-size: var(--text-lead);
    line-height: 1.3;
  }

  .cloud-arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: none;
    width: 3rem;
    height: 3rem;
    margin-top: -1.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgb(var(--surface) / 0.85);
    color: rgb(var(--fg));
    transition: background-color var(--dur-base) var(--ease-standard);
  }

  .cloud-arrow:hover {
    background: rgb(var(--surface));
  }

  .cloud-arrow:disabled {
    opacity: 0.35;
  }

  @media (min-width: 64rem) {
    .cloud-arrow {
      display: inline-flex;
    }
  }
</style>
