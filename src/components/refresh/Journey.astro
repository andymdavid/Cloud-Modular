---
/**
 * Journey (cf. samara.com/adus/how-it-works): a process as one line that draws down the page as it scrolls. Steps
 * alternate either side of it with their images, milestones sit on it as pills, and a moment is one giant word
 * across it. A step can show something other than its image: pass a function as the child, called with each step
 * and its index, and whatever it returns becomes that step's media. Used by Cloud Homes and Cloud Trade.
 */
export interface JourneyImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}

export type JourneyItem =
  | { kind: "step"; title: string; body: string; eyebrow?: string; image?: JourneyImage }
  | { kind: "milestone"; title: string }
  | { kind: "moment"; title: string; body: string };

interface Props {
  items: readonly JourneyItem[];
  /** The line runs on past the last step into the next section (Cloud Homes, into its welcome image). */
  runOn?: boolean;
  class?: string;
}

const { items, runOn = true, class: className } = Astro.props;

// Steps alternate sides of the line, counted over the steps alone so milestones don't break the rhythm
let stepCount = 0;
const placed = items.map((item) => (item.kind === "step" ? { ...item, side: stepCount++ % 2 === 0 ? "left" : "right" } : item));
const media = await Promise.all(
  items.map(async (item, index) => {
    if (item.kind !== "step" || !Astro.slots.has("default")) return null;
    const html = await Astro.slots.render("default", [item, index]);
    return html.trim() ? html : null;
  }),
);
---

<div class:list={["journey", { "journey--contained": !runOn }, className]} data-journey>
  <span class="journey-line" aria-hidden="true"><span class="journey-fill"></span></span>
  <ol class="journey-list">
    {placed.map((item, index) => (
      item.kind === "milestone" ? (
        <li class="j-milestone" data-mark>
          <span class="j-pill label">{item.title}</span>
        </li>
      ) : item.kind === "moment" ? (
        <li class="j-moment" data-mark>
          <h2 class="j-word" data-reveal>{item.title}</h2>
          <p class="j-moment-body text-lead" data-reveal>{item.body}</p>
        </li>
      ) : (
        <li class:list={["j-step", `j-step--${item.side}`, { "j-step--text": !item.image && !media[index] }]} data-mark>
          <span class="j-dot" aria-hidden="true"></span>
          <div class="j-text" data-reveal>
            {item.eyebrow && <p class="label label-muted mb-3">{item.eyebrow}</p>}
            <h2 class="text-h3">{item.title}</h2>
            <p class="mt-3 text-body text-fg-muted">{item.body}</p>
          </div>
          {media[index] ? (
            <div class="j-media j-media--slot" data-reveal><Fragment set:html={media[index]} /></div>
          ) : item.image && (
            <div class:list={["j-media", { "j-media--portrait": item.image.height > item.image.width }]} style={`aspect-ratio:${item.image.height > item.image.width ? "4 / 5" : `${item.image.width} / ${item.image.height}`}`} data-reveal>
              <img src={item.image.src} alt={item.image.alt} width={item.image.width} height={item.image.height} loading="lazy" decoding="async" class="h-full w-full object-cover" />
            </div>
          )}
        </li>
      )
    ))}
  </ol>
</div>

<style>
  /* The line: a faint track with an ink fill drawn to --p (0 to 1) of its height */
  .journey {
    --line-x: 0.6875rem;
    position: relative;
    padding-bottom: 1rem;
  }

  .journey-list {
    display: grid;
    gap: 4.5rem;
  }

  /* The line runs on through the section's bottom padding into the Welcome image, the end of the journey */
  .journey-line {
    position: absolute;
    top: 0;
    bottom: calc(-1 * var(--section));
    left: var(--line-x);
    width: 1px;
    background: rgb(var(--line) / var(--rule-alpha));
  }

  .journey--contained .journey-line {
    bottom: 0;
  }

  .journey-fill {
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--p, 1) * 100%);
    background: rgb(var(--ink));
  }

  /* Phones and tablets: the line runs down the left and everything sits to its right */
  .j-step,
  .j-milestone,
  .j-moment {
    position: relative;
    padding-left: calc(var(--line-x) * 2 + 1.5rem);
  }

  .j-dot {
    position: absolute;
    top: 0.45rem;
    left: calc(var(--line-x) - 0.3125rem);
    width: 0.625rem;
    height: 0.625rem;
    border: 1px solid rgb(var(--line) / 0.35);
    border-radius: 999px;
    background: rgb(var(--surface));
    transition: background-color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard);
  }

  .j-step.is-reached .j-dot {
    border-color: rgb(var(--ink));
    background: rgb(var(--ink));
  }

  .j-text {
    max-width: 30rem;
  }

  /* Each image keeps its own shape, portraits at 4:5 */
  .j-media {
    margin-top: 1.5rem;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: rgb(var(--stone));
  }


  /* Drawn or live media fill their own frame */
  .j-media--slot {
    position: relative;
    background: none;
  }

  .j-pill {
    display: inline-flex;
    align-items: center;
    height: 2rem;
    padding-inline: 0.875rem;
    border: 1px solid rgb(var(--line) / 0.2);
    border-radius: 999px;
    background: rgb(var(--surface));
    color: rgb(var(--fg-muted));
    transition: background-color var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard);
  }

  .j-milestone.is-reached .j-pill {
    border-color: rgb(var(--ink));
    background: rgb(var(--ink));
    color: rgb(var(--paper));
  }

  /* Phones: the pill straddles the line */
  .j-milestone {
    padding-left: 0;
  }

  /* The crane day: one giant word over the line */
  .j-word {
    font-family: var(--font-hero);
    font-size: clamp(4rem, 17vw, 15rem);
    font-weight: var(--weight-regular);
    line-height: 0.9;
    letter-spacing: var(--tracking-hero);
    white-space: nowrap;
  }

  .j-moment-body {
    margin-top: 1.5rem;
    max-width: 34ch;
  }

  /* From md: the line runs down the middle, steps alternate either side of it */
  @media (min-width: 48rem) {
    .journey {
      --line-x: 50%;
    }

    .journey-list {
      gap: 6rem;
    }

    .j-step {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(3rem, 8vw, 8rem);
      align-items: start;
      padding-left: 0;
    }

    .j-dot {
      left: calc(50% - 0.3125rem);
    }

    /* Text beside the line, image across it: left steps read right-aligned towards the line */
    .j-step--left .j-text {
      grid-column: 1;
      grid-row: 1;
      justify-self: end;
      text-align: right;
    }

    .j-step--left .j-media {
      grid-column: 2;
      grid-row: 1;
    }

    .j-step--right .j-text {
      grid-column: 2;
      grid-row: 1;
    }

    .j-step--right .j-media {
      grid-column: 1;
      grid-row: 1;
    }

    .j-text {
      max-width: 22rem;
    }

    .j-media {
      margin-top: 0;
    }

    /* Portraits stay narrower, against the line */
    .j-media--portrait {
      width: min(100%, 24rem);
    }

    .j-step--left .j-media--portrait {
      justify-self: start;
    }

    .j-step--right .j-media--portrait {
      justify-self: end;
    }

    .j-milestone {
      display: flex;
      justify-content: center;
    }

    .j-moment {
      padding-left: 0;
      text-align: center;
    }

    .j-word {
      position: relative;
      display: inline-block;
      padding-inline: 0.5rem;
      background: rgb(var(--surface));
    }

    .j-moment-body {
      position: relative;
      margin-inline: auto;
      padding-block: 0.5rem;
      background: rgb(var(--surface));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .j-dot,
    .j-pill {
      transition: none;
    }
  }
</style>

<script>
  // The line draws as the journey passes the reading line (70% down the screen); each step's dot and each milestone
  // fill once they reach it. Reduced motion shows it all drawn.
  document.querySelectorAll<HTMLElement>("[data-journey]").forEach((root) => {
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");
    const marks = [...root.querySelectorAll<HTMLElement>("[data-mark]")];
    const track = root.querySelector<HTMLElement>(".journey-line")!;
    let frame = 0;

    const update = () => {
      frame = 0;
      const line = window.innerHeight * 0.7;
      const rect = track.getBoundingClientRect();
      const p = still.matches ? 1 : Math.min(1, Math.max(0, (line - rect.top) / rect.height));
      root.style.setProperty("--p", p.toFixed(4));
      for (const mark of marks) mark.classList.toggle("is-reached", still.matches || mark.getBoundingClientRect().top < line);
    };
    const request = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    window.addEventListener("scroll", request, { passive: true });
    window.addEventListener("resize", request);
    update();
  });
</script>
