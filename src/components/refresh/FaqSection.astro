---
import SplitSection from "@/components/refresh/SplitSection.astro";
import Accordion from "@/components/refresh/Accordion.astro";
import { faqItems, type FaqTopic } from "@/data/site";

/**
 * FAQ block: a split section with the question list in the right half.
 * Shows one topic's questions; pages pass `more` to link to the full list at /faq/.
 */
interface Props {
  topic: FaqTopic;
  label?: string;
  id?: string;
  /** Divider above the block; off when it follows a full-bleed section. */
  rule?: boolean;
  /** Show a "See all questions" link to /faq/ under the list. */
  more?: boolean;
  /** Only questions whose home is this topic (the /faq/ page, so shared questions aren't listed twice). */
  ownOnly?: boolean;
}

const { topic, label = "FAQ", id, rule = true, more = true, ownOnly = false } = Astro.props;
const items = faqItems.filter(
  (item) => item.topic === topic || (!ownOnly && (item as { alsoOn?: readonly string[] }).alsoOn?.includes(topic)),
);
---

<SplitSection id={id} label={label} rule={rule}>
  <Accordion items={items.map((item) => ({ title: item.question, body: item.answer }))} />
  {more && <a href="/faq/" class="btn mt-10">See all questions</a>}
</SplitSection>
