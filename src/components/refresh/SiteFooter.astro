---
import { site } from "@/data/site";
import Logo from "@/components/refresh/Logo.astro";
import MvpGroupLogo from "@/components/refresh/MvpGroupLogo.astro";
import { brands, family, masterbrand, parent, type Brand, type BrandId } from "@/data/brands";

/**
 * Footer (olympic.no): full-width slate panel on a six-column grid. Row 1: the brand's logo and a line about it,
 * then link groups under grey mono labels. Row 2: an enquiry block on the left; offices, contact icons and
 * back-to-top on the right. Row 3: Made by Cloud and the three Cloud sites, this one as plain text. Row 4: the MVP
 * Group lockup, copyright and legal links. Rows are split by soft hairlines.
 */
interface Props {
  brand?: BrandId;
}

const brandId: BrandId = Astro.props.brand ?? "modular";
const brand: Brand = brands[brandId];
const groups = brand.footer.groups;
---

<!-- At least one screen tall: the link groups at the top, the enquiry block and base row pinned to the bottom -->
<footer id="contact" data-theme="dark" class="site-footer flex min-h-[100svh] scroll-mt-header flex-col">
  <div class="shell flex flex-1 flex-col">
    <!-- Row 1: the brand's logo and a line about it on columns 1–2, then one link group on each of columns 3–6 -->
    <div class="grid grid-cols-2 gap-x-gap-sm gap-y-10 pb-16 pt-[calc(var(--header-h)+2.75rem)] md:grid-cols-6">
      <div class="col-span-2 flex flex-col items-start">
        <a href={brand.home} class="flex flex-col items-start gap-1.5 text-fg" aria-label={`${brand.name} home`}>
          <Logo class="h-[22px] w-auto" title={brand.name} />
          {brand.descriptor && <span class="footer-descriptor" aria-hidden="true">{brand.descriptor}</span>}
        </a>
        <p class="mt-8 max-w-[32ch] text-small text-sage">{brand.footer.blurb}</p>
      </div>
      {groups.map((group) => (
        <nav aria-label={group.label}>
          <p class="label label-muted">{group.label}</p>
          <ul class="mt-4 space-y-2">
            {group.links.map((link) => (
              <li>
                <a href={link.href} class="footer-link" {...(link.external ? { target: "_blank", rel: "noreferrer" } : {})}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <!-- Row 2: enquiry left; offices, contact icons and back-to-top right -->
    <div class="footer-rule mt-auto grid grid-cols-2 gap-x-gap-sm gap-y-12 pb-12 pt-12 md:grid-cols-6">
      <div class="col-span-2 flex flex-col items-start" data-reveal>
        <p class="label label-muted">Let’s talk</p>
        <p class="mt-4 max-w-[34ch] text-small text-sage">{brand.footer.prompt}</p>
        <div class="mt-10 flex flex-wrap gap-1 md:mt-auto md:pt-10">
          {brand.footer.actions.map((action) => <a href={action.href} class="footer-btn">{action.label}</a>)}
        </div>
      </div>

      <div class="col-span-2 grid grid-cols-2 gap-x-gap-sm md:col-start-5" data-reveal>
        <p class="label label-muted col-span-2">Offices</p>
        {site.offices.map((office) => (
          <div class="mt-4 text-small">
            <p>{office.city}</p>
            <div class="text-sage">{office.lines.map((line) => <p>{line}</p>)}</div>
          </div>
        ))}

        <p class="label label-muted col-span-2 mt-10">Connect</p>
        <div class="mt-4 flex gap-1">
          <a href={site.linkedIn} target="_blank" rel="noreferrer" class="footer-icon" aria-label="Cloud Modular on LinkedIn">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.8v1.5h.05c.53-1 1.84-2.05 3.78-2.05 4.05 0 4.8 2.66 4.8 6.13v5.42h-4v-4.8c0-1.15-.02-2.62-1.6-2.62-1.6 0-1.84 1.25-1.84 2.54v4.88h-4v-11Z" /></svg>
          </a>
          <a href={brand.contact ?? `mailto:${site.email}`} class="footer-icon" aria-label={brand.contact ? `Message ${brand.name}` : `Email ${site.email}`}>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="1.5" y="3" width="11" height="8" rx="0.5" stroke="currentColor" stroke-width="1.1" /><path d="m2 3.5 5 4 5-4" stroke="currentColor" stroke-width="1.1" /></svg>
          </a>
        </div>
        <div class="mt-4">
          <a href="#top" class="footer-top" aria-label="Back to top" data-to-top>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M6 10V2M2.5 5.5 6 2l3.5 3.5" stroke="currentColor" stroke-width="1.1" /></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Row 3: Made by Cloud on columns 1–2, then the Cloud sites on columns 3–5 (this one unlinked) -->
    <div class="footer-rule grid grid-cols-2 gap-x-gap-sm gap-y-4 py-6 md:grid-cols-6">
      {masterbrand.href
        ? <a href={masterbrand.href} class="label label-muted footer-legal col-span-2">{masterbrand.name}</a>
        : <p class="label label-muted col-span-2">{masterbrand.name}</p>}
      <nav class="col-span-2 grid grid-cols-3 gap-x-gap-sm md:col-span-3" aria-label="Cloud sites">
        {family.map((id) =>
          id === brandId
            ? <span class="label" aria-current="page">{brands[id].name}</span>
            : <a href={brands[id].home} class="label label-muted footer-legal">{brands[id].name}</a>
        )}
      </nav>
    </div>

    <!-- Row 4: An MVP Group company, then copyright, Privacy Policy, Terms and the credit on columns 3–6 -->
    <div class="footer-rule grid grid-cols-2 items-center gap-x-gap-sm gap-y-6 pb-8 pt-6 md:grid-cols-6">
      <p class="footer-parent label label-muted col-span-2">
        <span>An</span>
        <a href={parent.href} target="_blank" rel="noopener" class="footer-parent-logo" aria-label={`${parent.name} website`}>
          <MvpGroupLogo class="h-[34px] w-auto text-fg" />
        </a>
        <span>company</span>
      </p>
      <p class="label label-muted">{new Date().getFullYear()} © {brand.name}</p>
      <a href="/privacy-policy/" class="label label-muted footer-legal">Privacy Policy</a>
      <a href="/terms/" class="label label-muted footer-legal">Terms</a>
      <!-- Site credit: the studio's icon, which winks on hover, its name shown above -->
      <a href="https://offpistestudio.com" target="_blank" rel="noopener" class="site-by label label-muted justify-self-end" aria-label="Site by Off Piste Studio">
        <span aria-hidden="true">Site by</span>
        <svg class="site-by-mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
          <rect x="16" y="11" width="10" height="10" /><rect class="site-by-eye" x="38" y="11" width="10" height="10" />
          <rect x="6" y="33" width="10" height="10" /><rect x="48" y="33" width="10" height="10" />
          <rect x="16" y="43" width="32" height="10" />
        </svg>
        <span class="site-by-name" aria-hidden="true">Off Piste Studio</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --surface: var(--slate);
    --surface-alt: var(--slate);
    background: rgb(var(--slate));
  }

  /* The brand word under the wordmark, as in the header */
  .footer-descriptor {
    padding-left: 0.0625rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: var(--weight-medium);
    line-height: 1;
    letter-spacing: 0.42em;
    text-transform: uppercase;
  }

  /* "An [MVP Group logo] company", the logo set on the words' midline */
  .footer-parent {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-parent-logo {
    transition: opacity var(--dur-base) var(--ease-standard);
  }

  .footer-parent-logo:hover {
    opacity: 0.75;
  }

  .footer-rule {
    border-top: var(--rule) solid rgb(var(--paper) / 0.1);
  }

  .footer-link {
    font-size: var(--text-small);
    color: rgb(var(--paper));
    transition: color var(--dur-base) var(--ease-standard);
  }

  .footer-legal {
    transition: color var(--dur-base) var(--ease-standard);
  }

  .footer-legal:hover {
    color: rgb(var(--paper));
  }

  .site-by {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    transition: color var(--dur-base) var(--ease-standard);
  }

  .site-by-mark {
    width: 1.125rem;
    height: 1.125rem;
    fill: currentColor;
  }

  /* The studio's name appears above the mark on hover or focus */
  .site-by-name {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.625rem);
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-xs);
    background: rgb(var(--paper));
    color: rgb(var(--ink));
    white-space: nowrap;
    opacity: 0;
    transform: translateY(0.25rem);
    pointer-events: none;
    transition:
      opacity var(--dur-base) var(--ease-standard),
      transform var(--dur-base) var(--ease-standard);
  }

  .site-by:hover,
  .site-by:focus-visible {
    color: rgb(var(--paper));
  }

  /* The studio glyph's Wink (offpistestudio.com): the right eye closes to a slit (37, 14, 12 × 3) over 180ms,
     holds for 480ms and opens again */
  .site-by-eye {
    transform-box: fill-box;
    transform-origin: center;
  }

  .site-by:hover .site-by-eye,
  .site-by:focus-visible .site-by-eye {
    animation: site-by-wink 840ms var(--ease-standard);
  }

  @keyframes site-by-wink {
    0%,
    100% {
      transform: none;
    }

    21%,
    79% {
      transform: translateY(-0.5px) scale(1.2, 0.3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-by:hover .site-by-eye,
    .site-by:focus-visible .site-by-eye {
      animation: none;
    }
  }

  .site-by:hover .site-by-name,
  .site-by:focus-visible .site-by-name {
    opacity: 1;
    transform: none;
  }

  .footer-link:hover {
    color: rgb(var(--label-gold));
  }

  /* Footer buttons: a dark translucent fill with sage mono text (olympic.no), lighter on hover */
  .footer-btn,
  .footer-icon,
  .footer-top {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2rem;
    border-radius: var(--radius-media);
    color: rgb(var(--sage));
    transition:
      background-color var(--dur-base) var(--ease-standard),
      color var(--dur-base) var(--ease-standard),
      border-color var(--dur-base) var(--ease-standard);
  }

  .footer-btn {
    padding-inline: 0.875rem;
    background: rgb(var(--paper) / 0.06);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .footer-icon {
    width: 2rem;
    background: rgb(var(--paper) / 0.06);
  }

  .footer-top {
    width: 2rem;
    border: var(--rule) solid rgb(var(--paper) / 0.2);
  }

  .footer-btn:hover,
  .footer-icon:hover,
  .footer-top:hover {
    background: rgb(var(--paper));
    border-color: rgb(var(--paper));
    color: rgb(var(--ink));
  }
</style>

<script>
  // Back to top without writing #top to the URL
  document.querySelector("[data-to-top]")?.addEventListener("click", (event) => {
    event.preventDefault();
    window.scrollTo({ top: 0 });
  });
</script>
