---
/**
 * Modscape-style module header: hairline rule, title, short intro on the left,
 * optional actions (button or carousel arrows) aligned right.
 */
interface Props {
  title: string;
  intro?: string;
  as?: "h2" | "h3";
}

const { title, intro, as: Heading = "h2" } = Astro.props;
---

<div class="rule pt-5 sm:pt-6" data-reveal>
  <Heading class="text-h2">{title}</Heading>
  <div class="mt-6 flex flex-col gap-5 sm:mt-8 sm:flex-row sm:items-end sm:justify-between sm:gap-gap">
    {intro && <p class="max-w-measure text-body font-medium">{intro}</p>}
    {Astro.slots.has("actions") && <div class="flex shrink-0 items-center gap-2"><slot name="actions" /></div>}
  </div>
</div>
