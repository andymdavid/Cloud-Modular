---
/**
 * Module header: divider, section padding, a small mono label, the ALL CAPS title, a short intro on the
 * left, and optional actions (button or carousel arrows) aligned right.
 */
interface Props {
  /** Small mono label above the title, naming the section (cf. olympic.no). */
  label?: string;
  title: string;
  intro?: string;
  as?: "h2" | "h3";
  /** Omit the divider (e.g. directly after a full-bleed image); the section supplies its own top padding. */
  rule?: boolean;
}

const { label, title, intro, as: Heading = "h2", rule = true } = Astro.props;
---

<div class:list={{ "rule pt-section": rule }} data-reveal>
  {label && <p class="label mb-5 sm:mb-6">{label}</p>}
  <Heading class="text-h2">{title}</Heading>
  <div class="mt-6 flex flex-col gap-5 sm:mt-8 sm:flex-row sm:items-end sm:justify-between sm:gap-gap">
    {intro && <p class="max-w-measure text-body font-medium">{intro}</p>}
    {Astro.slots.has("actions") && <div class="flex shrink-0 items-center gap-2"><slot name="actions" /></div>}
  </div>
</div>
