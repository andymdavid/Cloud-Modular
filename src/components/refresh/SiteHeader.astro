---
import { site } from "@/data/site";
import Logo from "@/components/refresh/Logo.astro";

export interface NavLink {
  label: string;
  href: string;
}

interface Props {
  overlay?: boolean;
  links?: NavLink[];
}

const {
  overlay = false,
  links = [
    // Home sections point at the refresh home (/alt-home/) until it replaces /
    { label: "Projects", href: "/alt-home/#projects" },
    { label: "Sectors", href: "/alt-home/#sectors" },
    { label: "Quality", href: "/quality/" },
    { label: "Why Cloud Modular", href: "/why-cloud-modular/" },
    { label: "About", href: "/about/" },
    { label: "FAQ", href: "/faq/" },
    { label: "Contact", href: "#contact" },
  ],
} = Astro.props;
---

<!-- Header (olympic.no): transparent, logo and menu icon at the page margin. Its colour follows the section
     underneath; scrolling down slides it away, scrolling up brings it back, and once off the top the
     wordmark collapses to the cloud. -->
<header
  data-site-header
  data-theme={overlay ? "dark" : "light"}
  class="site-header pointer-events-none fixed inset-x-0 top-0 z-50"
>
  <div class="shell">
    <div class="header-row flex items-center justify-between gap-6 pt-gutter">
      <a href="/" class="site-logo pointer-events-auto shrink-0" aria-label="Cloud Modular home">
        <Logo class="h-[20px] w-auto sm:h-[24px]" />
      </a>

      <button type="button" data-menu-open class="menu-icon pointer-events-auto" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<!-- Slide-in menu panel (Bloom): white panel from the right over a soft scrim -->
<div data-menu-root class="menu-root" aria-hidden="true" inert>
  <div data-menu-scrim class="menu-scrim"></div>
  <div id="site-menu" data-theme="light" class="menu-panel" role="dialog" aria-modal="true" aria-label="Site menu">
    <div class="flex h-header shrink-0 items-center justify-end">
      <button type="button" data-menu-close class="menu-icon menu-icon--close" aria-label="Close menu">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>

    <nav class="menu-links mt-4 flex flex-col items-start gap-1" aria-label="Main navigation">
      {links.map((link, index) => (
        <a data-menu-link href={link.href} class="menu-link" style={`--i:${index}`}>{link.label}</a>
      ))}
    </nav>

    <div class="menu-cta mt-auto pb-10 pt-16">
      <p class="font-display text-[1.5rem] font-normal leading-[1.2] tracking-[var(--tracking-heading)]">Let’s talk about your next project</p>
      <div class="mt-6 flex flex-wrap gap-1">
        <a data-menu-link href={site.enquiryHref} class="btn-solid h-12 px-5">Enquire now</a>
        <a data-menu-link href="/partner-with-us/" class="btn-solid h-12 px-5">Partner with us</a>
      </div>
    </div>
  </div>
</div>

<style>
  .site-header {
    background: transparent;
  }

  /* Slide away while scrolling down, back in while scrolling up (olympic.no timing) */
  .site-header {
    transition: transform 1.2s cubic-bezier(0.22, 0.7, 0.2, 1);
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  /* Until the first theme sync, apply colours instantly so a reload never shows a stale state */
  .site-header:not(.is-ready) .site-logo,
  .site-header:not(.is-ready) .menu-icon {
    transition: none;
  }

  /* At the top of the page the row sits at the page margin (olympic.no). Once scrolling, it rises to the original
     lightweight position: logo and menu icon centred in a 72px bar (the 44px row centred, so 14px from the top). */
  .header-row {
    transition: transform 0.8s cubic-bezier(0.22, 0.7, 0.2, 1);
  }

  .site-header.is-compact .header-row {
    transform: translateY(calc((var(--header-h) - 2.75rem) / 2 - var(--gutter)));
  }

  /* Wordmark collapse: the letters slide up out of the logo and fade, and the cloud glides to the left edge.
     Transforms are in the SVG's own units (viewBox 1799 × 349; the cloud starts at x 626). */
  .site-logo :global(.logo-letters),
  .site-logo :global(.logo-mark) {
    transform-box: view-box;
    transition:
      transform 0.8s cubic-bezier(0.22, 0.7, 0.2, 1),
      opacity 0.4s var(--ease-standard);
  }

  .site-header.is-compact .site-logo :global(.logo-letters) {
    transform: translateY(-349px);
    opacity: 0;
  }

  .site-header.is-compact .site-logo :global(.logo-mark) {
    transform: translateX(-626px);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .header-row,
    .site-logo :global(.logo-letters),
    .site-logo :global(.logo-mark) {
      transition: none;
    }
  }

  .site-logo {
    color: rgb(var(--fg));
    transition: color var(--dur-base) var(--ease-standard);
  }

  /* Two-bar menu icon; the close variant crosses the same bars into an × */
  .menu-icon {
    position: relative;
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.625rem; /* bars align with the page gutter */
    color: rgb(var(--fg));
    transition:
      opacity var(--dur-base) var(--ease-standard),
      color var(--dur-base) var(--ease-standard);
  }

  .menu-icon:hover {
    opacity: 0.6;
  }

  .menu-icon span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.5rem;
    height: 1.5px;
    margin: -0.75px 0 0 -0.75rem;
    background: currentColor;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .menu-icon span:first-child {
    transform: translateY(-3.5px);
  }

  .menu-icon span:last-child {
    transform: translateY(3.5px);
  }

  .menu-root.is-open .menu-icon--close span {
    transition-delay: 200ms;
  }

  .menu-root.is-open .menu-icon--close span:first-child {
    transform: rotate(45deg);
  }

  .menu-root.is-open .menu-icon--close span:last-child {
    transform: rotate(-45deg);
  }

  .menu-root {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
  }

  .menu-root.is-open {
    pointer-events: auto;
  }

  .menu-scrim {
    position: absolute;
    inset: 0;
    background: rgb(var(--ink) / 0.35);
    opacity: 0;
    transition: opacity var(--dur-panel) var(--ease-out);
  }

  .menu-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    width: min(var(--menu-w), 100%);
    padding-inline: var(--gap) var(--gutter);
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform var(--dur-panel) var(--ease-out);
  }

  .menu-root.is-open .menu-scrim {
    opacity: 1;
  }

  .menu-root.is-open .menu-panel {
    transform: none;
  }

  .menu-link {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: var(--tracking-title);
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out),
      color var(--dur-base) var(--ease-standard);
  }

  .menu-link:hover {
    color: rgb(var(--fg-subtle));
  }

  .menu-root.is-open .menu-link {
    opacity: 1;
    transform: none;
    transition-delay: calc(150ms + var(--i) * 50ms), calc(150ms + var(--i) * 50ms), 0ms;
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-panel,
    .menu-scrim,
    .menu-link,
    .menu-icon span {
      transition: none !important;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");

  // Match the header's colour to the section beneath it: dark once a dark section reaches the header's
  // midpoint and still covers it (olympic.no switches the same way, with no background behind the header)
  const themedSections = [...document.querySelectorAll<HTMLElement>("main [data-theme], footer[data-theme]")];

  // Scroll state: hide while scrolling down past the first half-screen, show on any scroll up, and collapse
  // the wordmark once the page has moved off the top. Never hidden while the menu is open or the header has focus.
  const HIDE_AFTER = () => window.innerHeight * 0.5;
  const COMPACT_AFTER = 80;
  const DELTA = 6; // ignore tiny scroll jitters
  let lastY = window.scrollY;

  let ticking = false;
  const syncTheme = () => {
    ticking = false;
    if (!header) return;
    const bottom = header.offsetHeight;
    let theme = "light";
    for (const section of themedSections) {
      const rect = section.getBoundingClientRect();
      // A dark section counts once it reaches the header's midpoint, so landing exactly on its top edge
      // (a jump link, a sub-pixel scroll position) still switches the header
      if (section.dataset.theme === "dark" && rect.top <= bottom / 2 && rect.bottom >= bottom) theme = "dark";
    }
    if (header.dataset.theme !== theme) header.dataset.theme = theme;

    const y = Math.max(0, window.scrollY);
    header.classList.toggle("is-compact", y > COMPACT_AFTER);
    const menuOpen = document.documentElement.classList.contains("menu-open");
    const focused = header.contains(document.activeElement);
    if (y <= HIDE_AFTER() || menuOpen || focused) header.classList.remove("is-hidden");
    else if (y - lastY > DELTA) header.classList.add("is-hidden");
    else if (lastY - y > DELTA) header.classList.remove("is-hidden");
    if (Math.abs(y - lastY) > DELTA) lastY = y;
  };
  const requestSync = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(syncTheme);
  };
  window.addEventListener("scroll", requestSync, { passive: true });
  window.addEventListener("resize", requestSync);
  // Re-check once layout settles (late styles, fonts, media) and after a back/forward restore
  window.addEventListener("load", requestSync);
  window.addEventListener("pageshow", requestSync);
  header?.addEventListener("focusin", () => header.classList.remove("is-hidden"));
  syncTheme();
  requestAnimationFrame(() => requestAnimationFrame(() => header?.classList.add("is-ready")));

  const root = document.querySelector<HTMLElement>("[data-menu-root]");
  const panel = root?.querySelector<HTMLElement>("[role='dialog']");
  const openButton = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeButton = root?.querySelector<HTMLButtonElement>("[data-menu-close]");

  const setMenu = (open: boolean) => {
    if (!root || !openButton) return;
    if (open === root.classList.contains("is-open")) return;
    root.classList.toggle("is-open", open);
    root.setAttribute("aria-hidden", String(!open));
    root.toggleAttribute("inert", !open);
    openButton.setAttribute("aria-expanded", String(open));
    document.documentElement.classList.toggle("menu-open", open);
    (open ? closeButton : openButton)?.focus({ preventScroll: true });
  };

  openButton?.addEventListener("click", () => setMenu(true));
  closeButton?.addEventListener("click", () => setMenu(false));
  root?.querySelector("[data-menu-scrim]")?.addEventListener("click", () => setMenu(false));
  root?.querySelectorAll("[data-menu-link]").forEach((link) => link.addEventListener("click", () => setMenu(false)));

  document.addEventListener("keydown", (event) => {
    if (!root?.classList.contains("is-open")) return;
    if (event.key === "Escape") {
      setMenu(false);
      return;
    }
    // Keep keyboard focus inside the open panel
    if (event.key === "Tab" && panel) {
      const focusable = panel.querySelectorAll<HTMLElement>("a[href], button");
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
  });
</script>
