---
import { site } from "@/data/site";

export interface NavLink {
  label: string;
  href: string;
}

interface Props {
  overlay?: boolean;
  links?: NavLink[];
}

const {
  overlay = false,
  links = [
    { label: "Sectors", href: "#sectors" },
    { label: "Quality", href: "#quality" },
    { label: "About", href: "/about/" },
    { label: "FAQ", href: "#faq" },
    { label: "Contact", href: "#contact" },
  ],
} = Astro.props;
---

<!-- Bloom-style header: no background or divider, just the logo and menu icon.
     Its theme follows whichever section is underneath, so it stays legible. -->
<header
  data-site-header
  data-theme={overlay ? "dark" : "light"}
  class="site-header pointer-events-none fixed inset-x-0 top-0 z-50"
>
  <div class="shell">
    <div class="flex h-header items-center justify-between gap-6">
      <a href="/" class="site-logo pointer-events-auto shrink-0" aria-label="Cloud Modular home">
        <img src="/logo.webp" alt="Cloud Modular" width="1280" height="275" class="h-[22px] w-auto sm:h-[26px]" />
      </a>

      <button type="button" data-menu-open class="menu-icon pointer-events-auto" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<!-- Slide-in menu panel (Bloom): white panel from the right over a soft scrim -->
<div data-menu-root class="menu-root" aria-hidden="true" inert>
  <div data-menu-scrim class="menu-scrim"></div>
  <div id="site-menu" data-theme="light" class="menu-panel" role="dialog" aria-modal="true" aria-label="Site menu">
    <div class="flex h-header shrink-0 items-center justify-end">
      <button type="button" data-menu-close class="menu-icon menu-icon--close" aria-label="Close menu">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>

    <nav class="menu-links mt-4 flex flex-col items-start gap-1" aria-label="Main navigation">
      {links.map((link, index) => (
        <a data-menu-link href={link.href} class="menu-link" style={`--i:${index}`}>{link.label}</a>
      ))}
    </nav>

    <div class="menu-cta mt-auto pb-10 pt-16">
      <p class="font-display text-[1.5rem] font-normal leading-[1.2] tracking-[var(--tracking-heading)]">Let’s talk about your next project</p>
      <div class="mt-6 flex flex-wrap gap-1">
        <a data-menu-link href={site.enquiryHref} class="btn-solid h-12 px-5">Enquire now</a>
        <a data-menu-link href="/partner-with-us/" class="btn-solid h-12 px-5">Partner with us</a>
      </div>
    </div>
  </div>
</div>

<style>
  .site-header {
    background: transparent;
  }

  /* Over photography the white logo/icon get a soft top fade for legibility; nothing on light sections */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 100%; /* never spills past the header onto a neighbouring light section */
    z-index: -1; /* behind the logo and icon (the header is its own stacking context) */
    background: linear-gradient(180deg, rgb(var(--ink) / 0.5) 0%, rgb(var(--ink) / 0) 100%);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-standard);
    pointer-events: none;
  }

  .site-header[data-theme="dark"]::before {
    opacity: 1;
  }

  /* Supplied logo is white; render it ink on light surfaces */
  .site-logo img {
    transition: filter var(--dur-base) var(--ease-standard);
  }

  .site-header[data-theme="light"] .site-logo img {
    filter: brightness(0);
  }

  /* Two-bar menu icon; the close variant crosses the same bars into an × */
  .menu-icon {
    position: relative;
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.625rem; /* bars align with the page gutter */
    color: rgb(var(--fg));
    transition:
      opacity var(--dur-base) var(--ease-standard),
      color var(--dur-base) var(--ease-standard);
  }

  .menu-icon:hover {
    opacity: 0.6;
  }

  .menu-icon span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.5rem;
    height: 1.5px;
    margin: -0.75px 0 0 -0.75rem;
    background: currentColor;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .menu-icon span:first-child {
    transform: translateY(-3.5px);
  }

  .menu-icon span:last-child {
    transform: translateY(3.5px);
  }

  .menu-root.is-open .menu-icon--close span {
    transition-delay: 200ms;
  }

  .menu-root.is-open .menu-icon--close span:first-child {
    transform: rotate(45deg);
  }

  .menu-root.is-open .menu-icon--close span:last-child {
    transform: rotate(-45deg);
  }

  .menu-root {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
  }

  .menu-root.is-open {
    pointer-events: auto;
  }

  .menu-scrim {
    position: absolute;
    inset: 0;
    background: rgb(var(--ink) / 0.35);
    opacity: 0;
    transition: opacity var(--dur-panel) var(--ease-out);
  }

  .menu-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    width: min(var(--menu-w), 100%);
    padding-inline: var(--gap) var(--gutter);
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform var(--dur-panel) var(--ease-out);
  }

  .menu-root.is-open .menu-scrim {
    opacity: 1;
  }

  .menu-root.is-open .menu-panel {
    transform: none;
  }

  .menu-link {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: var(--tracking-title);
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out),
      color var(--dur-base) var(--ease-standard);
  }

  .menu-link:hover {
    color: rgb(var(--fg-subtle));
  }

  .menu-root.is-open .menu-link {
    opacity: 1;
    transform: none;
    transition-delay: calc(150ms + var(--i) * 50ms), calc(150ms + var(--i) * 50ms), 0ms;
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-panel,
    .menu-scrim,
    .menu-link,
    .menu-icon span {
      transition: none !important;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");

  // Match the header's theme to the section beneath it. Dark only when a dark section covers the
  // whole header, so the white logo and its fade never sit over a light section.
  const themedSections = [...document.querySelectorAll<HTMLElement>("main [data-theme], footer[data-theme]")];
  let ticking = false;
  const syncTheme = () => {
    ticking = false;
    if (!header) return;
    const bottom = header.offsetHeight;
    let theme = "light";
    for (const section of themedSections) {
      const rect = section.getBoundingClientRect();
      if (section.dataset.theme === "dark" && rect.top <= 0 && rect.bottom >= bottom) theme = "dark";
    }
    if (header.dataset.theme !== theme) header.dataset.theme = theme;
  };
  const requestSync = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(syncTheme);
  };
  window.addEventListener("scroll", requestSync, { passive: true });
  window.addEventListener("resize", requestSync);
  syncTheme();

  const root = document.querySelector<HTMLElement>("[data-menu-root]");
  const panel = root?.querySelector<HTMLElement>("[role='dialog']");
  const openButton = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeButton = root?.querySelector<HTMLButtonElement>("[data-menu-close]");

  const setMenu = (open: boolean) => {
    if (!root || !openButton) return;
    if (open === root.classList.contains("is-open")) return;
    root.classList.toggle("is-open", open);
    root.setAttribute("aria-hidden", String(!open));
    root.toggleAttribute("inert", !open);
    openButton.setAttribute("aria-expanded", String(open));
    document.documentElement.classList.toggle("menu-open", open);
    (open ? closeButton : openButton)?.focus({ preventScroll: true });
  };

  openButton?.addEventListener("click", () => setMenu(true));
  closeButton?.addEventListener("click", () => setMenu(false));
  root?.querySelector("[data-menu-scrim]")?.addEventListener("click", () => setMenu(false));
  root?.querySelectorAll("[data-menu-link]").forEach((link) => link.addEventListener("click", () => setMenu(false)));

  document.addEventListener("keydown", (event) => {
    if (!root?.classList.contains("is-open")) return;
    if (event.key === "Escape") {
      setMenu(false);
      return;
    }
    // Keep keyboard focus inside the open panel
    if (event.key === "Tab" && panel) {
      const focusable = panel.querySelectorAll<HTMLElement>("a[href], button");
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
  });
</script>
