---
import type { GalleryRow } from "@/data/projects";

/**
 * Project gallery: large editorial rows rather than a swipe row (cf. Modscape's full-width project imagery).
 * A "full" row runs the image across the wide row; a "pair" sets a wide image against a narrower one dropped
 * lower, so the sequence steps down the page. Each image wipes up into view as it enters, and opens in a
 * full-screen viewer with captions, a counter, arrow keys and swipe.
 */
interface Props {
  rows: readonly GalleryRow[];
  label?: string;
}

const { rows, label = "Gallery" } = Astro.props;
const images = rows.flatMap((row) => (row.kind === "full" ? [row.image] : row.images));
const indexOf = (src: string) => images.findIndex((image) => image.src === src);
const number = (index: number) => String(index + 1).padStart(2, "0");
---

<section id="gallery" data-theme="light" class="scroll-mt-header pb-section" data-gallery>
  <div class="shell">
    <div class="rule grid-12 gap-y-6 pt-section">
      <h2 class="label col-span-12 md:col-span-6" data-reveal>{label}</h2>
    </div>
  </div>

  <div class="wide-row mt-section-sm space-y-section-sm">
    {rows.map((row) =>
      row.kind === "full" ? (
        <figure class="gallery-item">
          <button type="button" class="gallery-frame" data-open-image={indexOf(row.image.src)} aria-label={`View larger: ${row.image.alt}`}>
            <img src={row.image.src} alt={row.image.alt} width={row.image.width} height={row.image.height} loading="lazy" decoding="async" class="h-full w-full object-cover" style={row.image.position ? `object-position:${row.image.position}` : undefined} />
          </button>
          {row.image.caption && <figcaption class="gallery-caption"><span class="label">{number(indexOf(row.image.src))}</span>{row.image.caption}</figcaption>}
        </figure>
      ) : (
        <div class="grid grid-cols-12 gap-x-gap-sm gap-y-section-sm">
          {row.images.map((image, index) => (
            <figure class:list={["gallery-item col-span-12", index === 0 ? "md:col-span-7" : "md:col-span-5 md:mt-[18%] lg:col-span-4 lg:col-start-9"]}>
              <button type="button" class="gallery-frame" data-open-image={indexOf(image.src)} aria-label={`View larger: ${image.alt}`}>
                <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" class="h-full w-full object-cover" style={image.position ? `object-position:${image.position}` : undefined} />
              </button>
              {image.caption && <figcaption class="gallery-caption"><span class="label">{number(indexOf(image.src))}</span>{image.caption}</figcaption>}
            </figure>
          ))}
        </div>
      ),
    )}
  </div>

  <!-- Full-screen viewer -->
  <dialog class="gallery-viewer" aria-label="Project images" data-viewer>
    <div class="flex h-full flex-col" data-theme="dark">
      <div class="flex items-center justify-between px-gutter py-5">
        <p class="label tabular-nums" aria-live="polite" data-count></p>
        <button type="button" class="btn" data-close>Close</button>
      </div>
      <div class="relative flex min-h-0 flex-1 items-center justify-center px-gutter" data-stage>
        <img alt="" class="max-h-full max-w-full object-contain" data-viewer-image />
        <button type="button" class="icon-btn absolute left-gutter top-1/2 -translate-y-1/2" aria-label="Previous image" data-step="-1">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M8.5 3 4.5 7l4 4" stroke="currentColor" stroke-width="1.2" /></svg>
        </button>
        <button type="button" class="icon-btn absolute right-gutter top-1/2 -translate-y-1/2" aria-label="Next image" data-step="1">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="m5.5 3 4 4-4 4" stroke="currentColor" stroke-width="1.2" /></svg>
        </button>
      </div>
      <p class="px-gutter py-5 text-small text-fg-muted" data-viewer-caption></p>
    </div>
    <script is:inline type="application/json" data-images set:html={JSON.stringify(images.map(({ src, alt, caption }) => ({ src, alt, caption: caption ?? "" })))} />
  </dialog>
</section>

<style>
  .gallery-frame {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: rgb(var(--stone));
    cursor: zoom-in;
    clip-path: inset(0 0 0 0 round var(--radius-media));
    transition: clip-path 1.1s var(--ease-out);
  }

  .gallery-frame img {
    transform: scale(1);
    transition: transform 1.4s var(--ease-out);
  }

  /* Wipe up into view: the frame opens from the bottom while the image settles from a slight zoom */
  .gallery-item[data-pending] .gallery-frame {
    clip-path: inset(100% 0 0 0 round var(--radius-media));
  }

  .gallery-item[data-pending] .gallery-frame img {
    transform: scale(1.12);
  }

  .gallery-frame:hover img {
    transform: scale(1.02);
  }

  .gallery-caption {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    margin-top: 0.875rem;
    font-size: var(--text-small);
    color: rgb(var(--fg-muted));
  }

  .gallery-viewer {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(var(--ink));
    color: rgb(var(--paper));
  }

  .gallery-viewer::backdrop {
    background: rgb(var(--ink));
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-frame,
    .gallery-frame img {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const items = [...gallery.querySelectorAll<HTMLElement>(".gallery-item")];

    // Reveal each image as it enters
    if (!reduced && "IntersectionObserver" in window) {
      items.forEach((item) => item.setAttribute("data-pending", ""));
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.removeAttribute("data-pending");
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -12% 0px" },
      );
      items.forEach((item) => observer.observe(item));
    }

    // Viewer
    const dialog = gallery.querySelector<HTMLDialogElement>("[data-viewer]")!;
    const images = JSON.parse(dialog.querySelector("[data-images]")!.textContent ?? "[]") as { src: string; alt: string; caption: string }[];
    const image = dialog.querySelector<HTMLImageElement>("[data-viewer-image]")!;
    const caption = dialog.querySelector<HTMLElement>("[data-viewer-caption]")!;
    const count = dialog.querySelector<HTMLElement>("[data-count]")!;
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (index: number) => {
      current = (index + images.length) % images.length;
      const { src, alt, caption: text } = images[current];
      image.src = src;
      image.alt = alt;
      caption.textContent = text;
      count.textContent = `${String(current + 1).padStart(2, "0")} / ${String(images.length).padStart(2, "0")}`;
    };

    gallery.querySelectorAll<HTMLButtonElement>("[data-open-image]").forEach((button) =>
      button.addEventListener("click", () => {
        opener = button;
        show(Number(button.dataset.openImage));
        document.documentElement.style.overflow = "hidden";
        dialog.showModal();
      }),
    );
    dialog.addEventListener("close", () => {
      document.documentElement.style.overflow = "";
      opener?.focus({ preventScroll: true });
    });
    dialog.querySelector("[data-close]")!.addEventListener("click", () => dialog.close());
    dialog.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((button) =>
      button.addEventListener("click", () => show(current + Number(button.dataset.step))),
    );
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") show(current + 1);
      if (event.key === "ArrowLeft") show(current - 1);
    });

    // Swipe between images on touch screens
    let startX: number | null = null;
    const stage = dialog.querySelector<HTMLElement>("[data-stage]")!;
    stage.addEventListener("touchstart", (event) => (startX = event.touches[0].clientX), { passive: true });
    stage.addEventListener("touchend", (event) => {
      if (startX === null) return;
      const dx = event.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
      startX = null;
    });
  });
</script>
