---
import ModelExplorer from "@/components/refresh/ModelExplorer.astro";
import { moduleParts } from "@/data/explorer/module-info";

/**
 * "The module" on /quality/: a typical module from 25 On Rowland and Forrest, separated into its eight systems and fit-out as in
 * the proposal's exploded module. Uses the How It's Made layout and viewer from the home page.
 */
interface Props {
  label?: string;
  body: string;
  /** Divider above the section; off when it follows a full-bleed image. */
  rule?: boolean;
}

const { label = "The module", body, rule = true } = Astro.props;
---

<ModelExplorer
  id="module"
  scene="module"
  rule={rule}
  label={label}
  body={body}
  stageLabel="Typical module, 25 On Rowland and Forrest"
  subject="the module"
  parts={moduleParts}
  partKind="System"
  explodeNote="A typical module with indicative proportions. The fit-out and service routes are illustrative."
  fallback={{
    src: "/explorer/module-rowland.webp",
    alt: "Rendered view of a typical module separated into its systems, with the corrugated roof deck, insulation and plasterboard lifted above the braced steel frame, the clad walls pulled away and the fit-out inside",
    width: 2798,
    height: 1274,
  }}
/>
