---
/**
 * The sourcing route from the supplier panel to site, drawn as one line across where the work happens: solid
 * through Asia, dashed across the sea, solid again in Australia. A trimmed relative of ProgrammeLine, which
 * draws Cloud Modular's split factory and site route.
 * - From lg: the zones sit over the line and each stage is a stop on it. Pointing at, focusing or pressing a stop
 *   shows its sentences in the panel under the route. The line draws in gold as it scrolls into view.
 * - Below lg: a vertical route grouped by zone, with every stage's sentences shown.
 */
interface Props {
  zones: readonly { id: string; label: string }[];
  stages: readonly { zone: string; title: string; body: string }[];
  class?: string;
}

const { zones, stages, class: className } = Astro.props;
const index = (i: number) => String(i + 1).padStart(2, "0");
const counts = zones.map((zone) => stages.filter((stage) => stage.zone === zone.id).length);

// The line, 100 units per stop with each stop at its column's centre: solid, then dashed through the sea zone
const W = stages.length * 100;
const seaStart = counts[0] * 100;
const seaEnd = seaStart + counts[1] * 100;
---

<div class:list={["route", className]} data-route>
  <!-- ============ lg and up ============ -->
  <div class="hidden lg:block">
    <div class="route-zones" style={`grid-template-columns:${counts.map((n) => `${n}fr`).join(" ")}`}>
      {zones.map((zone) => <p class="route-zone label label-muted">{zone.label}</p>)}
    </div>

    <div class="route-track">
      <svg class="route-line" viewBox={`0 0 ${W} 2`} preserveAspectRatio="none" aria-hidden="true">
        <path d={`M50 1 H${seaStart}`} />
        <path d={`M${seaStart} 1 H${seaEnd}`} class="is-sea" />
        <path d={`M${seaEnd} 1 H${W - 50}`} />
      </svg>
      <ol class="route-stops" style={`grid-template-columns:repeat(${stages.length},1fr)`}>
        {stages.map((stage, i) => (
          <li>
            <button type="button" class:list={["route-stop", { "is-active": i === 0 }]} data-stop={i} aria-controls="route-detail" aria-pressed={i === 0 ? "true" : "false"}>
              <span class="route-dot" aria-hidden="true"></span>
              <span class="label route-index">{index(i)}</span>
              <span class="route-title">{stage.title}</span>
            </button>
          </li>
        ))}
      </ol>
    </div>

    <div id="route-detail" class="route-detail grid-12" aria-live="polite">
      {stages.map((stage, i) => (
        <div class:list={["route-panel col-span-12 grid-12", { "is-active": i === 0 }]} data-panel={i} hidden={i !== 0}>
          <p class="label col-span-6">{index(i)} {stage.title}</p>
          <p class="col-span-6 text-about">{stage.body}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- ============ Below lg: vertical route ============ -->
  <ol class="route-v lg:hidden">
    {zones.map((zone) => (
      <li class="route-v-zone">
        <p class="label label-muted">{zone.label}</p>
        <ol class:list={["route-v-stops", { "is-sea": zone.id === "sea" }]}>
          {stages.map((stage, i) => stage.zone === zone.id && (
            <li class="route-v-stop">
              <span class="route-dot" aria-hidden="true"></span>
              <p class="label">{index(i)}</p>
              <p class="mt-2 text-about font-medium">{stage.title}</p>
              <p class="mt-2 max-w-[44ch] text-body text-fg-muted">{stage.body}</p>
            </li>
          ))}
        </ol>
      </li>
    ))}
  </ol>
</div>

<style>
  .route-zones {
    display: grid;
    gap: var(--gap-sm);
  }

  .route-zone {
    padding-top: 1rem;
    border-top: var(--rule) solid rgb(var(--line) / var(--rule-alpha));
  }

  .route-track {
    position: relative;
    margin-top: 3.5rem;
  }

  /* The line runs through the dots' centres (dot 0.75rem, centred at 0.375rem) */
  .route-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0.375rem;
    width: 100%;
    height: 2px;
    overflow: visible;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1.8s var(--ease-out);
  }

  [data-route].is-drawn .route-line {
    clip-path: inset(0 0 0 0);
  }

  .route-line path {
    fill: none;
    stroke: rgb(var(--gold));
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .route-line path.is-sea {
    stroke-dasharray: 4 5;
  }

  .route-stops {
    position: relative;
    display: grid;
    gap: var(--gap-sm);
  }

  .route-stop {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding-bottom: 0.5rem;
    text-align: center;
    cursor: pointer;
  }

  .route-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    border: 1.5px solid rgb(var(--gold));
    background: rgb(var(--surface));
    transition:
      background-color var(--dur-base) var(--ease-standard),
      box-shadow var(--dur-base) var(--ease-standard);
  }

  .route-index {
    margin-top: 1.5rem;
  }

  .route-title {
    margin-top: 0.5rem;
    font-size: var(--text-about);
    line-height: 1.2;
    color: rgb(var(--fg-subtle));
    transition: color var(--dur-base) var(--ease-standard);
  }

  .route-stop:hover .route-title,
  .route-stop.is-active .route-title {
    color: rgb(var(--fg));
  }

  .route-stop.is-active .route-dot {
    background: rgb(var(--gold));
    box-shadow: 0 0 0 5px rgb(var(--gold) / 0.2);
  }

  .route-detail {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: var(--rule) solid rgb(var(--line) / var(--rule-alpha));
    min-height: 9rem;
  }

  .route-panel[hidden] {
    display: none;
  }

  .route-panel.is-active {
    animation: route-in var(--dur-slow) var(--ease-out);
  }

  @keyframes route-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  /* Vertical route: one line down the left, dashed across the sea */
  .route-v {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  @media (min-width: 64rem) {
    .route-v {
      display: none;
    }
  }

  .route-v-stops {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 1.25rem;
    padding-left: 2rem;
  }

  .route-v-stops::before {
    content: "";
    position: absolute;
    left: 0.34rem;
    top: 0.375rem;
    bottom: -2.5rem;
    border-left: 1.5px solid rgb(var(--gold));
  }

  .route-v-stops.is-sea::before {
    border-left-style: dashed;
  }

  .route-v-zone:last-child .route-v-stops::before {
    bottom: auto;
    height: calc(100% - 0.75rem);
  }

  .route-v-stop {
    position: relative;
  }

  .route-v-stop .route-dot {
    position: absolute;
    left: -2rem;
    top: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .route-line {
      transition: none;
    }

    .route-panel.is-active {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-route]").forEach((route) => {
    const stops = [...route.querySelectorAll<HTMLButtonElement>("[data-stop]")];
    const panels = [...route.querySelectorAll<HTMLElement>("[data-panel]")];
    let current = 0;

    const show = (index: number) => {
      if (index === current) return;
      current = index;
      stops.forEach((stop, i) => {
        stop.classList.toggle("is-active", i === index);
        stop.setAttribute("aria-pressed", String(i === index));
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
        panel.classList.toggle("is-active", i === index);
      });
    };

    stops.forEach((stop, i) => {
      stop.addEventListener("click", () => show(i));
      stop.addEventListener("pointerenter", () => show(i));
      stop.addEventListener("focus", () => show(i));
    });

    // Draw the line once the route scrolls into view
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        route.classList.add("is-drawn");
        observer.disconnect();
      },
      { threshold: 0.3 },
    );
    observer.observe(route);
  });
</script>
