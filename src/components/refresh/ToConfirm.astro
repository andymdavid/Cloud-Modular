---
/**
 * Review marker for draft copy: a small dashed gold tag beside anything not yet confirmed. Shown in every build on
 * purpose, so unconfirmed content can't ship unnoticed. Remove it (or the data's `confirm` flag) once checked.
 */
interface Props {
  note?: string;
  class?: string;
}

const { note, class: className } = Astro.props;
---

<span class:list={["to-confirm", className]} title={note}>To confirm{note && <span class="sr-only">: {note}</span>}</span>

<style>
  .to-confirm {
    display: inline-flex;
    align-items: center;
    height: 1.25rem;
    padding-inline: 0.375rem;
    border: 1px dashed rgb(var(--label));
    border-radius: var(--radius-xs);
    color: rgb(var(--label));
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
    vertical-align: middle;
  }
</style>
