---
import ModelExplorer from "@/components/refresh/ModelExplorer.astro";
import { componentOrder, components, views } from "@/data/explorer/jurien-type-b-info";

/**
 * "How it's made" on the home page: the Jurien Bay Type B residence, modelled from its design drawings.
 */
interface Props {
  /** Divider above the section; off when it follows a full-bleed image. */
  rule?: boolean;
  label?: string;
  body?: string;
}

const {
  rule = true,
  label = "How it's made",
  body = "Every Cloud Modular home is designed as a set of modules, manufactured offsite, then assembled on site. This Jurien Bay residence was modelled from its design drawings. Turn it to see each side, or open the 3D view to separate it into parts and look inside each floor.",
} = Astro.props;

const parts = componentOrder.map((id) => ({ id, ...components[id] }));
---

<ModelExplorer
  id="explore"
  scene="jurien"
  rule={rule}
  label={label}
  body={body}
  stageLabel="Seashells Jurien Bay"
  subject="the home"
  parts={parts}
  views={views}
  partKind="Assembly group (illustrative)"
  explodeNote="The separated parts are illustrative, not the actual modules."
  fallback={{
    src: "/explorer/jurien-type-b.webp",
    alt: "Rendered three-quarter view of the Jurien Bay Type B residence model, showing the white-framed balcony, roof terrace pergola and spiral stair at the front",
    width: 1600,
    height: 892,
  }}
/>
