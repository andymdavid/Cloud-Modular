---
import SectionHead from "@/components/refresh/SectionHead.astro";
import ModelExplorer from "@/components/refresh/ModelExplorer.astro";
import type { BuildingType } from "@/data/projects";
import { typeModels } from "@/data/explorer/type-models";

/**
 * A project's building types: chips to pick a type, the wide 3D stage (the size of the home's How It's Made
 * model), then the chosen type's description and figures. A type with a `model` shows it in the stage through
 * ModelExplorer (turn in the page, full 3D view), loading only when its type is first shown; the others show a
 * placeholder until their model exists. With `sharedModel` (a whole building) one stage serves every type, and
 * choosing a type highlights its `highlight` groups in that model. Without JS every type's details show in turn.
 */
import type { TypeModelId } from "@/data/explorer/type-models";
interface Props {
  id?: string;
  label: string;
  title: string;
  intro: string;
  items: readonly BuildingType[];
  sharedModel?: TypeModelId;
  /** Stage name for a shared model. */
  sharedLabel?: string;
}

const { id = "types", label, title, intro, items, sharedModel, sharedLabel = title } = Astro.props;
---

<section id={id} data-theme="light" class="scroll-mt-header pb-section" data-types>
  <div class="shell">
    <SectionHead label={label} title={title} intro={intro} />
    <div class="mt-10 flex flex-wrap gap-1.5" role="tablist" aria-label={label} data-js-only>
      {items.map((item, index) => (
        <button type="button" role="tab" id={`${id}-tab-${item.id}`} data-highlight={item.highlight ? JSON.stringify(item.highlight) : undefined} aria-controls={`${id}-panel-${item.id}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1} class="type-chip" data-type={item.id}>
          {item.name}
        </button>
      ))}
    </div>
  </div>

  <div class="wide-row mt-10" data-reveal>
    {sharedModel ? (
      <div class="type-stage-slot" data-shared-stage data-first>
        <ModelExplorer id={`${id}-model`} bare stageLabel={sharedLabel} {...typeModels[sharedModel]} />
      </div>
    ) : items.map((item, index) => (
      <div class="type-stage-slot" data-stage-for={item.id} data-first={index === 0 ? "" : undefined}>
        {item.model ? (
          <ModelExplorer id={`${id}-model-${item.id}`} bare stageLabel={item.name} {...typeModels[item.model]} />
        ) : (
          <div class="type-stage relative overflow-hidden rounded bg-surface-quiet">
            <p class="label absolute left-4 top-4 sm:left-5 sm:top-5">{item.name}</p>
            <p class="absolute inset-0 flex items-center justify-center text-caption text-fg-muted">3D model in progress</p>
          </div>
        )}
      </div>
    ))}
  </div>

  <div class="shell">
    {items.map((item, index) => (
      <div id={`${id}-panel-${item.id}`} role="tabpanel" aria-labelledby={`${id}-tab-${item.id}`} class="type-panel grid-12 gap-y-8 pt-10" data-panel={item.id} data-first={index === 0 ? "" : undefined}>
        <div class="col-span-12 md:col-span-6">
          <h3 class="text-lead">{item.name}</h3>
          <p class="mt-3 max-w-measure text-body text-fg-muted">{item.body}</p>
        </div>
        <dl class="col-span-12 grid grid-cols-3 gap-x-gap-sm md:col-span-6 md:col-start-7">
          {item.facts.map((fact) => (
            <div class="flex flex-col border-t border-line/[var(--rule-alpha)] pt-4">
              <dt class="order-2 mt-2 text-small text-fg-muted">{fact.label}</dt>
              <dd class="order-1 font-display text-[length:var(--text-h2)] leading-[var(--leading-title)] tabular-nums">{fact.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))}
  </div>
</section>

<style>
  html:not(.js) [data-types] [data-js-only] {
    display: none;
  }

  /* Same size as the module and home 3D stages */
  .type-stage {
    aspect-ratio: 357 / 509;
  }

  @media (min-width: 48rem) {
    .type-stage {
      aspect-ratio: auto;
      height: calc((min(100vw, var(--page-max)) - var(--gutter) - var(--gap-sm)) / 2 * 638 / 690);
    }
  }

  /* With JS, only the chosen type's stage and panel show; without it, only the first stage */
  :global(html.js) [data-types] .type-panel:not([data-active]),
  :global(html.js) [data-types] .type-stage-slot:not([data-active]):not([data-shared-stage]),
  :global(html:not(.js)) [data-types] .type-stage-slot:not([data-first]) {
    display: none;
  }

  .type-chip {
    height: 2rem;
    padding-inline: 0.875rem;
    border: var(--rule) solid rgb(var(--fg) / 0.25);
    border-radius: var(--radius-media);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: rgb(var(--fg));
    transition:
      background-color var(--dur-base) var(--ease-standard),
      border-color var(--dur-base) var(--ease-standard),
      color var(--dur-base) var(--ease-standard);
  }

  .type-chip:hover {
    border-color: rgb(var(--fg));
  }

  .type-chip[aria-selected="true"] {
    background: rgb(var(--fg));
    border-color: rgb(var(--fg));
    color: rgb(var(--surface));
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-types]").forEach((section) => {
    const tabs = [...section.querySelectorAll<HTMLButtonElement>("[data-type]")];
    const panels = [...section.querySelectorAll<HTMLElement>("[data-panel]")];
    const stages = [...section.querySelectorAll<HTMLElement>("[data-stage-for]")];

    const select = (id: string, focus = false) => {
      tabs.forEach((tab) => {
        const on = tab.dataset.type === id;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
      });
      panels.forEach((panel) => panel.toggleAttribute("data-active", panel.dataset.panel === id));
      stages.forEach((stage) => stage.toggleAttribute("data-active", stage.dataset.stageFor === id));
      // A shared model highlights the chosen type's apartments
      const tab = tabs.find((candidate) => candidate.dataset.type === id);
      const explorer = section.querySelector<HTMLElement>("[data-shared-stage] [data-explorer]");
      if (tab?.dataset.highlight && explorer) {
        explorer.dataset.highlight = tab.dataset.highlight;
        explorer.dispatchEvent(new CustomEvent("explorer:highlight", { detail: JSON.parse(tab.dataset.highlight) }));
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab.dataset.type!));
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        select(tabs[(index + step + tabs.length) % tabs.length].dataset.type!, true);
      });
    });
    select(tabs[0].dataset.type!);
  });
</script>
