---
/**
 * Accordion: hairline rows that open to a short answer, with a plus that turns to a minus. Used by FaqSection and
 * by any list of items that each need a few sentences (Ways to engage on /our-approach/).
 */
interface Props {
  items: readonly { title: string; body: string }[];
  /** Give the rows a shared name so opening one closes the others. */
  name?: string;
  /** Start with the first row open. */
  openFirst?: boolean;
  class?: string;
}

const { items, name, openFirst = false, class: className } = Astro.props;
---

<div class:list={["w-full border-b border-line/[var(--rule-alpha)]", className]}>
  {items.map((item, index) => (
    <details class="accordion line-item group" name={name} open={openFirst && index === 0}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 text-body font-medium">
        <span>{item.title}</span>
        <span class="relative h-3 w-3 shrink-0" aria-hidden="true">
          <span class="absolute left-0 top-1/2 h-px w-3 bg-fg"></span>
          <span class="absolute left-1/2 top-0 h-3 w-px bg-fg transition-transform duration-base group-open:scale-y-0"></span>
        </span>
      </summary>
      <p class="max-w-[60ch] pb-5 text-small text-fg-muted">{item.body}</p>
    </details>
  ))}
</div>

<style>
  .accordion summary::-webkit-details-marker {
    display: none;
  }
</style>
