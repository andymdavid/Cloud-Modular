---
import { approachProgramme, approachStages } from "@/data/site";

/**
 * Programme line (/our-approach/): the delivery programme drawn as a route, and the process itself. One line runs
 * through the shared stages, splits into a modules track (Foshan to port) and a site track that run side by side,
 * then rejoins for installation and handover. Order, not scale.
 *
 * Each stage is a container hung from its stop on a short stem, with a + in a circle as the cue that there is
 * more. Site-track stops get smaller containers with no +.
 * - From xl (the ten containers need about 1280px): a horizontal route. Modules containers hang above their
 *   track, shared ones below the centre line, site ones below theirs. Hovering or focusing a container opens a
 *   card with the stage's sentences. The line draws in gold and sage as the diagram scrolls into view.
 * - Below xl: a vertical route in normal flow. Each container expands in place when tapped (one at a time), and
 *   each stretch of line draws as it reaches the reading line.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const stage = (index: string) => approachStages.items.find((item) => item.index === index)!;
const shared = approachProgramme.shared.map(stage);
const modules = approachProgramme.factory.map(stage);
const finish = approachProgramme.finish.map(stage);
const site = approachProgramme.site;

// Desktop geometry: x in percent of the box, y in rem (the box is 26rem tall, so the SVG viewBox is 100 × 26)
const Y = { modules: 7, main: 13, site: 19 };
type Stop = { index?: string; title: string; body?: string; track: "main" | "modules" | "site"; x: number; y: number };
const stops: Stop[] = [
  ...shared.map((item, i) => ({ ...item, track: "main" as const, x: i * 10, y: Y.main })),
  ...modules.map((item, i) => ({ ...item, track: "modules" as const, x: 40 + i * 10, y: Y.modules })),
  ...site.map((title, i) => ({ title, track: "site" as const, x: 40 + i * 10, y: Y.site })),
  ...finish.map((item, i) => ({ ...item, track: "main" as const, x: 80 + i * 10, y: Y.main })),
];
const dMain = `M0 ${Y.main} H30 C35 ${Y.main} 35 ${Y.modules} 40 ${Y.modules} H70 C75 ${Y.modules} 75 ${Y.main} 80 ${Y.main} H90`;
const dSite = `M30 ${Y.main} C35 ${Y.main} 35 ${Y.site} 40 ${Y.site} H70 C75 ${Y.site} 75 ${Y.main} 80 ${Y.main}`;

// Phone geometry: the site rail sits at 58% of the row
const SITE_X = 58;
---

<div class:list={["programme", className]} data-programme>
  <!-- ============ xl and up: horizontal route with hover cards ============ -->
  <div class="pd" data-programme-wide style="--p:1">
    <div class="pd-box">
      {["base", "drawn"].map((layer) => (
        <svg class:list={["pd-lines", `is-${layer}`]} viewBox="0 0 100 26" preserveAspectRatio="none" aria-hidden="true">
          <path d={dSite} class="track-site" />
          <path d={dMain} class="track-main" />
        </svg>
      ))}

      <p class="lane-tag pd-lane pd-lane--modules"><span class="lane-key is-modules" aria-hidden="true"></span>Modules · Foshan</p>
      <p class="lane-tag pd-lane pd-lane--site"><span class="lane-key is-site" aria-hidden="true"></span>Site · Australia</p>

      <ol class="pd-stops">
        {stops.map((stop) => (
          <li
            class:list={["pd-stop", `is-${stop.track}`, stop.track === "modules" ? "is-up" : "is-down", { "is-minor": !stop.index, "is-end": stop.x >= 80 }]}
            style={`--x:${stop.x};--y:${stop.y}`}
            data-stop
            data-at={stop.x / 100}
          >
            <span class="pd-dot" aria-hidden="true"></span>
            <span class="pd-stem" aria-hidden="true"></span>
            <div class="pd-node">
              {stop.index ? (
                <>
                  <button type="button" class="node" aria-describedby={`stage-card-${stop.index}`}>
                    <span class="node-head">
                      <span class="label node-index">{stop.index}</span>
                      <span class="node-plus" aria-hidden="true"></span>
                    </span>
                    <span class="node-title">{stop.title}</span>
                  </button>
                  <div class="pd-card" id={`stage-card-${stop.index}`} role="tooltip">
                    <p class="label">{stop.index}</p>
                    <p class="mt-3 text-body font-medium text-fg">{stop.title}</p>
                    <p class="mt-2 text-small text-fg-muted">{stop.body}</p>
                  </div>
                </>
              ) : (
                <span class="node is-minor"><span class="node-title">{stop.title}</span></span>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <!-- ============ Below xl: vertical route, containers expand in place ============ -->
  <ol class="pv" data-programme-narrow style={`--site-x:${SITE_X}%`}>
    {shared.map((item, i) => (
      <li class:list={["pv-row", { "is-first": i === 0 }]} data-row>
        <span class="pv-rail" aria-hidden="true"></span>
        <span class="pv-dot" aria-hidden="true"></span>
        <span class="pv-stem" aria-hidden="true"></span>
        <details class="node pv-node" name="programme-stage">
          <summary class="pv-summary">
            <span class="label node-index">{item.index}</span>
            <span class="node-title">{item.title}</span>
            <span class="node-plus" aria-hidden="true"></span>
          </summary>
          <p class="pv-body">{item.body}</p>
        </details>
      </li>
    ))}

    <li class="pv-curve" data-row aria-hidden="true">
      {["base", "drawn"].map((layer) => (
        <svg class:list={["pv-lines", `is-${layer}`]} viewBox="0 0 100 10" preserveAspectRatio="none">
          <path d="M0 0 V10" class="track-main" />
          <path d={`M0 0 C0 6 ${SITE_X} 4 ${SITE_X} 10`} class="track-site" />
        </svg>
      ))}
    </li>

    <li class="pv-pair pv-lanes" data-row>
      <div class="pv-cell is-modules"><span class="pv-rail" aria-hidden="true"></span><p class="lane-tag"><span class="lane-key is-modules" aria-hidden="true"></span>Modules · Foshan</p></div>
      <div class="pv-cell is-site"><span class="pv-rail" aria-hidden="true"></span><p class="lane-tag"><span class="lane-key is-site" aria-hidden="true"></span>Site · Australia</p></div>
    </li>

    {modules.map((item, i) => (
      <li class="pv-pair" data-row>
        <div class="pv-cell is-modules">
          <span class="pv-rail" aria-hidden="true"></span>
          <span class="pv-dot" aria-hidden="true"></span>
          <span class="pv-stem" aria-hidden="true"></span>
          <details class="node pv-node" name="programme-stage">
            <summary class="pv-summary">
              <span class="label node-index">{item.index}</span>
              <span class="node-title">{item.title}</span>
              <span class="node-plus" aria-hidden="true"></span>
            </summary>
            <p class="pv-body">{item.body}</p>
          </details>
        </div>
        <div class="pv-cell is-site">
          <span class="pv-rail" aria-hidden="true"></span>
          <span class="pv-dot is-minor" aria-hidden="true"></span>
          <span class="pv-stem" aria-hidden="true"></span>
          <span class="node is-minor pv-node"><span class="node-title">{site[i]}</span></span>
        </div>
      </li>
    ))}

    <li class="pv-curve" data-row aria-hidden="true">
      {["base", "drawn"].map((layer) => (
        <svg class:list={["pv-lines", `is-${layer}`]} viewBox="0 0 100 10" preserveAspectRatio="none">
          <path d="M0 0 V10" class="track-main" />
          <path d={`M${SITE_X} 0 C${SITE_X} 6 0 4 0 10`} class="track-site" />
        </svg>
      ))}
    </li>

    {finish.map((item, i) => (
      <li class:list={["pv-row", { "is-last": i === finish.length - 1 }]} data-row>
        <span class="pv-rail" aria-hidden="true"></span>
        <span class="pv-dot" aria-hidden="true"></span>
        <span class="pv-stem" aria-hidden="true"></span>
        <details class="node pv-node" name="programme-stage">
          <summary class="pv-summary">
            <span class="label node-index">{item.index}</span>
            <span class="node-title">{item.title}</span>
            <span class="node-plus" aria-hidden="true"></span>
          </summary>
          <p class="pv-body">{item.body}</p>
        </details>
      </li>
    ))}
  </ol>

  <p class="mt-10 text-caption text-fg-subtle">Stages are shown in order and not to scale.</p>
</div>

<style>
  .programme {
    --dot: 0.6875rem;
    --stem: 1.25rem;
    --modules: var(--gold);
    --site: var(--sage);
    --base-line: rgb(var(--fg) / 0.18);
    /* Card and open-node fill: the slate lifted a touch towards the text colour */
    --raised: color-mix(in srgb, rgb(var(--surface)) 90%, rgb(var(--fg)));
  }

  /* ---------- Shared: track tags, containers, the + ---------- */

  .lane-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 1.625rem;
    padding-inline: 0.625rem;
    border: var(--rule) solid rgb(var(--fg) / 0.35);
    border-radius: var(--radius-media);
    background: rgb(var(--surface));
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
    color: rgb(var(--fg));
  }

  .lane-key {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    background: rgb(var(--modules));
  }

  .lane-key.is-site {
    background: rgb(var(--site));
  }

  /* The stage container */
  .node {
    --track: var(--modules);
    display: block;
    width: 100%;
    border: 1px solid rgb(var(--fg) / 0.16);
    border-radius: var(--radius-media);
    background: rgb(var(--surface));
    text-align: left;
    transition:
      border-color var(--dur-base) var(--ease-standard),
      background-color var(--dur-base) var(--ease-standard),
      transform var(--dur-base) var(--ease-out);
  }

  .node.is-minor,
  .is-site .node {
    --track: var(--site);
  }

  .node-index {
    color: rgb(var(--fg-subtle));
    transition: color var(--dur-base) var(--ease-standard);
  }

  .node-title {
    display: block;
    color: rgb(var(--fg-muted));
    font-size: var(--text-small);
    line-height: 1.3;
    transition: color var(--dur-base) var(--ease-standard);
  }

  .node.is-minor .node-title {
    font-size: var(--text-caption);
  }

  /* + in a circle; turns to × and fills with the track colour when open */
  .node-plus {
    position: relative;
    flex-shrink: 0;
    width: 1.125rem;
    height: 1.125rem;
    border: 1px solid rgb(var(--fg) / 0.35);
    border-radius: 9999px;
    transition:
      background-color var(--dur-base) var(--ease-standard),
      border-color var(--dur-base) var(--ease-standard),
      transform var(--dur-slow) var(--ease-out);
  }

  .node-plus::before,
  .node-plus::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.5rem;
    height: 1px;
    background: rgb(var(--fg));
    transform: translate(-50%, -50%);
    transition: background-color var(--dur-base) var(--ease-standard);
  }

  .node-plus::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  /* Reached by the drawn line */
  .is-reached .node {
    border-color: rgb(var(--track) / 0.45);
  }

  .is-reached .node-index {
    color: rgb(var(--track));
  }

  .is-reached .node-title {
    color: rgb(var(--fg));
  }

  /* Open (hover, focus or expanded) */
  .pd-node:hover .node,
  .pd-node:focus-within .node,
  .pv-node[open] {
    border-color: rgb(var(--track));
    background: var(--raised);
  }

  .pd-node:hover .node-title,
  .pd-node:focus-within .node-title,
  .pv-node[open] .node-title {
    color: rgb(var(--fg));
  }

  .pd-node:hover .node-plus,
  .pd-node:focus-within .node-plus,
  .pv-node[open] .node-plus {
    border-color: rgb(var(--track));
    background: rgb(var(--track));
    transform: rotate(45deg);
  }

  .pd-node:hover .node-plus::before,
  .pd-node:hover .node-plus::after,
  .pd-node:focus-within .node-plus::before,
  .pd-node:focus-within .node-plus::after,
  .pv-node[open] .node-plus::before,
  .pv-node[open] .node-plus::after {
    background: rgb(var(--surface));
  }

  .node:focus-visible,
  .pv-summary:focus-visible {
    outline: 1px solid rgb(var(--fg) / 0.7);
    outline-offset: 3px;
  }

  /* ---------- xl and up: horizontal ---------- */

  .pd {
    display: none;
  }

  @media (min-width: 80rem) {
    .pd {
      display: block;
    }

    .pv {
      display: none;
    }
  }

  .pd-box {
    position: relative;
    height: 26rem;
    margin-left: 0.875rem;
    container-type: inline-size;
  }

  .pd-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
  }

  .pd-lines path,
  .pv-lines path {
    vector-effect: non-scaling-stroke;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .pd-lines.is-base path,
  .pv-lines.is-base path {
    stroke: var(--base-line);
  }

  .is-drawn .track-main {
    stroke: rgb(var(--modules));
  }

  .is-drawn .track-site {
    stroke: rgb(var(--site));
  }

  .pd-lines.is-drawn {
    clip-path: inset(-5% calc((1 - var(--p)) * 100%) -5% -1%);
  }

  .pd-lane {
    position: absolute;
    left: calc(40% - 0.875rem);
  }

  .pd-lane--modules {
    top: calc(7rem + 1.125rem);
  }

  .pd-lane--site {
    top: calc(19rem - 1.125rem - 1.625rem);
  }

  /* Each stop is a zero-size anchor at its point on the line */
  .pd-stop {
    position: absolute;
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1rem);
    width: 0;
    height: 0;
  }

  .pd-dot {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--dot);
    height: var(--dot);
    border-radius: 9999px;
    border: 1.5px solid rgb(var(--fg) / 0.3);
    background: rgb(var(--surface));
    transform: translate(-50%, -50%);
    transition:
      background-color var(--dur-base) var(--ease-standard),
      border-color var(--dur-base) var(--ease-standard);
  }

  .pd-stop.is-minor .pd-dot {
    --dot: 0.5rem;
  }

  .pd-stem {
    position: absolute;
    left: -0.5px;
    width: 1px;
    height: var(--stem);
    background: var(--base-line);
    transition: background-color var(--dur-base) var(--ease-standard);
  }

  .is-down .pd-stem {
    top: calc(var(--dot) / 2);
  }

  .is-up .pd-stem {
    bottom: calc(var(--dot) / 2);
  }

  .pd-node {
    position: absolute;
    left: -0.875rem;
    width: calc(10cqi - 0.625rem);
  }

  .is-down .pd-node {
    top: calc(var(--dot) / 2 + var(--stem));
  }

  .is-up .pd-node {
    bottom: calc(var(--dot) / 2 + var(--stem));
  }

  .pd-node .node {
    padding: 0.625rem 0.75rem 0.75rem;
    cursor: pointer;
  }

  .pd-node .node.is-minor {
    padding: 0.5rem 0.75rem;
    cursor: default;
  }

  .node-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .pd-node:hover .node,
  .pd-node:focus-within .node {
    transform: translateY(-2px);
  }

  .pd-node .node-title {
    font-size: 0.8125rem;
  }

  @media (min-width: 90rem) {
    .pd-node .node-title {
      font-size: var(--text-small);
    }
  }

  .pd-node .node.is-minor .node-title {
    font-size: var(--text-caption);
  }

  .pd-stop.is-reached .pd-dot {
    border-color: rgb(var(--modules));
    background: rgb(var(--modules));
  }

  .pd-stop.is-site.is-reached .pd-dot {
    border-color: rgb(var(--site));
    background: rgb(var(--site));
  }

  .pd-stop.is-reached .pd-stem {
    background: rgb(var(--modules));
  }

  .pd-stop.is-site.is-reached .pd-stem {
    background: rgb(var(--site));
  }

  /* Hover card: below the container for shared stops, into the open middle for modules stops */
  .pd-card {
    --gap: 0.5rem;
    position: absolute;
    z-index: 5;
    left: 0;
    top: calc(100% + var(--gap));
    width: 17.5rem;
    padding: 1.25rem 1.25rem 1.375rem;
    border: 1px solid rgb(var(--fg) / 0.12);
    border-radius: var(--radius-media);
    background: var(--raised);
    box-shadow: 0 1.5rem 3rem -1rem rgb(0 0 0 / 0.55);
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.375rem);
    pointer-events: none;
    transition:
      opacity var(--dur-base) var(--ease-out) 120ms,
      transform var(--dur-base) var(--ease-out) 120ms,
      visibility 0s linear calc(var(--dur-base) + 120ms);
  }

  .is-up .pd-card {
    --gap: calc(var(--stem) + var(--dot) + 0.625rem);
  }

  .is-end .pd-card {
    left: auto;
    right: 0;
  }

  /* An invisible bridge across the gap keeps the card open while the pointer travels to it */
  .pd-card::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: calc(var(--gap) + 2px);
  }

  .pd-node:hover .pd-card,
  .pd-node:focus-within .pd-card {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      visibility 0s;
  }

  .pd-node:hover,
  .pd-node:focus-within {
    z-index: 4;
  }

  /* ---------- Below xl: vertical, in flow ---------- */

  .pv {
    --dot-y: 1.4rem;
    margin-left: calc(var(--dot) / 2);
  }

  .pv-row,
  .pv-cell {
    position: relative;
    padding-bottom: 0.75rem;
  }

  .pv-pair {
    display: grid;
    grid-template-columns: var(--site-x) 1fr;
  }

  .pv-cell.is-modules {
    padding-right: 1rem;
  }

  /* Rails: a faint base, with the drawn colour growing down over it once the row is reached */
  .pv-rail {
    position: absolute;
    left: -0.75px;
    top: 0;
    bottom: 0;
    width: 1.5px;
    background: var(--base-line);
  }

  .pv-rail::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgb(var(--modules));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--dur-reveal) var(--ease-out);
  }

  .pv-cell.is-site .pv-rail::after {
    background: rgb(var(--site));
  }

  .pv-row.is-first .pv-rail {
    top: var(--dot-y);
  }

  .pv-row.is-last .pv-rail {
    bottom: auto;
    height: var(--dot-y);
  }

  .pv-dot {
    position: absolute;
    left: 0;
    top: var(--dot-y);
    width: var(--dot);
    height: var(--dot);
    border-radius: 9999px;
    border: 1.5px solid rgb(var(--fg) / 0.3);
    background: rgb(var(--surface));
    transform: translate(-50%, -50%);
    transition:
      background-color var(--dur-base) var(--ease-standard),
      border-color var(--dur-base) var(--ease-standard);
  }

  .pv-dot.is-minor {
    --dot: 0.5rem;
  }

  .pv-stem {
    position: absolute;
    left: calc(var(--dot) / 2);
    top: var(--dot-y);
    width: calc(1.125rem - var(--dot) / 2);
    height: 1px;
    background: var(--base-line);
    transition: background-color var(--dur-base) var(--ease-standard);
  }

  .pv-node {
    margin-left: 1.125rem;
    width: auto;
  }

  .pv-summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.8rem;
    padding: 0.625rem 0.75rem;
    cursor: pointer;
    list-style: none;
  }

  .pv-summary::-webkit-details-marker {
    display: none;
  }

  .pv-summary .node-title {
    flex: 1;
  }

  .pv-node.is-minor {
    display: flex;
    align-items: center;
    min-height: 2.8rem;
    padding: 0.5rem 0.75rem;
  }

  .pv-body {
    padding: 0 0.75rem 0.875rem 2.6rem;
    font-size: var(--text-small);
    line-height: var(--leading-snug);
    color: rgb(var(--fg-muted));
  }

  .pv-lanes .pv-cell {
    padding-bottom: 1rem;
    padding-top: 0.25rem;
  }

  .pv-lanes .lane-tag {
    margin-left: 1.125rem;
  }

  /* The site tag sits against the right margin so it never runs off narrow screens */
  .pv-lanes .pv-cell.is-site {
    display: flex;
    justify-content: flex-end;
  }

  .pv-lanes .lane-tag {
    gap: 0.375rem;
    padding-inline: 0.5rem;
  }

  .pv-lanes .pv-cell.is-site .lane-tag {
    margin-left: 0.25rem;
  }

  .pv-curve {
    position: relative;
    height: 2.75rem;
  }

  .pv-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
  }

  .pv-lines.is-drawn {
    clip-path: inset(0 -2% 100% -2%);
    transition: clip-path var(--dur-reveal) var(--ease-out);
  }

  .is-reached > .pv-lines.is-drawn {
    clip-path: inset(0 -2% 0 -2%);
  }

  .is-reached > .pv-rail::after,
  .is-reached > .pv-cell > .pv-rail::after {
    transform: scaleY(1);
  }

  .is-reached > .pv-dot,
  .is-reached > .pv-cell.is-modules > .pv-dot {
    border-color: rgb(var(--modules));
    background: rgb(var(--modules));
  }

  .is-reached > .pv-cell.is-site > .pv-dot {
    border-color: rgb(var(--site));
    background: rgb(var(--site));
  }

  .is-reached > .pv-stem,
  .is-reached > .pv-cell.is-modules > .pv-stem {
    background: rgb(var(--modules));
  }

  .is-reached > .pv-cell.is-site > .pv-stem {
    background: rgb(var(--site));
  }

  .is-reached > .pv-node,
  .is-reached > .pv-cell > .pv-node {
    border-color: rgb(var(--track) / 0.45);
  }

  .is-reached > .pv-node .node-index,
  .is-reached > .pv-cell > .pv-node .node-index {
    color: rgb(var(--track));
  }

  .is-reached > .pv-node .node-title,
  .is-reached > .pv-cell > .pv-node .node-title {
    color: rgb(var(--fg));
  }

  /* Expand smoothly where the browser can animate to auto height */
  @supports (interpolate-size: allow-keywords) {
    .pv-node {
      interpolate-size: allow-keywords;
    }

    .pv-node::details-content {
      height: 0;
      overflow: hidden;
      transition:
        height var(--dur-slow) var(--ease-out),
        content-visibility var(--dur-slow) allow-discrete;
    }

    .pv-node[open]::details-content {
      height: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .node,
    .node-plus,
    .pd-card,
    .pd-dot,
    .pd-stem,
    .pv-dot,
    .pv-stem,
    .pv-rail::after,
    .pv-lines.is-drawn,
    .pv-node::details-content {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-programme]").forEach((root) => {
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");
    const wide = root.querySelector<HTMLElement>("[data-programme-wide]");
    const box = wide?.querySelector<HTMLElement>(".pd-box");
    const stops = [...root.querySelectorAll<HTMLElement>("[data-stop]")];
    const rows = [...root.querySelectorAll<HTMLElement>("[data-row]")];
    let frame = 0;

    const update = () => {
      frame = 0;
      const line = window.innerHeight * 0.7;

      // Horizontal: the whole line draws while the diagram rises from the bottom of the viewport to the reading line
      if (wide && box && wide.offsetParent) {
        let p = 1;
        if (!still.matches) {
          const rect = box.getBoundingClientRect();
          p = Math.min(1, Math.max(0, (window.innerHeight - rect.top) / (window.innerHeight - line + rect.height)));
        }
        wide.style.setProperty("--p", p.toFixed(4));
        for (const stop of stops) stop.classList.toggle("is-reached", p >= Number(stop.dataset.at) - 0.001);
      }

      // Vertical: each stretch draws as it reaches the reading line
      for (const row of rows) row.classList.toggle("is-reached", still.matches || row.getBoundingClientRect().top < line);
    };
    const request = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    // Escape closes an open card by moving focus off it
    root.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && root.contains(document.activeElement)) (document.activeElement as HTMLElement).blur();
    });

    window.addEventListener("scroll", request, { passive: true });
    window.addEventListener("resize", request);
    update();
  });
</script>
