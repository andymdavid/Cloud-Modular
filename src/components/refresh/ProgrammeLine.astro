---
import { approachProgramme, approachStages } from "@/data/site";

/**
 * Programme line (/our-approach/): the delivery programme drawn as a route. One line runs through the shared
 * stages, splits into a modules track (Foshan to port) and a site track that run side by side, then rejoins for
 * installation and handover. The line draws in gold and sage as the diagram scrolls through the viewport, and each
 * stop lights up as the line reaches it. Horizontal from md; vertical on phones. Order, not scale.
 *
 * It is also the process. Each numbered stop is a button that opens that stage's paragraph and image in the panel
 * under the diagram (the first is open to start). Without JavaScript every panel shows, one after another.
 *
 * Geometry is in percent of the diagram box. Desktop: ten columns (three shared, a split, three tracked, a merge,
 * two shared), with the modules track above the centre line and the site track below. Phones: ten rows, the
 * modules track running straight down the left and the site track branching to the right.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const stage = (index: string) => approachStages.items.find((item) => item.index === index)!;

type Stop = { index?: string; title: string; track: "main" | "modules" | "site"; x: number; y: number; mx: number; my: number };
const row = (r: number) => 5 + r * 10;
const stops: Stop[] = [
  ...approachProgramme.shared.map((index, i) => ({ index, title: stage(index).title, track: "main" as const, x: i * 10, y: 50, mx: 0, my: row(i) })),
  ...approachProgramme.factory.map((index, i) => ({ index, title: stage(index).title, track: "modules" as const, x: 40 + i * 10, y: 22, mx: 0, my: row(4 + i) })),
  ...approachProgramme.site.map((title, i) => ({ title, track: "site" as const, x: 40 + i * 10, y: 78, mx: 52, my: row(4 + i) })),
  ...approachProgramme.finish.map((index, i) => ({ index, title: stage(index).title, track: "main" as const, x: 80 + i * 10, y: 50, mx: 0, my: row(8 + i) })),
];

// Desktop paths (viewBox 0 0 100 100, stretched)
const dMain = "M0 50 H30 C35 50 35 22 40 22 H70 C75 22 75 50 80 50 H90";
const dSite = "M30 50 C35 50 35 78 40 78 H70 C75 78 75 50 80 50";
// Phone paths
const mMain = "M0 5 V95";
const mSite = "M0 28 C0 33 52 33 52 38 V68 C52 74 0 74 0 80";
---

<div class:list={["programme", className]} data-programme style="--p:1">
  <div class="programme-box">
    <!-- Lines: a faint base, then the drawn copy clipped to the scroll progress -->
    {["base", "drawn"].map((layer) => (
      <>
        <svg class:list={["programme-lines programme-lines--wide", `is-${layer}`]} viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <path d={dSite} class="track-site" />
          <path d={dMain} class="track-main" />
        </svg>
        <svg class:list={["programme-lines programme-lines--narrow", `is-${layer}`]} viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <path d={mSite} class="track-site" />
          <path d={mMain} class="track-main" />
        </svg>
      </>
    ))}

    <p class="programme-lane programme-lane--modules"><span class="programme-lane-key" aria-hidden="true"></span>Modules · Foshan</p>
    <p class="programme-lane programme-lane--site"><span class="programme-lane-key" aria-hidden="true"></span>Site · Australia</p>

    <ol class="programme-stops">
      {stops.map((stop) => (
        <li
          class:list={["programme-stop", `is-${stop.track}`, { "is-minor": !stop.index }]}
          style={`--x:${stop.x};--y:${stop.y};--mx:${stop.mx};--my:${stop.my}`}
          data-stop
          data-x={stop.x / 100}
          data-y={stop.my / 100}
        >
          <span class="programme-dot" aria-hidden="true"></span>
          <span class="programme-text">
            {stop.index && <span class="label programme-index">{stop.index}</span>}
            <span class="programme-title">{stop.title}</span>
          </span>
          {stop.index && (
            <button
              type="button"
              class="programme-hit"
              data-stage-select={stop.index}
              aria-controls={`stage-${stop.index}`}
              aria-pressed={stop.index === "01" ? "true" : "false"}
            >
              <span class="sr-only">Stage {stop.index}, {stop.title}</span>
            </button>
          )}
        </li>
      ))}
    </ol>
  </div>

  <p class="mt-8 text-caption text-fg-subtle">Stages are shown in order and not to scale.</p>

  <!-- The selected stage: copy left, image from the centre line -->
  <div class="programme-detail rule mt-section-sm pt-10 sm:pt-12" data-stage-detail>
    {approachStages.items.map((item, index) => (
      <article id={`stage-${item.index}`} class="programme-panel grid-12 gap-y-8" data-stage-panel={item.index} aria-live="polite">
        <div class="col-span-12 flex flex-col md:col-span-5">
          <p class="label">{item.index} <span class="text-fg-subtle">/ {String(approachStages.items.length).padStart(2, "0")}</span></p>
          <h3 class="mt-5 text-h3">{item.title}</h3>
          <p class="mt-4 max-w-measure text-body text-fg-muted">{item.body}</p>
          <div class="programme-controls mt-8 flex gap-1 md:mt-auto md:pt-8">
            <button type="button" class="icon-btn" data-stage-step="-1" aria-label="Previous stage" disabled={index === 0}>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M8.5 2.5 4 7l4.5 4.5" stroke="currentColor" stroke-width="1.2" /></svg>
            </button>
            <button type="button" class="icon-btn" data-stage-step="1" aria-label="Next stage" disabled={index === approachStages.items.length - 1}>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M5.5 2.5 10 7l-4.5 4.5" stroke="currentColor" stroke-width="1.2" /></svg>
            </button>
          </div>
        </div>
        <div class="col-span-12 md:col-span-6 md:col-start-7">
          <div class="aspect-[3/2] overflow-hidden rounded bg-surface-alt">
            <img src={item.image} alt={item.alt} width={item.width} height={item.height} loading="lazy" class="h-full w-full object-cover" />
          </div>
        </div>
      </article>
    ))}
  </div>
</div>

<style>
  .programme {
    --dot: 0.6875rem;
    --modules: var(--gold);
    --site: var(--sage);
  }

  /* Inset by half a dot so the first stop isn't clipped */
  .programme-box {
    position: relative;
    margin-left: calc(var(--dot) / 2);
    height: 47rem;
  }

  @media (min-width: 48rem) {
    .programme-box {
      height: clamp(28rem, 20rem + 12vw, 36rem);
      margin-right: 0;
    }
  }

  /* Lines */
  .programme-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
  }

  .programme-lines path {
    vector-effect: non-scaling-stroke;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .programme-lines.is-base path {
    stroke: rgb(var(--fg) / 0.18);
  }

  .programme-lines.is-drawn .track-main {
    stroke: rgb(var(--modules));
  }

  .programme-lines.is-drawn .track-site {
    stroke: rgb(var(--site));
  }

  /* Draw down on phones, across from md */
  .programme-lines.is-drawn {
    clip-path: inset(0 -2% calc((1 - var(--p)) * 100%) -2%);
  }

  .programme-lines--wide {
    display: none;
  }

  @media (min-width: 48rem) {
    .programme-lines--wide {
      display: block;
    }

    .programme-lines--narrow {
      display: none;
    }

    .programme-lines.is-drawn {
      clip-path: inset(-5% calc((1 - var(--p)) * 100%) -5% -1%);
    }
  }

  /* Track names */
  /* Track names: outlined tags, as on the home page project cards, keyed by the track colour */
  .programme-lane {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 1.625rem;
    padding-inline: 0.625rem;
    border: var(--rule) solid rgb(var(--fg) / 0.35);
    border-radius: var(--radius-media);
    background: rgb(var(--surface));
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
    color: rgb(var(--fg));
  }

  .programme-lane-key {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    background: rgb(var(--modules));
  }

  .programme-lane--site .programme-lane-key {
    background: rgb(var(--site));
  }

  .programme-lane--modules {
    top: 38.75%;
    left: 1.25rem;
  }

  .programme-lane--site {
    top: 38.75%;
    left: calc(52% + 1.25rem);
  }

  @media (min-width: 48rem) {
    /* Above the first stop of each track */
    .programme-lane--modules {
      top: calc(22% - 3.25rem);
      left: 40%;
    }

    .programme-lane--site {
      top: calc(78% - 3.25rem);
      left: 40%;
    }
  }

  /* Stops */
  /* Phones: shared stops can use the full width; the two tracks share it */
  .programme-stop {
    position: absolute;
    left: calc(var(--mx) * 1%);
    top: calc(var(--my) * 1%);
    width: calc(100% - 1.25rem);
  }

  .programme-stop.is-modules,
  .programme-stop.is-site {
    width: calc(48% - 1.25rem);
  }

  .programme-dot {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--dot);
    height: var(--dot);
    border-radius: 9999px;
    border: 1.5px solid rgb(var(--fg) / 0.3);
    background: rgb(var(--surface));
    transform: translate(-50%, -50%);
    transition:
      background-color var(--dur-base) var(--ease-standard),
      border-color var(--dur-base) var(--ease-standard),
      box-shadow var(--dur-slow) var(--ease-out);
  }

  .programme-stop.is-minor .programme-dot {
    --dot: 0.5rem;
  }

  .programme-text {
    position: absolute;
    left: 1.25rem;
    top: 0;
    transform: translateY(-0.55rem);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    width: 100%;
  }

  .programme-index {
    color: rgb(var(--fg-subtle));
    transition: color var(--dur-base) var(--ease-standard);
  }

  .programme-title {
    font-size: var(--text-small);
    line-height: var(--leading-snug);
    color: rgb(var(--fg-muted));
    transition: color var(--dur-base) var(--ease-standard);
  }

  .programme-stop.is-minor .programme-title {
    transform: translateY(0.05rem);
  }

  @media (min-width: 48rem) {
    .programme-stop,
    .programme-stop.is-modules,
    .programme-stop.is-site {
      left: calc(var(--x) * 1%);
      top: calc(var(--y) * 1%);
      width: 10%;
    }

    .programme-text {
      left: 0;
      top: 1.5rem;
      transform: none;
      padding-right: 1rem;
    }
  }

  @media (min-width: 80rem) {
    .programme-title {
      font-size: var(--text-body);
    }
  }

  /* Hit area over each numbered stop (dot and label) */
  .programme-hit {
    position: absolute;
    left: -0.75rem;
    top: -0.75rem;
    width: calc(100% + 1rem);
    height: 3.5rem;
    border-radius: var(--radius-media);
    cursor: pointer;
  }

  @media (min-width: 48rem) {
    .programme-hit {
      height: 6.25rem;
    }
  }

  .programme-hit:focus-visible {
    outline: 1px solid rgb(var(--fg) / 0.6);
    outline-offset: 2px;
  }

  @media (hover: hover) {
    .programme-stop:has(.programme-hit:hover) .programme-title {
      color: rgb(var(--fg));
    }
  }

  /* Selected stage: a wider ring on the dot and a full-colour title */
  .programme-stop.is-selected .programme-dot,
  .programme-stop.is-reached.is-selected .programme-dot {
    border-color: rgb(var(--modules));
    background: rgb(var(--modules));
    box-shadow: 0 0 0 0.3125rem rgb(var(--surface)), 0 0 0 0.40625rem rgb(var(--modules));
  }

  .programme-stop.is-selected .programme-title {
    color: rgb(var(--fg));
  }

  /* Detail panels: one at a time once the script runs */
  .programme-panel + .programme-panel {
    margin-top: var(--section-sm);
  }

  [data-stage-detail].is-ready .programme-panel {
    margin-top: 0;
  }

  [data-stage-detail].is-ready .programme-panel:not(.is-active) {
    display: none;
  }

  .programme-controls {
    display: none;
  }

  [data-stage-detail].is-ready .programme-controls {
    display: flex;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-stage-detail].is-ready .programme-panel.is-active {
      animation: stage-in var(--dur-slow) var(--ease-out) both;
    }
  }

  @keyframes stage-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Reached */
  .programme-stop.is-reached .programme-dot {
    border-color: rgb(var(--modules));
    background: rgb(var(--modules));
    box-shadow: 0 0 0 0.375rem rgb(var(--modules) / 0.16);
  }

  .programme-stop.is-site.is-reached .programme-dot {
    border-color: rgb(var(--site));
    background: rgb(var(--site));
    box-shadow: 0 0 0 0.3rem rgb(var(--site) / 0.16);
  }

  .programme-stop.is-reached .programme-index {
    color: rgb(var(--modules));
  }


  @media (prefers-reduced-motion: reduce) {
    .programme-dot,
    .programme-index,
    .programme-title {
      transition: none;
    }
  }
</style>

<script>
  // Tie the drawn line to scroll: it reaches each stop as that part of the diagram passes 70% down the viewport
  document.querySelectorAll<HTMLElement>("[data-programme]").forEach((root) => {
    const box = root.querySelector<HTMLElement>(".programme-box")!;
    const stops = [...root.querySelectorAll<HTMLElement>("[data-stop]")];
    const wide = window.matchMedia("(min-width: 48rem)");
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");
    let frame = 0;

    const update = () => {
      frame = 0;
      let p = 1;
      if (!still.matches) {
        const rect = box.getBoundingClientRect();
        const line = window.innerHeight * 0.7;
        // Phones: progress follows the reading line down the diagram. Desktop: the whole line draws while the
        // diagram rises from the bottom of the viewport to the reading line.
        p = wide.matches
          ? (window.innerHeight - rect.top) / (window.innerHeight - line + rect.height)
          : (line - rect.top) / rect.height;
        p = Math.min(1, Math.max(0, p));
      }
      root.style.setProperty("--p", p.toFixed(4));
      for (const stop of stops) {
        const at = Number(wide.matches ? stop.dataset.x : stop.dataset.y);
        stop.classList.toggle("is-reached", p >= at - 0.001);
      }
    };
    const request = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    // Stage selection: the stops and the previous/next buttons choose which panel shows
    const detail = root.querySelector<HTMLElement>("[data-stage-detail]");
    const panels = [...root.querySelectorAll<HTMLElement>("[data-stage-panel]")];
    const order = panels.map((panel) => panel.dataset.stagePanel!);
    const select = (index: string, reveal: boolean) => {
      for (const panel of panels) panel.classList.toggle("is-active", panel.dataset.stagePanel === index);
      for (const button of root.querySelectorAll<HTMLButtonElement>("[data-stage-select]")) {
        const on = button.dataset.stageSelect === index;
        button.setAttribute("aria-pressed", String(on));
        button.closest("[data-stop]")?.classList.toggle("is-selected", on);
      }
      // On phones the panel sits below a tall diagram, so bring it into view
      if (reveal && detail && !wide.matches) {
        const top = detail.getBoundingClientRect().top;
        if (top > window.innerHeight * 0.6) detail.scrollIntoView({ behavior: still.matches ? "auto" : "smooth", block: "start" });
      }
    };
    root.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const stop = target.closest<HTMLElement>("[data-stage-select]");
      if (stop) return select(stop.dataset.stageSelect!, true);
      const step = target.closest<HTMLElement>("[data-stage-step]");
      if (step) {
        const current = panels.find((panel) => panel.classList.contains("is-active"))?.dataset.stagePanel ?? order[0];
        const next = order[order.indexOf(current) + Number(step.dataset.stageStep)];
        if (next) select(next, false);
      }
    });
    detail?.classList.add("is-ready");
    select(order[0], false);

    window.addEventListener("scroll", request, { passive: true });
    window.addEventListener("resize", request);
    wide.addEventListener("change", request);
    update();
  });
</script>
