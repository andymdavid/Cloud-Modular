---
/**
 * Legal page body (Privacy Policy, Terms): one split section per heading, its paragraphs and any list on the right.
 */
import SplitSection from "@/components/refresh/SplitSection.astro";
import type { LegalSection } from "@/data/legal";

interface Props {
  sections: LegalSection[];
}

const { sections } = Astro.props;
---

{sections.map((section, index) => (
  <SplitSection label={section.title} rule={index > 0}>
    <div class="max-w-measure space-y-5 text-body text-fg-muted">
      {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      {section.list && (
        <ul class="w-full">
          {section.list.map((item) => <li class="border-t border-line/[var(--rule-alpha)] py-3">{item}</li>)}
        </ul>
      )}
    </div>
  </SplitSection>
))}
