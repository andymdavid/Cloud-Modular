---
import { partners } from "@/data/site";

/**
 * Delivery partner logos in a grid of hairline-topped cells, every logo in one brand colour (an alpha mask
 * filled with gold), so mixed artwork reads as one set. Sizes are balanced by aspect ratio: wide wordmarks get
 * less height than square badges, so each logo carries a similar visual weight.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Size by aspect (wide wordmarks get less height than square badges), then by ink: dense, heavy marks are
// scaled down and light, open ones up, so each logo carries a similar weight.
const sized = partners.map((partner) => {
  const aspect = partner.width / partner.height;
  const ink = Math.min(1.3, Math.max(0.75, Math.sqrt(0.25 / partner.ink)));
  const height = Math.min(3.6, 3.6 * Math.pow(aspect, -0.45)) * ink; // rem at desktop
  const width = Math.min(11, height * aspect);
  return { ...partner, w: width, h: width / aspect };
});
---

<ul class:list={["grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5", className]} aria-label="Delivery partners">
  {sized.map((partner, index) => (
    <li class="partner-cell flex items-center justify-center border-t border-line/[var(--rule-alpha)]" data-reveal style={`--reveal-delay:${(index % 5) * 60}ms`}>
      <span
        role="img"
        aria-label={partner.name}
        class="partner-logo block"
        style={`--w:${partner.w.toFixed(2)}rem;--h:${partner.h.toFixed(2)}rem;--logo:url(/partners/${partner.slug}.png)`}
      ></span>
    </li>
  ))}
  <!-- Empty cells complete the last row, so its rule runs the full width (two columns, three, then five) -->
  {Array.from({ length: (2 - (sized.length % 2)) % 2 }, () => <li class="partner-cell border-t border-line/[var(--rule-alpha)] md:hidden" aria-hidden="true"></li>)}
  {Array.from({ length: (3 - (sized.length % 3)) % 3 }, () => <li class="partner-cell hidden border-t border-line/[var(--rule-alpha)] md:block lg:hidden" aria-hidden="true"></li>)}
  {Array.from({ length: (5 - (sized.length % 5)) % 5 }, () => <li class="partner-cell hidden border-t border-line/[var(--rule-alpha)] lg:block" aria-hidden="true"></li>)}
</ul>

<style>
  .partner-cell {
    aspect-ratio: 3 / 2;
  }

  @media (min-width: 64rem) {
    .partner-cell {
      aspect-ratio: 2 / 1;
    }
  }

  .partner-logo {
    --scale: 0.78;
    width: calc(var(--w) * var(--scale));
    height: calc(var(--h) * var(--scale));
    background: rgb(var(--gold));
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }

  @media (min-width: 48rem) {
    .partner-logo {
      --scale: 1;
    }
  }
</style>
