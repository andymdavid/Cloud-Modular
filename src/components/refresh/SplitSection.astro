---
/**
 * Split section (olympic.no "Olympic Subsea ASA"): the label in the left half (it's the section heading), the
 * content in the right half. Used by About, How It's Made, FAQ and most text sections. Stacks on phones.
 */
interface Props {
  id?: string;
  label: string;
  /** Divider above the section; off as the first section after a full-bleed hero or dark band. */
  rule?: boolean;
  /** "section" (full section rhythm) or "tight" (short top pad, straight after a full-bleed hero). */
  spacing?: "section" | "tight";
  class?: string;
}

const { id, label, rule = true, spacing = "section", class: className } = Astro.props;
---

<section id={id} data-theme="light" class:list={["scroll-mt-header", spacing === "tight" ? "pb-12 pt-gutter" : "pb-section", className]}>
  <div class="shell">
    <div class:list={["grid-12 gap-y-6", { rule, "pt-section": spacing === "section" }]}>
      <h2 class="label col-span-12 md:col-span-6" data-reveal>{label}</h2>
      <div class="col-span-12 flex flex-col items-start md:col-span-6 md:col-start-7" data-reveal>
        <slot />
      </div>
    </div>
  </div>
</section>
