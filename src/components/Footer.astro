---
import { footerNavigation, site } from "@/data/site";
---

<footer class="bg-black text-white">
  <div class="border-t border-white/5"></div>
  <div class="mx-auto w-full max-w-[1200px] px-8 py-16 sm:px-10 lg:px-12">
    <div class="grid gap-10 md:grid-cols-[40%_1fr_1fr_1fr]">
      <div>
        <a href="/" class="inline-block">
          <img src="/logo.webp" alt="Cloud Modular" width="160" height="40" class="h-8 w-auto" />
        </a>
        <p class="mt-4 max-w-sm font-sans text-[12px] leading-[18px] text-white/70 sm:text-[13px] sm:leading-[19px]">
          Thoughtful design, precise manufacturing<br />and dependable delivery.
        </p>
      </div>

      <div>
        <p class="footer-title">Discover</p>
        <ul class="mt-4 space-y-3 font-sans text-[12px] leading-[18px] text-white/70">
          {footerNavigation.map((link) => <li><a class="transition-colors hover:text-white" href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>

      <div>
        <p class="footer-title">Connect</p>
        <ul class="mt-4 space-y-3 font-sans text-[12px] leading-[18px] text-white/70">
          <li><a class="transition-colors hover:text-white" href="/partner-with-us/">Contact Us</a></li>
          <li><a class="transition-colors hover:text-white" href={site.linkedIn} target="_blank" rel="noreferrer">LinkedIn</a></li>
        </ul>
      </div>

      <div>
        <p class="footer-title">Address</p>
        <div class="mt-4 space-y-4">
          {site.offices.map((office) => (
            <div>
              <p class="mb-2 font-host-grotesk text-[14px] font-medium leading-4 tracking-[-0.03em] text-white/70">{office.city}</p>
              {office.lines.map((line) => <p class="font-sans text-[12px] leading-[18px] text-white/70">{line}</p>)}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  <div class="border-t border-white/5 py-3 text-center font-sans text-[12px] leading-[18px] text-white/40">
    © {new Date().getFullYear()} Cloud Modular. All rights reserved.
  </div>
</footer>
