---
import ProductArt from "@/components/living/ProductArt.astro";
import { artOf, formatPrice, productBySlug, shopTheRoom } from "@/data/living";

/**
 * Shop the room (cf. the Wonder theme): a styled room with its products marked. Each marker names the product and
 * links to it; the list beside the image holds the same products with an add button. Hovering either one lights
 * up its partner.
 */
const spots = shopTheRoom.spots.map((spot, index) => ({ ...spot, n: index + 1, item: productBySlug(spot.product) }));
---

<section id="shop-the-room" data-theme="light" class="scroll-mt-header pb-section" data-room>
  <div class="shell">
    <div class="rule grid-12 gap-y-10 pt-section">
      <div class="col-span-12 lg:col-span-8" data-reveal>
        <div class="room-image relative overflow-hidden rounded bg-stone">
          <img src={shopTheRoom.image} alt={shopTheRoom.alt} width={shopTheRoom.width} height={shopTheRoom.height} loading="lazy" class="h-full w-full object-cover" />
          {spots.map((spot) => (
            <a href={`/living/products/${spot.item.slug}/`} class="room-spot" style={`left:${spot.x}%;top:${spot.y}%`} data-spot={spot.n}>
              <span class="room-spot-dot" aria-hidden="true">{spot.n}</span>
              <span class="room-spot-tip">{spot.item.name}<span class="tabular-nums text-fg-muted">{formatPrice(spot.item.price)}</span></span>
            </a>
          ))}
        </div>
      </div>

      <div class="col-span-12 flex flex-col lg:col-span-4 lg:pl-gap" data-reveal>
        <p class="label">Shop the room</p>
        <h2 class="mt-6 text-h2">The bedroom</h2>
        <p class="mt-6 max-w-[34ch] text-about">Linen in natural tones, warm timber and soft light.</p>
        <ul class="mt-10 border-b border-line/[var(--rule-alpha)] lg:mt-auto">
          {spots.map((spot) => (
            <li class="room-row line-item grid grid-cols-[1.5rem_3rem_1fr_auto] items-center gap-3 py-3" data-row={spot.n}>
              <span class="label label-muted tabular-nums">{String(spot.n).padStart(2, "0")}</span>
              <span class="block aspect-square overflow-hidden rounded bg-stone">
                {spot.item.image ? <img src={spot.item.image.src} alt="" loading="lazy" class="h-full w-full object-cover" /> : <ProductArt art={artOf(spot.item)} />}
              </span>
              <a href={`/living/products/${spot.item.slug}/`} class="min-w-0">
                <span class="block truncate text-small font-medium">{spot.item.name}</span>
                <span class="block text-caption tabular-nums text-fg-subtle">{formatPrice(spot.item.price)}</span>
              </a>
              <button type="button" class="icon-btn" data-add-to-cart data-slug={spot.item.slug} data-colour={spot.item.colours?.[0]?.name} data-size={spot.item.sizes?.[0]} aria-label={`Add ${spot.item.name} to cart`}>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="1.2" /></svg>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .room-image {
    aspect-ratio: 2560 / 1717;
  }

  .room-spot {
    position: absolute;
    transform: translate(-50%, -50%);
  }

  .room-spot-dot {
    position: relative;
    display: flex;
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgb(var(--paper));
    color: rgb(var(--ink));
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: var(--weight-medium);
    box-shadow: 0 2px 10px rgb(var(--ink) / 0.2);
    transition:
      background-color var(--dur-base) var(--ease-standard),
      color var(--dur-base) var(--ease-standard),
      transform var(--dur-base) var(--ease-out);
  }

  /* A soft ring pulses out from each marker */
  .room-spot-dot::after {
    content: "";
    position: absolute;
    inset: -0.375rem;
    border-radius: 50%;
    border: 1px solid rgb(var(--paper) / 0.8);
    animation: spot-pulse 2.4s var(--ease-out) infinite;
  }

  @keyframes spot-pulse {
    from {
      opacity: 1;
      transform: scale(0.8);
    }
    to {
      opacity: 0;
      transform: scale(1.4);
    }
  }

  .room-spot-tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.625rem);
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-media);
    background: rgb(var(--paper));
    color: rgb(var(--ink));
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    box-shadow: 0 8px 24px -10px rgb(var(--ink) / 0.35);
    opacity: 0;
    transform: translate(-50%, 0.25rem);
    pointer-events: none;
    transition:
      opacity var(--dur-base) var(--ease-standard),
      transform var(--dur-base) var(--ease-out);
  }

  .room-spot:hover .room-spot-tip,
  .room-spot:focus-visible .room-spot-tip,
  .room-spot.is-lit .room-spot-tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .room-spot:hover .room-spot-dot,
  .room-spot.is-lit .room-spot-dot {
    background: rgb(var(--ink));
    color: rgb(var(--paper));
    transform: scale(1.1);
  }

  .room-row.is-lit::before {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .room-spot-dot::after {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-room]").forEach((room) => {
    const light = (n: string | undefined, on: boolean) => {
      room.querySelector(`[data-spot="${n}"]`)?.classList.toggle("is-lit", on);
      room.querySelector(`[data-row="${n}"]`)?.classList.toggle("is-lit", on);
    };
    room.querySelectorAll<HTMLElement>("[data-spot], [data-row]").forEach((el) => {
      const n = el.dataset.spot ?? el.dataset.row;
      el.addEventListener("pointerenter", () => light(n, true));
      el.addEventListener("pointerleave", () => light(n, false));
    });
  });
</script>

<script>
  import { bindAddButtons } from "@/scripts/living-cart";
  bindAddButtons();
</script>
