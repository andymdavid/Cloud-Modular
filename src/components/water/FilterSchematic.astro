---
/**
 * The filtration system drawn as a line schematic: the inlet, three 20 inch housings under their heads (each with a
 * pressure gauge and the red pressure-release button), the cartridge in each, and the outlet. Water is a blue path
 * that runs in through the first head, down the outside of each cartridge, through it to the core, up and on to the
 * next housing. It stands in until the 3D model is built.
 *
 * `active` (0 inlet, 1 to 3 the housings, 4 outlet) fills the path up to that part and picks out that cartridge.
 * The sequence sets it live through the `data-active` attribute; `flowing` keeps the whole path running (the hero).
 */
interface Props {
  active?: number;
  flowing?: boolean;
  class?: string;
}

const { active = 0, flowing = false, class: className } = Astro.props;

const housings = [190, 360, 530];
const codes = ["PP20BB-CC", "CTO20BB", "CTO20BB"];
const headY = 80;
const pipeY = 102;
const sumpTop = 126;
const sumpBottom = 462;

// One path per part of the journey: the inlet, each housing (its feed pipe, down the outside, through, up the core)
// and the outlet
const u = (cx: number, from: number) => `M${from} ${pipeY}H${cx - 44}V${sumpBottom - 36}H${cx}V${pipeY}H${cx + 62}`;
const segments = [`M24 ${pipeY}H128`, u(housings[0], 128), u(housings[1], 252), u(housings[2], 422), `M592 ${pipeY}H696`];
---

<svg
  class:list={["schematic", className]}
  viewBox="0 0 720 540"
  role="img"
  aria-label="The three-stage filtration system. Water enters the first housing, passes through each cartridge in turn and leaves the third housing."
  data-schematic
  data-active={flowing ? 4 : active}
  data-flowing={flowing ? "" : undefined}
>
  <!-- Pipes -->
  <g class="s-pipe">
    <path d={`M24 ${pipeY - 9}H128M24 ${pipeY + 9}H128`} />
    <path d={`M592 ${pipeY - 9}H696M592 ${pipeY + 9}H696`} />
    <path d={`M252 ${pipeY - 9}H298M252 ${pipeY + 9}H298M422 ${pipeY - 9}H468M422 ${pipeY + 9}H468`} />
  </g>
  <text class="s-label" x="24" y={pipeY - 22}>Mains in</text>
  <text class="s-label" x="696" y={pipeY - 22} text-anchor="end">To the home</text>

  {housings.map((cx, index) => (
    <g class="s-housing" data-housing={index + 1}>
      <!-- Gauge -->
      <path class="s-line" d={`M${cx} ${headY}V58`} />
      <circle class="s-fill" cx={cx} cy="38" r="20" />
      <path class="s-line s-thin" d={`M${cx} 38L${cx + 9} 29`} />
      <!-- Head, with the red pressure-release button -->
      <rect class="s-fill" x={cx - 62} y={headY} width="124" height="46" rx="6" />
      <circle class="s-release" cx={cx + 42} cy={headY} r="5" />
      <!-- Sump -->
      <path class="s-fill" d={`M${cx - 52} ${sumpTop}V${sumpBottom - 24}Q${cx - 52} ${sumpBottom} ${cx - 28} ${sumpBottom}H${cx + 28}Q${cx + 52} ${sumpBottom} ${cx + 52} ${sumpBottom - 24}V${sumpTop}`} />
      <path class="s-line s-thin" d={`M${cx - 52} ${sumpTop + 16}H${cx + 52}`} />
      <!-- Cartridge and its core -->
      <rect class="s-cartridge" x={cx - 30} y={sumpTop + 26} width="60" height={sumpBottom - sumpTop - 58} rx="5" />
      <rect class="s-core" x={cx - 7} y={sumpTop + 26} width="14" height={sumpBottom - sumpTop - 58} />
      <!-- Stage label -->
      <text class="s-num" x={cx} y={sumpBottom + 36} text-anchor="middle">{String(index + 1).padStart(2, "0")}</text>
      <text class="s-label" x={cx} y={sumpBottom + 58} text-anchor="middle">{codes[index]}</text>
    </g>
  ))}

  <!-- Water: the filled path, then moving dashes over it -->
  {segments.map((d, index) => (
    <g class="s-water" data-segment={index}>
      <path class="s-water-fill" d={d} pathLength="1" />
      <path class="s-water-flow" d={d} pathLength="1" />
    </g>
  ))}
</svg>

<style>
  .schematic {
    --water: 86 146 180;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .schematic :global(text) {
    fill: rgb(var(--fg-muted));
  }

  .s-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .s-num {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.08em;
  }

  .s-pipe path,
  .s-line,
  .s-fill,
  .s-cartridge,
  .s-core {
    fill: none;
    stroke: rgb(var(--fg) / 0.5);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .s-fill {
    fill: rgb(var(--surface));
  }

  .s-thin {
    stroke-width: 1;
    stroke: rgb(var(--fg) / 0.3);
  }

  .s-cartridge {
    fill: rgb(var(--fg) / 0.04);
    stroke: rgb(var(--fg) / 0.35);
    transition:
      fill var(--dur-slow) var(--ease-standard),
      stroke var(--dur-slow) var(--ease-standard);
  }

  .s-core {
    fill: rgb(var(--surface));
    stroke: rgb(var(--fg) / 0.2);
  }

  .s-release {
    fill: rgb(196 64 52);
  }

  .s-num {
    transition: fill var(--dur-slow) var(--ease-standard);
  }

  /* The water fills each part of the path in turn up to the active one */
  .s-water path {
    fill: none;
    stroke: rgb(var(--water));
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 3;
  }

  .s-water-fill {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 900ms var(--ease-standard);
  }

  .s-water-flow {
    stroke: rgb(var(--surface)) !important;
    stroke-width: 1.5 !important;
    stroke-dasharray: 0.006 0.024;
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-standard);
  }

  /* Path parts up to the active one are filled and flow; the active housing's cartridge takes the water tint */
  [data-active="0"] [data-segment="0"] .s-water-fill,
  [data-active="1"] :is([data-segment="0"], [data-segment="1"]) .s-water-fill,
  [data-active="2"] :is([data-segment="0"], [data-segment="1"], [data-segment="2"]) .s-water-fill,
  [data-active="3"] :is([data-segment="0"], [data-segment="1"], [data-segment="2"], [data-segment="3"]) .s-water-fill,
  [data-active="4"] .s-water-fill {
    stroke-dashoffset: 0;
  }

  [data-active="0"] [data-segment="0"] .s-water-flow,
  [data-active="1"] :is([data-segment="0"], [data-segment="1"]) .s-water-flow,
  [data-active="2"] :is([data-segment="0"], [data-segment="1"], [data-segment="2"]) .s-water-flow,
  [data-active="3"] :is([data-segment="0"], [data-segment="1"], [data-segment="2"], [data-segment="3"]) .s-water-flow,
  [data-active="4"] .s-water-flow {
    opacity: 0.9;
    animation: s-flow 2.4s linear infinite;
  }

  [data-active="1"] [data-housing="1"] .s-cartridge,
  [data-active="2"] [data-housing="2"] .s-cartridge,
  [data-active="3"] [data-housing="3"] .s-cartridge {
    fill: rgb(var(--water) / 0.16);
    stroke: rgb(var(--water));
  }

  [data-active="1"] [data-housing="1"] .s-num,
  [data-active="2"] [data-housing="2"] .s-num,
  [data-active="3"] [data-housing="3"] .s-num {
    fill: rgb(var(--fg));
  }

  /* In the hero every cartridge carries the tint */
  [data-flowing] .s-cartridge {
    fill: rgb(var(--water) / 0.12);
    stroke: rgb(var(--water) / 0.8);
  }

  @keyframes s-flow {
    to {
      stroke-dashoffset: -0.12;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .s-water-fill,
    .s-cartridge {
      transition: none;
    }

    .s-water-flow {
      animation: none !important;
    }
  }
</style>
