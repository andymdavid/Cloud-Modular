---
import EnquiryForm from "@/components/refresh/EnquiryForm.astro";
import { waterSpecSheet } from "@/data/water";
import { gmxSpecSheet } from "@/data/gmx";

/**
 * The spec sheet download in a modal, so the page carries one form. Any button marked data-spec-sheet-open opens it.
 * The form sends the lead to the team, then shows the download link (EnquiryForm "specsheet") for `product`.
 */
interface Props {
  product?: "water" | "gmx";
}

const { product = "water" } = Astro.props;
const specSheet = product === "gmx" ? gmxSpecSheet : waterSpecSheet;
---

<dialog class="spec-modal" data-spec-sheet aria-labelledby="spec-sheet-title" data-theme="light">
  <div class="spec-modal-panel">
    <div class="flex items-start justify-between gap-6">
      <div>
        <p class="label">Spec sheet</p>
        <h2 id="spec-sheet-title" class="mt-4 text-h3">{specSheet.title}</h2>
      </div>
      <button type="button" class="spec-modal-close" data-spec-sheet-close aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="m2 2 10 10M12 2 2 12" stroke="currentColor" stroke-width="1.3" /></svg>
      </button>
    </div>
    <p class="mt-4 max-w-[44ch] text-body text-fg-muted">{specSheet.intro}</p>
    <EnquiryForm variant="specsheet" product={product} class="mt-10" />
  </div>
</dialog>

<style>
  .spec-modal {
    width: min(40rem, calc(100vw - 2 * var(--gutter)));
    max-height: calc(100svh - 2 * var(--gutter));
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-media);
    background: rgb(var(--surface));
    color: rgb(var(--fg));
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity var(--dur-base) var(--ease-standard),
      transform var(--dur-slow) var(--ease-out),
      overlay var(--dur-base) allow-discrete,
      display var(--dur-base) allow-discrete;
  }

  .spec-modal[open] {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .spec-modal[open] {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  .spec-modal::backdrop {
    background: rgb(var(--ink) / 0.5);
  }

  .spec-modal-panel {
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .spec-modal-close {
    display: inline-flex;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: var(--rule) solid rgb(var(--line) / 0.2);
    border-radius: var(--radius-media);
    transition: border-color var(--dur-base) var(--ease-standard);
  }

  .spec-modal-close:hover {
    border-color: rgb(var(--line) / 0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    .spec-modal {
      transition: none;
    }
  }
</style>

<script>
  // Open from any spec sheet button; close with the button, Escape or a click on the backdrop
  const dialog = document.querySelector<HTMLDialogElement>("[data-spec-sheet]");
  if (dialog) {
    document.querySelectorAll<HTMLElement>("[data-spec-sheet-open]").forEach((button) =>
      button.addEventListener("click", () => {
        dialog.showModal();
        document.documentElement.style.overflow = "hidden";
      }),
    );
    dialog.querySelector("[data-spec-sheet-close]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => {
      document.documentElement.style.overflow = "";
    });
  }
</script>
