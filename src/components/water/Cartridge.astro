---
/**
 * A 20 inch jumbo cartridge drawn in CSS, upright, at the real proportions (about 4.5 × 20 inches): blue end caps
 * with the open core on top, a shaded cylinder body and its media. "pp" is the white wrapped polypropylene of the
 * PP20BB-CC, "carbon" the grey netted carbon block of the CTO20BB. Stands in until the cartridge renders are made.
 */
interface Props {
  kind: "pp" | "carbon";
  class?: string;
}

const { kind, class: className } = Astro.props;
---

<div class:list={["cartridge", `cartridge--${kind}`, className]} aria-hidden="true">
  <span class="cartridge-shadow"></span>
  <span class="cartridge-cap cartridge-cap--bottom"></span>
  <span class="cartridge-body"></span>
  <span class="cartridge-cap cartridge-cap--top"><span class="cartridge-core"></span></span>
</div>

<style>
  .cartridge {
    --w: 5.5rem;
    --cap-blue: 36 98 186;
    --ry: calc(var(--w) * 0.16);
    position: relative;
    width: var(--w);
    height: calc(var(--w) * 4.4);
  }

  /* Soft contact shadow on the floor */
  .cartridge-shadow {
    position: absolute;
    left: -30%;
    right: -30%;
    bottom: calc(var(--ry) * -1.1);
    height: calc(var(--ry) * 2.4);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0));
    filter: blur(4px);
  }

  .cartridge-body {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--ry) + var(--w) * 0.08);
    bottom: calc(var(--ry) + var(--w) * 0.08);
  }

  /* White melt-blown polypropylene: fine wraps under a cylinder's shading */
  .cartridge--pp .cartridge-body {
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.34) 0%, rgb(0 0 0 / 0.06) 14%, rgb(255 255 255 / 0.5) 30%, rgb(255 255 255 / 0) 48%, rgb(0 0 0 / 0.08) 72%, rgb(0 0 0 / 0.42) 100%),
      repeating-linear-gradient(0deg, rgb(0 0 0 / 0.045) 0 1px, rgb(0 0 0 / 0) 1px 3px),
      rgb(236 236 232);
  }

  /* Carbon block in its netting: a crosshatch over charcoal grey */
  .cartridge--carbon .cartridge-body {
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.55) 0%, rgb(0 0 0 / 0.12) 16%, rgb(255 255 255 / 0.22) 30%, rgb(255 255 255 / 0) 46%, rgb(0 0 0 / 0.1) 70%, rgb(0 0 0 / 0.6) 100%),
      repeating-linear-gradient(56deg, rgb(255 255 255 / 0.16) 0 1px, rgb(255 255 255 / 0) 1px 6px),
      repeating-linear-gradient(-56deg, rgb(255 255 255 / 0.16) 0 1px, rgb(255 255 255 / 0) 1px 6px),
      rgb(78 81 84);
  }

  /* End caps: a short blue band, its ellipse face on top, the bottom ellipse turned under */
  .cartridge-cap {
    position: absolute;
    left: -2%;
    right: -2%;
    height: calc(var(--w) * 0.08 + var(--ry) * 2);
  }

  .cartridge-cap--top {
    top: 0;
    background:
      radial-gradient(50% var(--ry) at 50% var(--ry), rgb(var(--cap-blue) / 1) 0 99%, transparent 100%) top / 100% calc(var(--ry) * 2) no-repeat,
      linear-gradient(90deg, rgb(10 30 70) 0%, rgb(var(--cap-blue)) 24%, rgb(110 160 230) 34%, rgb(var(--cap-blue)) 52%, rgb(14 40 92) 100%) 0 var(--ry) / 100% calc(var(--w) * 0.08) no-repeat,
      radial-gradient(50% var(--ry) at 50% 0, rgb(14 40 92) 0 99%, transparent 100%) 0 calc(var(--ry) + var(--w) * 0.08) / 100% var(--ry) no-repeat;
  }

  .cartridge-cap--top::before {
    /* the lit face of the cap */
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--ry) * 2);
    border-radius: 50%;
    background: radial-gradient(60% 70% at 45% 40%, rgb(96 150 224), rgb(var(--cap-blue)) 70%, rgb(22 64 140));
  }

  .cartridge-core {
    position: absolute;
    z-index: 1;
    left: 34%;
    right: 34%;
    top: calc(var(--ry) * 0.62);
    height: calc(var(--ry) * 0.76);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(8 14 26), rgb(20 34 60));
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.18);
  }

  .cartridge-cap--bottom {
    bottom: 0;
    background:
      linear-gradient(90deg, rgb(10 30 70) 0%, rgb(var(--cap-blue)) 24%, rgb(110 160 230) 34%, rgb(var(--cap-blue)) 52%, rgb(14 40 92) 100%) 0 var(--ry) / 100% calc(var(--w) * 0.08) no-repeat,
      radial-gradient(50% var(--ry) at 50% 0, rgb(14 40 92) 0 99%, transparent 100%) 0 calc(var(--ry) + var(--w) * 0.08) / 100% var(--ry) no-repeat;
  }

  /* The body's top edge sits under the cap; its bottom edge curves with the cylinder */
  .cartridge-body {
    border-radius: 0 0 50% 50% / 0 0 var(--ry) var(--ry);
  }
</style>
