---
interface Props {
  href: string;
  label: string;
  arrow?: boolean;
}

const { href, label, arrow = false } = Astro.props;
---

<a class="button-link group" href={href}>
  {arrow && (
    <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M1.5 10h12M9 4.5l5.5 5.5L9 15.5" stroke="currentColor" stroke-width="1.6" />
    </svg>
  )}
  <span>{label}</span>
</a>
